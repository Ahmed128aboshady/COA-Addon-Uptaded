<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- إضافة تبويب "صلاحية الحسابات" في فورم المستخدم -->
        <record id="view_users_form_restricted_accounts" model="ir.ui.view">
            <field name="name">res.users.form.restricted.accounts</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="صلاحية الحسابات" name="restricted_accounts">
                        <group>
                            <field name="is_restricted_accountant" invisible="1"/>
                            <div class="alert alert-info" role="alert"
                                 colspan="2">
                                لتفعيل التقييد: أضف المستخدم لمجموعة
                                "محاسب مقيّد الصلاحية" من تبويب "الصلاحيات
                                الأخرى"، ثم حدد هنا الحسابات المسموح له
                                برؤيتها. بدون الانتماء لهذه المجموعة، هذا
                                الحقل لن يكون له أي تأثير.
                            </div>
                            <field name="allowed_account_ids"
                                   widget="many2many_tags"
                                   options="{'no_create': True}"
                                   placeholder="اختر الحسابات المسموح بها..."/>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
