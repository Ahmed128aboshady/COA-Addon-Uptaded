<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_retention" model="ir.ui.view">
        <field name="name">account.move.form.retention</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_open_retention_move"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-lock"
                        invisible="not retention_move_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Retention</span>
                        <span class="o_stat_text">Entry</span>
                    </div>
                </button>
            </div>
            <xpath expr="//field[@name='invoice_payment_term_id']/.." position="after">
                <field name="retention_percent"
                       invisible="move_type != 'out_invoice'"
                       readonly="state != 'draft'"/>
                <field name="retention_base"
                       invisible="move_type != 'out_invoice' or retention_percent == 0"
                       readonly="state != 'draft'"/>
                <field name="retention_period_days"
                       invisible="move_type != 'out_invoice' or retention_percent == 0"
                       readonly="state != 'draft'"/>
                <field name="retention_due_date"
                       invisible="move_type != 'out_invoice' or retention_percent == 0"
                       readonly="state != 'draft'"/>
                <field name="retention_amount"
                       invisible="move_type != 'out_invoice' or retention_percent == 0"/>
            </xpath>
        </field>
    </record>
</odoo>
