<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- PDF report: shows in the "Print" menu of journal-item list views
         when lines are selected. -->
    <record id="action_report_retention_lines" model="ir.actions.report">
        <field name="name">Retention Receivables (PDF)</field>
        <field name="model">account.move.line</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sale_retention.report_retention_lines</field>
        <field name="report_file">sale_retention.report_retention_lines</field>
        <field name="binding_model_id" ref="account.model_account_move_line"/>
        <field name="binding_type">report</field>
        <field name="binding_view_types">list</field>
    </record>

    <!-- Excel export: shows in the "Action" (gear) menu of journal-item
         list views when lines are selected. -->
    <record id="action_retention_lines_xlsx" model="ir.actions.server">
        <field name="name">Retention Receivables (Excel)</field>
        <field name="model_id" ref="account.model_account_move_line"/>
        <field name="binding_model_id" ref="account.model_account_move_line"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_export_retention_xlsx()</field>
    </record>

    <template id="report_retention_lines">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2>Retention Receivables</h2>
                    <p class="text-muted">
                        Printed on <span t-esc="datetime.date.today()"/>
                    </p>
                    <t t-set="currency" t-value="res_company.currency_id"/>
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Journal Entry</th>
                                <th>Label</th>
                                <th>Due Date</th>
                                <th class="text-end">Debit</th>
                                <th class="text-end">Credit</th>
                                <th class="text-end">Residual</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="groups" t-value="docs.grouped('partner_id')"/>
                            <t t-foreach="docs.mapped('partner_id').sorted('display_name')" t-as="partner">
                                <t t-set="lines" t-value="groups[partner].sorted('date')"/>
                                <tr class="o_line_section" style="background-color:#eeeeee;">
                                    <td colspan="4">
                                        <strong t-esc="partner.display_name"/>
                                    </td>
                                    <td class="text-end">
                                        <strong t-esc="sum(lines.mapped('debit'))"
                                                t-options='{"widget": "monetary", "display_currency": currency}'/>
                                    </td>
                                    <td class="text-end">
                                        <strong t-esc="sum(lines.mapped('credit'))"
                                                t-options='{"widget": "monetary", "display_currency": currency}'/>
                                    </td>
                                    <td class="text-end">
                                        <strong t-esc="sum(lines.mapped('amount_residual'))"
                                                t-options='{"widget": "monetary", "display_currency": currency}'/>
                                    </td>
                                </tr>
                                <tr t-foreach="lines" t-as="line">
                                    <td><span t-esc="line.date"/></td>
                                    <td><span t-esc="line.move_id.name"/></td>
                                    <td><span t-esc="line.name or ''"/></td>
                                    <td><span t-esc="line.date_maturity or ''"/></td>
                                    <td class="text-end">
                                        <span t-esc="line.debit"
                                              t-options='{"widget": "monetary", "display_currency": currency}'/>
                                    </td>
                                    <td class="text-end">
                                        <span t-esc="line.credit"
                                              t-options='{"widget": "monetary", "display_currency": currency}'/>
                                    </td>
                                    <td class="text-end">
                                        <span t-esc="line.amount_residual"
                                              t-options='{"widget": "monetary", "display_currency": currency}'/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                        <tfoot>
                            <tr style="border-top:2px solid #000;">
                                <td colspan="4"><strong>Total</strong></td>
                                <td class="text-end">
                                    <strong t-esc="sum(docs.mapped('debit'))"
                                            t-options='{"widget": "monetary", "display_currency": currency}'/>
                                </td>
                                <td class="text-end">
                                    <strong t-esc="sum(docs.mapped('credit'))"
                                            t-options='{"widget": "monetary", "display_currency": currency}'/>
                                </td>
                                <td class="text-end">
                                    <strong t-esc="sum(docs.mapped('amount_residual'))"
                                            t-options='{"widget": "monetary", "display_currency": currency}'/>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
