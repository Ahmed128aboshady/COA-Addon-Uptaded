<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_inherit_ramlaa" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.ramlaa</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">

            <xpath expr="//page[@name='personal_information']//group" position="after">
                <separator string="Dependence Details"/>
                <field name="family_ids" nolabel="1">
                    <list editable="bottom">
                        <field name="name"/>
                        <field name="relation"/>
                        <field name="contact_no"/>
                        <field name="dob"/>
                        <field name="id_number"/>
                        <field name="age" force_save="1"/>
                        <field name="gender"/>
                        <field name="code" force_save="1"/>
                    </list>
                </field>
            </xpath>

            <xpath expr="//page[@name='hr_settings']" position="after">
                <page string="Insurance" name="insurance">
                    <group string="Insurance Details">
                        <field name="is_insured"/>
                        <field name="employee_doesnt_pay_insurance"
                               invisible="not is_insured"/>
                        <field name="company_rate"
                               invisible="not is_insured"/>
                        <field name="employee_rate"
                               invisible="not is_insured"/>
                        <field name="company_amount"
                               invisible="not is_insured"/>
                        <field name="employee_amount"
                               invisible="not is_insured"/>
                    </group>
                </page>
            </xpath>

        </field>
    </record>
</odoo>