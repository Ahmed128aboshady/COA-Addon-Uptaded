<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_print_invoice" model="ir.ui.view">
        <field name="name">sale.order.form.print.invoice.direct</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_print_invoice_direct"
                        type="object"
                        string="Print Invoice"
                        class="btn-secondary"
                        icon="fa-print"
                        invisible="invoice_count == 0"/>
            </xpath>
        </field>
    </record>

</odoo>
