<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- فئة الصلاحيات لكي تظهر بشكل منظم في شاشة المستخدم -->
        <record id="category_custom_pricing" model="ir.module.category">
            <field name="name">Custom Pricing Permissions</field>
            <field name="sequence" eval="10"/>
        </record>

        <!-- التيك بوكس الخاص بالسماح بتعديل السعر -->
        <record id="group_edit_sale_price" model="res.groups">
            <field name="name">Allow Editing Sales Prices</field>
            <field name="category_id" ref="category_custom_pricing"/>
            <!-- إعطاء الصلاحية تلقائياً لمدير النظام -->
            <field name="users" eval="[(4, ref('base.user_admin')), (4, ref('base.user_root'))]"/>
        </record>
    </data>
</odoo>