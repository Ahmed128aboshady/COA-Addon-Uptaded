<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_price_lock" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.price.lock</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            
            <xpath expr="//field[@name='order_line']/list/field[@name='price_unit']" position="before">
                <field name="is_price_editable" column_invisible="True"/>
            </xpath>
            
            <xpath expr="//field[@name='order_line']/list/field[@name='price_unit']" position="attributes">
                <attribute name="readonly">not is_price_editable</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>
            
        </field>
    </record>
</odoo> 