<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.module.category" id="module_category_human_resources_attendances_sheet">
            <field name="name">Attendance Sheet</field>
            <field name="description">Helps you manage Attendance Sheets.</field>
            <field name="sequence">15</field>
        </record>

        <record id="privilege_attendance_sheet" model="res.groups.privilege">
            <field name="name">Attendance Sheet Access Level</field>
            <field name="category_id" ref="module_category_human_resources_attendances_sheet"/>
        </record>

        <record id="group_attendance_sheet_employee" model="res.groups">
            <field name="name">Employee</field>
            <field name="privilege_id" ref="privilege_attendance_sheet"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_attendance_sheet_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="privilege_attendance_sheet"/>
            <field name="implied_ids" eval="[(4, ref('rm_hr_attendance_sheet.group_attendance_sheet_employee'))]"/>
        </record>

        <record id="group_attendance_sheet_leader" model="res.groups">
            <field name="name">Team Leader</field>
            <field name="privilege_id" ref="privilege_attendance_sheet"/>
            <field name="implied_ids" eval="[(4, ref('rm_hr_attendance_sheet.group_attendance_sheet_employee'))]"/>
        </record>

        <record id="group_attendance_sheet_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="privilege_attendance_sheet"/>
            <field name="implied_ids" eval="[(4, ref('rm_hr_attendance_sheet.group_attendance_sheet_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>