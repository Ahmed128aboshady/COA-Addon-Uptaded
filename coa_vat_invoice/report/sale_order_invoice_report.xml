<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="header_logo_right" inherit_id="web.external_layout_standard">
        <xpath expr="//img[hasclass('o_company_logo_small')]" position="attributes">
            <attribute name="style">margin-left: auto; display: block; max-height: 250px; max-width: 500px;</attribute>
        </xpath>
        <xpath expr="//div[@name='company_address']" position="attributes">
            <attribute name="style">display: none;</attribute>
        </xpath>
        
        <xpath expr="//div[hasclass('o_footer_content')]" position="replace">
            <div class="o_footer_content" style="width: 100%;">
                <t t-if="o and o._name in ('sale.order', 'account.move')">
                    <div id="vat_footer_sigs" style="width: 100%; display: table; padding-bottom: 50px;">
                        <div style="display: table-row;">
                            <div style="display: table-cell; width: 25%; text-align: left; vertical-align: bottom;">
                                <t t-set="qr_code_str" t-value="o.name"/>
                                <t t-if="o._name == 'account.move'">
                                    <t t-if="'l10n_sa_qr_code_str' in o._fields and o.l10n_sa_qr_code_str">
                                        <t t-set="qr_code_str" t-value="o.l10n_sa_qr_code_str"/>
                                    </t>
                                </t>
                                <t t-if="o._name == 'sale.order'">
                                    <t t-set="linked_invs" t-value="o.invoice_ids.filtered(lambda i: i.state != 'cancel')"/>
                                    <t t-if="linked_invs">
                                        <t t-if="'l10n_sa_qr_code_str' in linked_invs[0]._fields and linked_invs[0].l10n_sa_qr_code_str">
                                            <t t-set="qr_code_str" t-value="linked_invs[0].l10n_sa_qr_code_str"/>
                                        </t>
                                    </t>
                                </t>
                                <img t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s' % ('QR', quote_plus(qr_code_str), 100, 100)"
                                     style="display: block; width: 100px; height: 100px;"/>
                            </div>
                            <div style="display: table-cell; width: 25%; text-align: center; vertical-align: bottom; padding: 0 15px;">
                                <div style="font-weight: bold; font-size: 14px; padding-bottom: 5px;">الختم / Stamp</div>
                            </div>
                            <div style="display: table-cell; width: 25%; text-align: center; vertical-align: bottom; padding: 0 15px;">
                                <div style="font-weight: bold; font-size: 14px; padding-bottom: 5px;">التوقيع / Signature</div>
                            </div>
                            <div style="display: table-cell; width: 25%; text-align: center; vertical-align: bottom; padding: 0 15px;">
                                <div style="font-weight: bold; font-size: 14px; padding-bottom: 5px;">اسم المستلم / Name</div>
                            </div>
                        </div>
                    </div>
                </t>
                <t t-else="">
                    <div class="text-center" style="font-size: 12px; color: #888;">
                        Page <span class="page"/> / <span class="topage"/>
                    </div>
                </t>
            </div>
        </xpath>
    </template>

    <template id="report_sale_vat_invoice_document">
        <t t-call="web.external_layout">
            <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>

            <t t-set="product_lines" t-value="doc.order_line.filtered(lambda l: not l.display_type)"/>
            <t t-set="qty_total" t-value="sum(product_lines.mapped('product_uom_qty'))"/>
            <t t-set="delivery_pickings" t-value="doc.picking_ids.filtered(lambda p: p.picking_type_code == 'outgoing')"/>
            <t t-set="delivery_names" t-value="', '.join(delivery_pickings.mapped('name')) if delivery_pickings else ''"/>

            <div class="page" style="font-family: Arial, sans-serif; font-size: 11px; color: #000;">

                <div style="text-align: center; margin-bottom: 20px;">
                    <div style="display: inline-block; border: 1px solid #000; background-color: #fce4d6; padding: 8px 40px; font-weight: bold; font-size: 16px;">
                        VAT Invoice No فاتورة ضريبية رقم / <t t-esc="doc.name"/>
                    </div>
                </div>

                <div style="width: 100%; overflow: hidden; margin-bottom: 15px;">
                    <div style="width: 48%; float: left;">
                        <table style="width: 100%; border-collapse: collapse; border: 1px solid #000;">
                            <tr>
                                <td style="border: 1px solid #000; padding: 4px; font-weight: bold; width: 45%; vertical-align: top;">
                                    <span style="float: left;">Cus. Name</span><span style="float: right;" dir="rtl">اسم العميل:</span>
                                </td>
                                <td style="border: 1px solid #000; padding: 4px; vertical-align: top;"><span t-field="doc.partner_id.name"/></td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #000; padding: 4px; font-weight: bold; vertical-align: top;">
                                    <span style="float: left;">Cus. ID</span><span style="float: right;" dir="rtl">رقم العميل:</span>
                                </td>
                                <td style="border: 1px solid #000; padding: 4px; vertical-align: top;"><t t-esc="doc.partner_id.ref or '-'"/></td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #000; padding: 4px; font-weight: bold; vertical-align: top;">
                                    <span style="float: left;">Cus. VAT No</span><span style="float: right;" dir="rtl">السجل الضريبي:</span>
                                </td>
                                <td style="border: 1px solid #000; padding: 4px; vertical-align: top;"><t t-esc="doc.partner_id.vat or '-'"/></td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #000; padding: 4px; font-weight: bold; vertical-align: top;">
                                    <span style="float: left;">Project Name</span><span style="float: right;" dir="rtl">اسم المشروع:</span>
                                </td>
                                <td style="border: 1px solid #000; padding: 4px; vertical-align: top;">
                                    <t t-if="'project_id' in doc and doc.project_id"><t t-esc="doc.project_id.name"/></t>
                                    <t t-elif="'analytic_account_id' in doc and doc.analytic_account_id"><t t-esc="doc.analytic_account_id.name"/></t>
                                    <t t-else="">-</t>
                                </td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #000; padding: 4px; font-weight: bold; vertical-align: top;">
                                    <span style="float: left;">Cus. Address</span><span style="float: right;" dir="rtl">عنوان العميل:</span>
                                </td>
                                <td style="border: 1px solid #000; padding: 4px; vertical-align: top;"><span t-field="doc.partner_id" t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}'/></td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #000; padding: 4px; font-weight: bold; vertical-align: top;">
                                    <span style="float: left;">Delivery Note No</span><span style="float: right;" dir="rtl">إذن تسليم رقم:</span>
                                </td>
                                <td style="border: 1px solid #000; padding: 4px; vertical-align: top;"><t t-esc="delivery_names or '-'"/></td>
                            </tr>
                        </table>
                    </div>

                    <div style="width: 48%; float: right;">
                        <table style="width: 100%; border-collapse: collapse; border: 1px solid #000;">
                            <tr>
                                <td style="border: 1px solid #000; padding: 4px; font-weight: bold; width: 45%; vertical-align: top;">
                                    <span style="float: left;">Invoice Date /</span><span style="float: right;" dir="rtl">تاريخ الفاتورة</span>
                                </td>
                                <td style="border: 1px solid #000; padding: 4px; vertical-align: top;"><span t-field="doc.date_order" t-options='{"widget": "date"}'/></td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #000; padding: 4px; font-weight: bold; vertical-align: top;">
                                    <span style="float: left;">Due Date /</span><span style="float: right;" dir="rtl">تاريخ الاستحقاق</span>
                                </td>
                                <td style="border: 1px solid #000; padding: 4px; vertical-align: top;"><t t-esc="doc.payment_term_id.name or '-'"/></td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #000; padding: 4px; font-weight: bold; vertical-align: top;">
                                    <span style="float: left;">Order No /</span><span style="float: right;" dir="rtl">رقم أمر البيع</span>
                                </td>
                                <td style="border: 1px solid #000; padding: 4px; vertical-align: top;"><span t-field="doc.name"/></td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #000; padding: 4px; font-weight: bold; vertical-align: top;">
                                    <span style="float: left;">Project No. /</span><span style="float: right;" dir="rtl">رقم المشروع:</span>
                                </td>
                                <td style="border: 1px solid #000; padding: 4px; vertical-align: top;">
                                    <t t-if="'project_id' in doc and doc.project_id"><t t-esc="doc.project_id.id"/></t>
                                    <t t-elif="'analytic_account_id' in doc and doc.analytic_account_id and doc.analytic_account_id.code"><t t-esc="doc.analytic_account_id.code"/></t>
                                    <t t-else="">-</t>
                                </td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #000; padding: 4px; font-weight: bold; vertical-align: top;">
                                    <span style="float: left;">Salesperson Id /</span><span style="float: right;" dir="rtl">رقم المندوب</span>
                                </td>
                                <td style="border: 1px solid #000; padding: 4px; vertical-align: top;"><t t-esc="doc.user_id.name or '-'"/></td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #000; padding: 4px; font-weight: bold; vertical-align: top;">
                                    <span style="float: left;">Site Code /</span><span style="float: right;" dir="rtl">رمز المستودع</span>
                                </td>
                                <td style="border: 1px solid #000; padding: 4px; vertical-align: top;"><t t-esc="doc.warehouse_id.code if doc.warehouse_id else '-'"/></td>
                            </tr>
                        </table>
                    </div>
                </div>

                <div style="clear: both; margin-bottom: 15px;"></div>

                <table style="width: 100%; border-collapse: collapse; border: 1px solid #000;">
                    <thead style="background-color: #fce4d6; text-align: center; font-weight: bold; font-size: 10px;">
                        <tr>
                            <th style="border: 1px solid #000; padding: 4px; vertical-align: top;">Item Name / اسم الصنف</th>
                            <th style="border: 1px solid #000; padding: 4px; vertical-align: top;">Description / الوصف</th>
                            <th style="border: 1px solid #000; padding: 4px; vertical-align: top;">Unit / الوحدة</th>
                            <th style="border: 1px solid #000; padding: 4px; vertical-align: top;">Qty / الكمية</th>
                            <th style="border: 1px solid #000; padding: 4px; vertical-align: top;">Price / السعر</th>
                            <th style="border: 1px solid #000; padding: 4px; vertical-align: top;">VAT / الضريبة</th>
                            <th style="border: 1px solid #000; padding: 4px; vertical-align: top;">Total / الإجمالي</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="product_lines" t-as="line">
                            <tr style="page-break-inside: avoid;">
                                <td style="border: 1px solid #000; padding: 4px; text-align: center; vertical-align: top;"><t t-esc="line.product_id.name"/></td>
                                <td style="border: 1px solid #000; padding: 4px; vertical-align: top;"><t t-esc="line.name"/></td>
                                <t t-set="line_uom" t-value="line.product_uom_id if 'product_uom_id' in line._fields else (line.product_uom if 'product_uom' in line._fields else False)"/>
                                <td style="border: 1px solid #000; padding: 4px; text-align: center; vertical-align: top;"><t t-esc="line_uom.name if line_uom else '-'"/></td>
                                <td style="border: 1px solid #000; padding: 4px; text-align: center; vertical-align: top;"><t t-esc="line.product_uom_qty"/></td>
                                <td style="border: 1px solid #000; padding: 4px; text-align: right; vertical-align: top;"><t t-esc="'{:,.2f}'.format(line.price_unit)"/></td>
                                <t t-set="line_taxes" t-value="line.tax_id if 'tax_id' in line._fields else (line.tax_ids if 'tax_ids' in line._fields else False)"/>
                                <td style="border: 1px solid #000; padding: 4px; text-align: center; vertical-align: top;">
                                    <t t-esc="', '.join([(t.description or t.name) for t in line_taxes]) if line_taxes else ''"/>
                                </td>
                                <td style="border: 1px solid #000; padding: 4px; text-align: right; font-weight: bold; vertical-align: top;"><t t-esc="'{:,.2f}'.format(line.price_total)"/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <table style="width: 100%; border-collapse: collapse; margin-top: 0;">
                    <tr>
                        <td style="width: 43%; border: none;"></td>
                        <td style="width: 14%; border: 1px solid #000; text-align: center; font-weight: bold; padding: 4px;"><t t-esc="'{:,.0f}'.format(qty_total)"/></td>
                        <td style="width: 22%; border: 1px solid #000; font-weight: bold; background-color: #fce4d6; padding: 4px;">Subtotal / المجموع</td>
                        <td style="width: 21%; border: 1px solid #000; text-align: right; font-weight: bold; padding: 4px;"><t t-esc="'{:,.2f}'.format(doc.amount_untaxed)"/></td>
                    </tr>
                    <tr>
                        <td style="border: none;"></td>
                        <td style="border: none;"></td>
                        <td style="border: 1px solid #000; font-weight: bold; background-color: #fce4d6; padding: 4px;">VAT Total / الضريبة</td>
                        <td style="border: 1px solid #000; text-align: right; font-weight: bold; padding: 4px;"><t t-esc="'{:,.2f}'.format(doc.amount_tax)"/></td>
                    </tr>
                    <tr>
                        <td style="border: none;"></td>
                        <td style="border: none;"></td>
                        <td style="border: 1px solid #000; font-weight: bold; background-color: #fce4d6; padding: 4px;">Total / الإجمالي النهائي</td>
                        <td style="border: 1px solid #000; text-align: right; font-weight: bold; background-color: #fce4d6; padding: 4px;"><t t-esc="'{:,.2f}'.format(doc.amount_total)"/></td>
                    </tr>
                </table>

            </div>
        </t>
    </template>

    <template id="report_sale_vat_invoice">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="o" t-value="doc"/>
                <t t-call="alramlaa_vat_invoice.report_sale_vat_invoice_document"/>
            </t>
        </t>
    </template>

