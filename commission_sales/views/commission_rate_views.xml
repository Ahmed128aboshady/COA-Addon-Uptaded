<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============ نسب العمولات ============ -->
    <record id="view_commission_rate_tree" model="ir.ui.view">
        <field name="name">commission.rate.tree</field>
        <field name="model">commission.rate</field>
        <field name="arch" type="xml">
            <list string="نسب العمولات" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="customer_tag_id"/>
                <field name="commission_rate" string="النسبة %"/>
                <field name="notes"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_commission_rate_form" model="ir.ui.view">
        <field name="name">commission.rate.form</field>
        <field name="model">commission.rate</field>
        <field name="arch" type="xml">
            <form string="نسبة العمولة">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="الإعداد">
                            <field name="customer_tag_id"/>
                            <field name="commission_rate" string="نسبة العمولة %"/>
                        </group>
                        <group string="معلومات إضافية">
                            <field name="active"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                    <group string="ملاحظات">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_commission_rate" model="ir.actions.act_window">
        <field name="name">نسب العمولات</field>
        <field name="res_model">commission.rate</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                أضف نسبة عمولة جديدة
            </p>
            <p>
                حدد تاج العميل والنسبة المئوية للعمولة.
                مثال: تاج BIZ &#8592; 1% | تاج BUS &#8592; 2%
            </p>
        </field>
    </record>

</odoo>
