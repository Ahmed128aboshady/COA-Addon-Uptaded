<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_accrued" model="ir.ui.view">
        <field name="name">account.move.form.accrued</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <!-- Smart button to see the generated accrued entries -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_accrued_entries" type="object"
                        class="oe_stat_button" icon="fa-clock-o"
                        invisible="accrued_move_count == 0">
                    <field name="accrued_move_count" widget="statinfo"
                           string="Accrued"/>
                </button>
            </xpath>

            <!-- Accrued marker + dates on the bill lines -->
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='name']"
                   position="after">
                <field name="is_accrued_expense" optional="hide"
                       column_invisible="parent.move_type not in ('in_invoice', 'in_refund')"/>
                <field name="accrued_start_date" optional="hide"
                       column_invisible="parent.move_type not in ('in_invoice', 'in_refund')"/>
                <field name="accrued_end_date" optional="hide"
                       column_invisible="parent.move_type not in ('in_invoice', 'in_refund')"/>
            </xpath>

        </field>
    </record>
</odoo>
