<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_accrued" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.accrued</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Accrued Expenses" id="coa_accrued_expense_block">
                    <setting id="coa_accrued_expense_setting"
                             string="Accrued Expenses"
                             help="Spread a vendor bill expense over a period. Tick 'Accrued' on a bill line and set a start/end date.">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="accrued_expense_account_id"
                                       string="Accrued Account"
                                       class="col-lg-4 o_light_label"/>
                                <field name="accrued_expense_account_id"/>
                            </div>
                            <div class="row">
                                <label for="accrued_expense_journal_id"
                                       string="Accrual Journal"
                                       class="col-lg-4 o_light_label"/>
                                <field name="accrued_expense_journal_id"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
