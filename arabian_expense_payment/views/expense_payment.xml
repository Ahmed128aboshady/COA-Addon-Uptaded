<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <record id="expense_payment_form" model="ir.ui.view">
        <field name="name">expense.payment.form</field>
        <field name="model">expense.payment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="confirm" type="object" string="Confirm"
                            class="oe_highlight"
                            invisible="state != '1'"
                            />
                    <button name="reset_to_draft" type="object"
                            string="Reset To Draft" data-hotkey="q"
                            invisible="state != '2'"
                            />
                    <field name="state" widget="statusbar"
                           statusbar_visible="1,2"/>
                </header>
                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <button name="view_account_pay" type="object"
                                class="oe_stat_button" icon="fa-bars"
                                invisible="count_expense_payment == '0'"
                                >
                            <field name="count_expense_payment"
                                   widget="statinfo" string="Journal Entry"/>
                        </button>
                    </div>
                    <div class="oe_title">

                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="payment_type" widget="radio"
                                   options="{'horizontal': True}"
                                   readonly="state != '1'"
                                   invisible="1"/>
                            <field name="reference"
                                   readonly="state != '1'"
                                   />
                            <field name="already_created" invisible="1"/>
                            <field name="company_id"/>
                            <field name="currency_id" invisible="1"/>

                        </group>
                        <group>
                            <field name="date" required="1"
                                   readonly="state != '1'"
                                   />
                            <field name="journal_id" required="1"
				   readonly="state != '1'"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="analytic_distribution"
                                   widget="analytic_distribution" force_save="1" invisible="1"/>
                        </group>

                    </group>
                    <notebook>
                        <page string="Lines">
                            <field name="expense_payment_line_ids"
                                   readonly="state != '1'">               <!-- add  context="{'default_field' : field}" to set default value -->
                                <list editable="bottom">
                                    <field name="expense_payment_id"
                                           column_invisible="1"/>       <!-- add  domain="[('id','=',parent.field)]" to set default domain -->
                                    <field name="product_id"/>
                                    <field name="memo"/>
                                    <field name="account_id"/>
                                    <field name="partner_id" column_required="1"/>
                                    <field name="employee_id"/>
                                    <field name="analytic_distribution"
                                           widget="analytic_distribution"
                                           groups="analytic.group_analytic_accounting" force_save="1"/>
                                    <field name="tax_ids"
                                           widget="many2many_tags"
                                           domain="[('type_tax_use','=','purchase')]"
                                           context="{'default_type_tax_use': 'purchase', 'search_view_ref': 'account.account_tax_view_search'}"
                                           options="{'no_create': True}"
                                           optional="show"/>
                                    <field name="currency_id" optional="hide"/>
                                    <field name="tax_amount" optional="hide"/>
                                    <field name="amount"/>
                                    <field name="tax_included" optional="hide"/>
                                    <field name="price_after_tax"
                                           optional="hide"/>

                                </list>
                            </field>
                            <group col="12" class="oe_invoice_lines_tab">
                                <group colspan="8">
                                    <field name="note" placeholder="Note..."
                                           colspan="2" nolabel="1"/>
                                </group>
                                <!-- Totals (only invoices / receipts) -->
                                <group colspan="4">
                                    <group class="oe_subtotal_footer oe_right">
                                        <field name="total_after_tax"
                                               force_save="1"
                                               class="oe_subtotal_footer_separator"/>
                                        <field name="total_taxes_amount"
                                               force_save="1"/>
                                        <field name="total_amount"
                                               force_save="1"/>

                                    </group>
                                </group>
                            </group>

                        </page>
                    </notebook>

                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="expense_payment_tree" model="ir.ui.view">
        <field name="name">expense.payment.tree</field>
        <field name="model">expense.payment</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date"/>
                <field name="state" widget="badge"
                       decoration-success="state == '2'"/>
            </list>
        </field>
    </record>


    <record id="expense_payment_sequence" model="ir.sequence">
        <field name="name">Pay Expense</field>
        <field name="code">expense.payment</field>
        <field name="prefix">EXP-PAY/</field>
        <field name="padding">5</field>
        <field name="number_increment">1</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="customer_expense_payment_action" model="ir.actions.act_window">
        <field name="name">Pay Expense</field>
        <field name="res_model">expense.payment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('payment_type', '=', '2')]</field>
        <field name="context">{'default_payment_type': '2'}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Expense
            </p>
        </field>
    </record>

    <record id="vendor_expense_payment_action" model="ir.actions.act_window">
        <field name="name">Pay Expense</field>
        <field name="res_model">expense.payment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('payment_type', '=', '1')]</field>
        <field name="context">{'default_payment_type': '1'}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Expense
            </p>
        </field>
    </record>

    <record id="rule_expense_payment" model="ir.rule">
        <field name="name">Pay Expense</field>
        <field name="model_id" ref="model_expense_payment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
