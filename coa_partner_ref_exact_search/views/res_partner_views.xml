<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Add "Reference (Exact)" option to the partner search bar -->
    <record id="view_res_partner_filter_ref_exact" model="ir.ui.view">
        <field name="name">res.partner.select.ref.exact</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="ref" string="Reference (Exact)"
                       filter_domain="[('ref', '=', self)]"/>
            </field>
        </field>
    </record>

</odoo>
