<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_form" model="ir.ui.view">
        <field name="name">res.config.settings.form</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="72"/>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='bank_cash']" position="before">
                <t groups="account.group_account_user">
                    <h2>Letters of Guarantee</h2>
                    <div class="row mt16 o_settings_container" id="default_accounts">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"></div>
                            <div class="o_setting_right_pane">
                                <div class="content-group">
                                    <div>
                                        <span class="o_form_label">Default Accounts for Letters of Guarantee:</span>
                                    </div>

                                    <div class="row mt8">
                                        <label for="journal_id" class="col-lg-5 o_light_label"/>
                                        <field name="journal_id"/>
                                    </div>
                                    <div class="row mt8">
                                        <label for="bid_bond_account_id" class="col-lg-4 o_light_label"/>
                                        <field name="bid_bond_account_id"/>
                                    </div>
                                    <div class="row mt8">
                                        <label for="performance_bond_account_id" class="col-lg-4 o_light_label"/>
                                        <field name="performance_bond_account_id"/>
                                    </div>
                                    <div class="row mt8">
                                        <label for="advance_payment_guarantee_account_id" class="col-lg-4 o_light_label"/>
                                        <field name="advance_payment_guarantee_account_id"/>
                                    </div>
                                    <div class="row mt8">
                                        <label for="maintenance_bond_account_id" class="col-lg-4 o_light_label"/>
                                        <field name="maintenance_bond_account_id"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_panel"></div>
                            <div class="o_setting_right_pane">
                                <div class="content-group">
                                    <div class="row mt8">

                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </xpath>
        </field>
    </record>
</odoo>
