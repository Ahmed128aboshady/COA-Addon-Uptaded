<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <record id="lg_bid_bond_form" model="ir.ui.view">
        <field name="name">lg.bid.bond.form</field>
        <field name="model">lg.bid.bond</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="confirm" type="object" string="Confirm" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="cancellation" type="object" string="Cancellation" class="oe_highlight" invisible="state != 'confirmed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,cancellation"/>
                </header>
                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <button name="action_view_all_account_move_line"
                                type="object" class="oe_stat_button"
                                icon="fa-pencil-square-o">
                            <field name="count_move_line" widget="statinfo"
                                   string="Journal Items"/>
                        </button>
                    </div>
                    <h1>
                        <field name="name" readonly="1"/>
                    </h1>
                    <br/>
                    <h3>
                        <field name="description"
                               placeholder="LG Bid Bond Purpose..."/>
                    </h3>
                    <group>
                        <group>
                            <field name="tender_no"/>
                            <field name="partner_id"/>
                            <field name="guarantee_amount"/>
                            <field name="currency_id"/>
                            <field name="beneficiary_name"/>
                            <field name="beneficiary_address"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="expiry_date"/>
                            <field name="journal_id"/>
                            <field name="bid_bond_account_id"/>
                            <field name="bank_account_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Guarantee Details">
                            <field name="guarantee_details" placeholder="Details..."/>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <record id="lg_bid_bond_tree" model="ir.ui.view">
        <field name="name">lg.bid.bond.tree</field>
        <field name="model">lg.bid.bond</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="tender_no"/>
                <field name="partner_id"/>
                <field name="guarantee_amount"/>
                <field name="currency_id"/>
                <field name="expiry_date"/>
                <field name="beneficiary_name"/>
                <field name="beneficiary_address"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="lg_bid_bond_sequence" model="ir.sequence">
        <field name="name">lg.bid.bond</field>
        <field name="code">lg.bid.bond</field>
        <field name="prefix">BID-BOND/</field>
        <field name="padding">5</field>
        <field name="number_increment">1</field>
    </record>

    <record id="lg_bid_bond_action" model="ir.actions.act_window">
        <field name="name">Bid Bond</field>
        <field name="res_model">lg.bid.bond</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Bid Bond
            </p>
        </field>
    </record>
</odoo>
