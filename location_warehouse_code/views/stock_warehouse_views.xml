<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit Warehouse Form View: add code after name -->
    <record id="view_warehouse_form_code" model="ir.ui.view">
        <field name="name">stock.warehouse.form.code</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="warehouse_code" placeholder="e.g. WH-001"/>
            </field>
        </field>
    </record>

    <!-- Inherit Warehouse Tree View: add code column after name -->
    <record id="view_warehouse_tree_code" model="ir.ui.view">
        <field name="name">stock.warehouse.tree.code</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="warehouse_code"/>
            </field>
        </field>
    </record>

</odoo>
