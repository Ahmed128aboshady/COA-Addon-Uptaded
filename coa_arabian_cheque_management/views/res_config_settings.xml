<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_form" model="ir.ui.view">
        <field name="name">res.config.settings.form</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="72"/>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='bank_cash']" position="after">
                <t groups="account.group_account_user">
                    <h2>Cheque Manage</h2>
                    <div class="row mt16 o_settings_container" id="default_accounts">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"></div>
                            <div class="o_setting_right_pane">
                                <div class="content-group">
                                    <div>
                                        <span class="o_form_label">Default Accounts for Incoming Cheques:</span>
                                    </div>

                                    <div class="row mt8">
                                        <label for="incoming_journal_id" class="col-lg-5 o_light_label"/>
                                        <field name="incoming_journal_id"/>
                                    </div>
                                    <div class="row mt8">
                                        <label for="notes_receivable_account_id" class="col-lg-4 o_light_label"/>
                                        <field name="notes_receivable_account_id"/>
                                    </div>
                                    <div class="row mt8">
                                        <label for="incoming_bank_account_id" class="col-lg-4 o_light_label"/>
                                        <field name="incoming_bank_account_id"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_panel"></div>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Default Accounts for Outgoing Cheques:</span>
                                <div class="content-group">
                                    <div class="row mt8">
                                        <label for="outgoing_journal_id" class="col-lg-4 o_light_label" />
                                        <field name="outgoing_journal_id"/>
                                    </div>
                                    <div class="row mt8">
                                        <label for="notes_payable_account_id" class="col-lg-5 o_light_label"/>
                                        <field name="notes_payable_account_id"/>
                                    </div>
                                    <div class="row mt8">
                                        <label for="outgoing_bank_account_id" class="col-lg-5 o_light_label"/>
                                        <field name="outgoing_bank_account_id"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </xpath>
        </field>
    </record>
</odoo>
