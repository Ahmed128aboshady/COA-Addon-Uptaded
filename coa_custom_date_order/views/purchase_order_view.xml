<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_order_form_inherit_custom_date_purchase" model="ir.ui.view">
        <field name="name">purchase_order_form_inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_order']" position="replace">
                <field name="order_deadline" invisible="state in ('purchase', 'done')"
                       readonly="state in ['cancel', 'done', 'purchase']" string='Order Deadline' />
            </xpath>

            <xpath expr="//label[@for='date_approve']" position="replace">
                <label for="confirmation_date" invisible="state not in ('purchase', 'done')"/>
            </xpath>

            <xpath expr="//field[@name='date_approve']" position="replace">
                <field name="confirmation_date"/>
            </xpath>

            <xpath expr="//label[@for='date_planned']" position="replace">
                <label for="expected_arrival"/>
            </xpath>

            <xpath expr="//field[@name='date_planned']" position="replace">
                <field name="expected_arrival" readonly="state not in ('draft', 'sent', 'to approve', 'purchase')"/>
            </xpath>


        </field>
    </record>
</odoo>