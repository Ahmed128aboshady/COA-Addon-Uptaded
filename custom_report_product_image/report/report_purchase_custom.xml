<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════════
         PURCHASE ORDER
         - Column 1 : Reference  (product_id.default_code)
         - Column 2 : Product    (product_id.name  — name only, no notes)
         Replaces the single "Description" column (line.name)
         ═══════════════════════════════════════════════════════════════════ -->
    <template id="report_purchaseorder_document_custom" inherit_id="purchase.report_purchaseorder_document">

        <!-- ── thead: replace "Description" with two headers ── -->
        <xpath expr="//th[@name='th_description']" position="replace">
            <th name="th_ref" class="text-start text-nowrap" style="width:120px;">
                <strong>Reference</strong>
            </th>
            <th name="th_description" class="text-start">
                <strong>Product</strong>
            </th>
        </xpath>

        <!-- ── product rows: replace td to show reference + product name only ── -->
        <xpath expr="//td[@id='product']" position="replace">
            <td class="text-start text-nowrap" style="width:120px; vertical-align:top;">
                <span t-if="not line.display_type" t-out="line.product_id.default_code or ''"/>
                <!-- section / note labels keep full width via colspan="99" below -->
            </td>
            <td id="product" class="text-start" style="vertical-align:top;">
                <span t-if="not line.display_type" t-out="line.product_id.name or line.name"/>
            </td>
        </xpath>

    </template>

</odoo>
