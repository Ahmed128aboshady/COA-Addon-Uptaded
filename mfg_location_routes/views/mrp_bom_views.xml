<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend BOM form -->
    <record id="view_mrp_bom_form_inherit_location" model="ir.ui.view">
        <field name="name">mrp.bom.form.inherit.mfg_location</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
        <field name="arch" type="xml">

            <!-- زر تحديث اللوكيشنات في الـ header -->
            <xpath expr="//sheet//div[hasclass('oe_button_box') or @name='button_box']" position="before">
                <div style="display:flex; gap:8px; margin-bottom:12px; align-items:center;">
                    <button name="action_sync_bom_locations" type="object"
                        string="🔄 تحديث لوكيشنات المكونات من الكاتجوري"
                        class="btn btn-secondary btn-sm"/>
                    <field name="unique_source_locations" readonly="1"
                        invisible="not has_multi_location_components"
                        widget="char"
                        style="font-size:12px; color:#666;"/>
                </div>
            </xpath>

            <!-- إضافة عمود لوكيشن السحب في BOM lines -->
            <xpath expr="//field[@name='bom_line_ids']/list/field[@name='product_id']" position="after">
                <field name="source_location_id" optional="show" string="لوكيشن السحب"
                    options="{'no_create': True}"
                    decoration-muted="not source_location_manual"
                    decoration-info="source_location_manual"/>
            </xpath>

            <!-- إضافة زر reset في الـ line -->
            <xpath expr="//field[@name='bom_line_ids']/list/field[@name='product_id']" position="before">
                <field name="source_location_manual" invisible="1"/>
                <field name="category_source_location_id" invisible="1"/>
            </xpath>

        </field>
    </record>

    <!-- Extend BOM list to show multi-location indicator -->
    <record id="view_mrp_bom_list_inherit_location" model="ir.ui.view">
        <field name="name">mrp.bom.list.inherit.mfg_location</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="has_multi_location_components"
                    string="لوكيشنات متعددة" optional="show" widget="boolean"/>
            </xpath>
        </field>
    </record>
</odoo>
