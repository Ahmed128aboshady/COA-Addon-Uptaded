<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend stock.rule list to show category -->
    <record id="view_stock_rule_list_inherit_category" model="ir.ui.view">
        <field name="name">stock.rule.list.inherit.mfg_location</field>
        <field name="model">stock.rule</field>
        <field name="inherit_id" ref="stock.view_stock_rule_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="category_id" optional="show" string="الكاتجوري"/>
                <field name="rule_type" optional="show" string="النوع" widget="badge"/>
            </xpath>
        </field>
    </record>

    <!-- Extend stock.rule form to show category -->
    <record id="view_stock_rule_form_inherit_category" model="ir.ui.view">
        <field name="name">stock.rule.form.inherit.mfg_location</field>
        <field name="model">stock.rule</field>
        <field name="inherit_id" ref="stock.view_stock_rule_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="category_id"/>
                <field name="rule_type"/>
            </xpath>
        </field>
    </record>

    <!-- Action: Rules grouped by category -->
    <record id="action_stock_rules_by_category" model="ir.actions.act_window">
        <field name="name">Stock Rules حسب الكاتجوري</field>
        <field name="res_model">stock.rule</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('category_id', '!=', False)]</field>
        <field name="context">{'group_by': 'category_id'}</field>
    </record>
</odoo>
