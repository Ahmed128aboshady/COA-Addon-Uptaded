<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wizard_fix_routes_form" model="ir.ui.view">
        <field name="name">wizard.fix.routes.form</field>
        <field name="model">wizard.fix.routes</field>
        <field name="arch" type="xml">
            <form string="🔧 تشخيص وإصلاح Routes">
                <sheet>
                    <div class="alert alert-warning" role="alert">
                        <strong>بيحل مشكلة:</strong>
                        "No rule has been found to replenish [X] in [Y]"<br/>
                        اختار الصنف أو الكاتجوري اللي عندها المشكلة، ثم اضغط "تشخيص" ثم "إصلاح".
                    </div>

                    <group string="نطاق العمل">
                        <field name="mode" widget="radio"/>
                        <field name="category_id"
                            invisible="mode != 'selected_category'"
                            required="mode == 'selected_category'"/>
                        <field name="product_id"
                            invisible="mode != 'selected_product'"
                            required="mode == 'selected_product'"/>
                    </group>

                    <group string="خيارات الإصلاح" invisible="diagnosed == False">
                        <group>
                            <field name="fix_sale"/>
                            <field name="fix_purchase"/>
                        </group>
                        <group>
                            <field name="fix_return"/>
                            <field name="fix_bom_locations"/>
                        </group>
                    </group>

                    <group string="نتيجة التشخيص" invisible="not diagnosis_result">
                        <field name="diagnosis_result" nolabel="1"
                            widget="text" readonly="1"
                            style="font-family: monospace; background:#f8f9fa; padding:12px; border-radius:6px; white-space:pre-wrap;"/>
                    </group>

                </sheet>
                <footer>
                    <button name="action_diagnose" string="🔍 تشخيص" type="object"
                        class="btn-primary"/>
                    <button name="action_fix" string="🔧 إصلاح" type="object"
                        class="btn-success" invisible="not diagnosed"/>
                    <button string="إغلاق" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to open wizard -->
    <record id="action_wizard_fix_routes" model="ir.actions.act_window">
        <field name="name">🔧 تشخيص وإصلاح Routes</field>
        <field name="res_model">wizard.fix.routes</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
