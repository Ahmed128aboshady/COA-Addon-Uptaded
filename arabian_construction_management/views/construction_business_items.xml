<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="construction_business_items_form" model="ir.ui.view">
        <field name="name">construction.business.items.form</field>
        <field name="model">construction.business.items</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="confirm" type="object" string="Confirm" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="create_breakdown" type="object" string="Create Breakdown" class="oe_highlight" invisible="state != 'confirm'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirm"/>
                </header>
                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <button name="action_view_all_breakdown"
                                type="object" class="oe_stat_button"
                                icon="fa-pencil-square-o">
                            <field name="count_breakdown" widget="statinfo"
                                   string="Breakdown"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="project_name"/>
                            <field name="project_number"/>
                            <field name="project_type_id"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="project_location"/>
                            <field name="project_description"/>
                            <field name="boq_cost_estimation_id"/>
                            <field name="construction_documents_folder_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Items">
                            <field name="construction_business_items_line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="construction_business_items_id" column_invisible="True"/>
                                    <field name="item_code"/>
                                    <field name="boq_documents_folder_id"/>
                                    <field name="description"/>
                                    <field name="name" force_save="1" column_invisible="1"/>
                                    <field name="business_item_id" optional="hide"/>
                                    <field name="business_items_types_id" optional="hide"/>
                                    <field name="uom_id"/>
                                    <field name="quantity"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="construction_business_items_sequence" model="ir.sequence">
        <field name="name">construction.business.items</field>
        <field name="code">construction.business.items</field>
        <field name="prefix">CBI/</field>
        <field name="padding">5</field>
        <field name="number_increment">1</field>
    </record>
    

    <record id="construction_business_items_tree" model="ir.ui.view">
        <field name="name">construction.business.items.tree</field>
        <field name="model">construction.business.items</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="project_id"/>
                <field name="project_name"/>
                <field name="project_number"/>
                <field name="project_description"/>
            </list>
        </field>
    </record>
    
    
    <record id="construction_business_items_action" model="ir.actions.act_window">
        <field name="name">Construction Business Items</field>
        <field name="res_model">construction.business.items</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Construction Business Items
            </p>
        </field>
    </record>
</odoo>
