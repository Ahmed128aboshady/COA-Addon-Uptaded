<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="inherit_expense_payment_form" model="ir.ui.view">
        <field name="name">inherit.expense.payment.form</field>
        <field name="model">expense.payment</field>
        <field name="inherit_id" ref="arabian_expense_payment.expense_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="construction_project_id"/>
                <field name="project_name"/>
                <field name="project_number"/>
                <field name="boq_cost_estimation_line_id"/>
            </xpath>
        </field>
    </record>
</odoo>
