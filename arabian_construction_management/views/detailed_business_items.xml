<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="detailed_business_items_formm" model="ir.ui.view">
        <field name="name">detailed.business.items.form</field>
        <field name="model">detailed.business.items</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="business_items_types_id"/>
                            <field name="uom_id"/>
                        </group>
                        <group>
                            <field name="active"/>
                            <field name="description"/>
                            <field name="color" invisible="1"/>
                        </group>
                    </group>
                </sheet>
<!--                <div class="oe_chatter">-->
<!--                    <field name="message_follower_ids" widget="mail_followers"/>-->
<!--                    <field name="activity_ids" widget="mail_activity"/>-->
<!--                    <field name="message_ids" widget="mail_thread"/>-->
<!--                </div>-->
            </form>
        </field>
    </record>

    <record id="detailed_business_items_tree" model="ir.ui.view">
        <field name="name">detailed.business.items.tree</field>
        <field name="model">detailed.business.items</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="description"/>
                <field name="business_items_types_id"/>
                <field name="uom_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>


    <record id="detailed_business_items_action" model="ir.actions.act_window">
        <field name="name">Detailed Business Items</field>
        <field name="res_model">detailed.business.items</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Detailed Business Items
            </p>
        </field>
    </record>
</odoo>
