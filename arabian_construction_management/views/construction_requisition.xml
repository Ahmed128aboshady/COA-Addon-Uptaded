<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="inherit_construction_requisition_form" model="ir.ui.view">
        <field name="name">inherit.construction.requisition.form</field>
        <field name="model">construction.requisition</field>
        <field name="inherit_id" ref="arabian_requisition.construction_requisition_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='description']" position="before">
                <field name="construction_project_id"/>
                <field name="project_name"/>
                <field name="project_number"/>
                <field name="project_id"/>
                <field name="project_task_id"/>
                <field name="boq_cost_estimation_line_id"/>
            </xpath>
        </field>
    </record>
</odoo>
