<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="create_business_items_form" model="ir.ui.view">
        <field name="name">create.business.items.form</field>
        <field name="model">create.business.items</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <notebook>
                        <page string="Business Items">
                            <field name="create_business_items_lines_ids">               <!-- add  context="{'default_field' : field}" to set default value -->
                                <list editable="bottom" create="1" edit="1">
                                    <field name="create_business_items_id"
                                           column_invisible="True"/>       <!-- add  domain="[('id','=',parent.field)]" to set default domain -->
                                    <field name="item_code"/>
                                    <field name="description"/>
                                    <field name="business_item_id" optional="hide"/>
                                    <field name="business_items_types_id" optional="hide"/>
                                    <field name="uom_id"/>
                                    <field name="quantity"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="confirm" type="object" string="Confirm" class="oe_highlight" />
                    <button string="Cancel" special="cancel" />
                </footer>
            </form>
        </field>
    </record>


    <record model="ir.actions.act_window" id="create_business_items_action">
        <field name="name">Create Business Items</field>
        <field name="res_model">create.business.items</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
