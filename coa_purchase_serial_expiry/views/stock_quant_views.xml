<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════════
         Physical Inventory (stock.quant) – Expiry Date column

         Behaviour:
         • No lot + positive diff  → type expiry → new lot auto-created on Apply
         • No lot + negative diff  → leave empty → FIFO from oldest lot
         • Existing lot row        → shows / edits that lot's expiry date
    ══════════════════════════════════════════════════════════════════ -->
    <record id="view_stock_quant_inventory_expiry" model="ir.ui.view">
        <field name="name">stock.quant.inventory.expiry</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable"/>
        <field name="arch" type="xml">
            <!-- Add Expiry Date column right after the Lot/Serial Number column -->
            <xpath expr="//field[@name='lot_id'][@groups='stock.group_production_lot']" position="after">
                <field name="inventory_expiry_date"
                       string="Expiry Date"
                       groups="stock.group_production_lot"
                       decoration-danger="inventory_expiry_date and inventory_expiry_date &lt; context_today().strftime('%Y-%m-%d')"
                       decoration-warning="inventory_expiry_date and inventory_expiry_date &gt;= context_today().strftime('%Y-%m-%d')"
                />
            </xpath>
        </field>
    </record>

</odoo>
