<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════════
         Lot Expiry Report – based on stock.lot with our custom expiry_date
         • On Hand Qty = internal locations only (no Pre/Post-Production)
         • Default: In Stock (internal_product_qty > 0)
    ══════════════════════════════════════════════════════════════════ -->

    <record id="view_lot_expiry_report_list" model="ir.ui.view">
        <field name="name">stock.lot.expiry.report.list</field>
        <field name="model">stock.lot</field>
        <field name="arch" type="xml">
            <list string="Lot Expiry Report"
                  decoration-danger="expiry_status == 'expired'"
                  decoration-warning="expiry_status == 'near'">
                <field name="name" string="Lot / Batch"/>
                <field name="product_id" string="Product"/>
                <field name="product_category_id" string="Category" optional="show"/>
                <field name="internal_product_qty" string="On Hand Qty"/>
                <field name="expiry_date" string="Expiry Date"/>
                <field name="days_to_expiry" string="Days Left"
                       decoration-danger="days_to_expiry &lt; 0"
                       decoration-warning="days_to_expiry &gt;= 0 and days_to_expiry &lt;= 30"
                />
                <field name="expiry_status" widget="badge"
                       decoration-success="expiry_status == 'ok'"
                       decoration-warning="expiry_status == 'near'"
                       decoration-danger="expiry_status == 'expired'"
                       string="Status"
                />
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_lot_expiry_report_graph" model="ir.ui.view">
        <field name="name">stock.lot.expiry.report.graph</field>
        <field name="model">stock.lot</field>
        <field name="arch" type="xml">
            <graph string="Lot Expiry Analysis" type="bar">
                <field name="expiry_status" type="row" string="Status"/>
                <field name="product_id" type="row" string="Product"/>
                <field name="internal_product_qty" type="measure" string="On Hand Qty"/>
            </graph>
        </field>
    </record>

    <record id="view_lot_expiry_report_pivot" model="ir.ui.view">
        <field name="name">stock.lot.expiry.report.pivot</field>
        <field name="model">stock.lot</field>
        <field name="arch" type="xml">
            <pivot string="Lot Expiry Pivot">
                <field name="expiry_status" type="row"/>
                <field name="product_id" type="row"/>
                <field name="expiry_date" type="col" interval="month"/>
                <field name="internal_product_qty" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_lot_expiry_report_search" model="ir.ui.view">
        <field name="name">stock.lot.expiry.report.search</field>
        <field name="model">stock.lot</field>
        <field name="arch" type="xml">
            <search string="Lot Expiry Report">
                <field name="name" string="Lot #"/>
                <field name="product_id" string="Product"/>
                <field name="product_category_id" string="Category"/>
                <separator/>
                <!-- Status filters -->
                <filter string="Expired" name="filter_expired"
                        domain="[('expiry_status','=','expired')]"/>
                <filter string="Expiring ≤30 days" name="filter_near"
                        domain="[('expiry_status','=','near')]"/>
                <filter string="Valid" name="filter_ok"
                        domain="[('expiry_status','=','ok')]"/>
                <separator/>
                <!-- Stock filters (uses internal_product_qty → excludes production locations) -->
                <filter string="In Stock" name="filter_in_stock"
                        domain="[('internal_product_qty','&gt;',0)]"/>
                <filter string="Has Expiry Date" name="filter_has_expiry"
                        domain="[('expiry_date','!=',False)]"/>
                <separator/>
                <group>
                    <filter string="Expiry Status" name="group_status"
                            context="{'group_by':'expiry_status'}"/>
                    <filter string="Product" name="group_product"
                            context="{'group_by':'product_id'}"/>
                    <filter string="Category" name="group_category"
                            context="{'group_by':'product_category_id'}"/>
                    <filter string="Expiry Month" name="group_month"
                            context="{'group_by':'expiry_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════
         Lot Movement History – stock.move.line list (per lot)
    ══════════════════════════════════════════════════════════════════ -->

    <record id="view_lot_move_line_history_list" model="ir.ui.view">
        <field name="name">stock.move.line.lot.history.list</field>
        <field name="model">stock.move.line</field>
        <field name="arch" type="xml">
            <list string="Movement History"
                  create="false" edit="false" delete="false"
                  default_order="date desc">
                <field name="date" string="Date"/>
                <field name="reference" string="Reference"/>
                <field name="picking_id" string="Transfer"/>
                <field name="picking_type_id" string="Operation Type" optional="show"/>
                <field name="location_id" string="From"/>
                <field name="location_dest_id" string="To"/>
                <field name="quantity" string="Qty"/>
                <field name="product_uom_id" string="UoM" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════
         Lot Expiry Report – Form view (opens when clicking a row)
         Shows lot info + full movement history inline
    ══════════════════════════════════════════════════════════════════ -->

    <record id="view_lot_expiry_report_form" model="ir.ui.view">
        <field name="name">stock.lot.expiry.report.form</field>
        <field name="model">stock.lot</field>
        <field name="arch" type="xml">
            <form string="Lot Details" create="false" edit="false" delete="false">
                <sheet>
                    <!-- Smart buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_moves"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-exchange">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Movements</span>
                            </div>
                        </button>
                    </div>

                    <!-- Lot info summary -->
                    <group>
                        <group>
                            <field name="name" string="Lot / Batch No."/>
                            <field name="product_id" string="Product"/>
                            <field name="product_category_id" string="Category"/>
                        </group>
                        <group>
                            <field name="expiry_date" string="Expiry Date"/>
                            <field name="days_to_expiry" string="Days Left"/>
                            <field name="expiry_status" widget="badge"
                                   decoration-success="expiry_status == 'ok'"
                                   decoration-warning="expiry_status == 'near'"
                                   decoration-danger="expiry_status == 'expired'"
                                   string="Status"/>
                            <field name="internal_product_qty" string="On Hand Qty"/>
                        </group>
                    </group>

                    <!-- Movement History -->
                    <notebook>
                        <page string="Movement History" name="move_history">
                            <field name="move_line_ids"
                                   mode="list"
                                   readonly="1"
                                   context="{'default_lot_id': id}"
                                   domain="[('state', '=', 'done')]">
                                <list string="Movements"
                                      create="false" delete="false"
                                      default_order="date desc">
                                    <field name="date" string="Date"/>
                                    <field name="reference" string="Reference"/>
                                    <field name="picking_id" string="Transfer"/>
                                    <field name="picking_type_id" string="Operation Type" optional="show"/>
                                    <field name="location_id" string="From"/>
                                    <field name="location_dest_id" string="To"/>
                                    <field name="quantity" string="Qty"/>
                                    <field name="product_uom_id" string="UoM" optional="hide"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action: Lot Expiry Report
         Default: show all lots with expiry_date that have internal stock > 0 -->
    <record id="action_lot_expiry_report" model="ir.actions.act_window">
        <field name="name">Lot Expiry Report</field>
        <field name="res_model">stock.lot</field>
        <field name="view_mode">list,form,graph,pivot</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list',  'view_id': ref('view_lot_expiry_report_list')}),
            (0, 0, {'view_mode': 'form',  'view_id': ref('view_lot_expiry_report_form')}),
            (0, 0, {'view_mode': 'graph', 'view_id': ref('view_lot_expiry_report_graph')}),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_lot_expiry_report_pivot')}),
        ]"/>
        <field name="search_view_id" ref="view_lot_expiry_report_search"/>
        <!-- Base domain: only lots that have expiry_date set -->
        <field name="domain">[('expiry_date','!=',False)]</field>
        <!-- Default: In Stock filter ON → hides lots with 0 internal qty (excl. Pre/Post-Production) -->
        <field name="context">{'search_default_filter_in_stock': 1}</field>
    </record>

</odoo>
