<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="account_payment_commission_form" model="ir.ui.view">
            <field name="name">account.payment.commission.form</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_form"/>
            <field name="arch" type="xml">

                <!-- خانة المبلغ قبل الخصم — فوق خانة المبلغ المسدد -->
                <xpath expr="//field[@name='amount']" position="before">
                    <field name="amount_before_commission"
                           invisible="not has_active_commission"
                           string="المبلغ قبل خصم العمولة"
                           help="اكتب المبلغ الكلي هنا — وأودو هيحسب الصافي تلقائياً"/>
                </xpath>

                <!-- تفاصيل العمولة بعد خانة المبلغ -->
                <xpath expr="//field[@name='amount']" position="after">
                    <field name="commission_rate"
                           invisible="not has_active_commission"
                           string="نسبة العمولة %"
                           readonly="1"/>
                    <field name="commission_amount"
                           invisible="not has_active_commission"
                           string="قيمة العمولة المخصومة"
                           readonly="1"/>
                    <field name="has_active_commission" invisible="1"/>
                </xpath>

            </field>
        </record>

    </data>
</odoo>
