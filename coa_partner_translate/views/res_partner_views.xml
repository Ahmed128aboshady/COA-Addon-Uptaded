<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_translate" model="ir.ui.view">
        <field name="name">res.partner.form.translate</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <!-- Add Arabic/English name fields after the main name h1 -->
            <xpath expr="//h1[hasclass('mb-0')]" position="after">
                <div style="margin-top:4px; margin-bottom:4px;">
                    <field name="name_en"
                           placeholder="English Name / الاسم بالإنجليزية"
                           string="English Name / الاسم بالإنجليزية"
                           style="width:100%; font-size:11pt;"/>
                    <field name="name_ar"
                           placeholder="الاسم بالعربية / Arabic Name"
                           string="Arabic Name / الاسم بالعربية"
                           style="width:100%; font-size:11pt; direction:rtl; text-align:right;"/>
                </div>
            </xpath>

        </field>
    </record>
</odoo>
