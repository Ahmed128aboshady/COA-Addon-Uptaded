<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_manufacturing_machine_list" model="ir.ui.view">
        <field name="name">manufacturing.machine.list</field>
        <field name="model">manufacturing.machine</field>
        <field name="arch" type="xml">
            <list string="Machines">
                <field name="name"/>
                <field name="code"/>
                <field name="hourly_cost"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_manufacturing_machine_form" model="ir.ui.view">
        <field name="name">manufacturing.machine.form</field>
        <field name="model">manufacturing.machine</field>
        <field name="arch" type="xml">
            <form string="Machine">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Machine Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="hourly_cost"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_manufacturing_machine" model="ir.actions.act_window">
        <field name="name">Machines</field>
        <field name="res_model">manufacturing.machine</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
