#. module: manufacturing_machines
#: model_terms:ir.ui.view,arch_db:manufacturing_machines.view_mfg_machine_settings
msgid ""
"<strong>Debit ←</strong> Records all overhead items added manually in production orders.<br/>\n"
"                            Choose a <em>General Production Expenses</em> or <em>Indirect Costs</em> account."
msgstr ""

#. module: manufacturing_machines
#: model_terms:ir.ui.view,arch_db:manufacturing_machines.view_mfg_machine_settings
msgid ""
"<strong>Debit ←</strong> Records the cost of each machine operating hour.<br/>\n"
"                            Choose an <em>Equipment Operating Expenses</em> or <em>Direct Production Costs</em> account."
msgstr ""

#. module: manufacturing_machines
#: model_terms:ir.ui.view,arch_db:manufacturing_machines.view_mfg_machine_settings
msgid ""
"<strong>Debit ←</strong> Records the cost of each maintenance operation (labor + spare parts).<br/>\n"
"                            Choose an <em>Equipment Maintenance and Repair</em> account. If left empty, the account set on the machine itself will be used."
msgstr ""

#. module: manufacturing_machines
#: model_terms:ir.ui.view,arch_db:manufacturing_machines.view_mfg_machine_settings
msgid ""
"<strong>Debit ←</strong> Records total worker wages in production orders.<br/>\n"
"                            Choose a <em>Manufacturing Worker Wages</em> or <em>Direct Labor Costs</em> account."
