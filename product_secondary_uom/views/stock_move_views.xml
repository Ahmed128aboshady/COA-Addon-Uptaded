<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend stock move line operation tree (detail popup from picking) -->
    <record id="view_stock_move_line_operation_tree_secondary_uom" model="ir.ui.view">
        <field name="name">stock.move.line.operations.list.secondary.uom</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree"/>
        <field name="arch" type="xml">
            <field name="product_uom_id" position="after">
                <field name="has_secondary_uom" column_invisible="True"/>
                <field name="secondary_quantity"
                       string="Sec. Qty"
                       invisible="not has_secondary_uom"
                       optional="show"/>
                <field name="secondary_uom_id"
                       string="Sec. UoM"
                       invisible="not has_secondary_uom"
                       optional="show"/>
            </field>
        </field>
    </record>

    <!-- Extend stock move line detailed operation tree -->
    <record id="view_stock_move_line_detailed_operation_tree_secondary_uom" model="ir.ui.view">
        <field name="name">stock.move.line.detailed.operations.list.secondary.uom</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
        <field name="arch" type="xml">
            <field name="product_uom_id" position="after">
                <field name="has_secondary_uom" column_invisible="True"/>
                <field name="secondary_quantity"
                       string="Sec. Qty"
                       invisible="not has_secondary_uom"
                       optional="show"/>
                <field name="secondary_uom_id"
                       string="Sec. UoM"
                       invisible="not has_secondary_uom"
                       optional="show"/>
            </field>
        </field>
    </record>
</odoo>
