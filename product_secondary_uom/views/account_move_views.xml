<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend account move (invoice) form view -->
    <record id="view_move_form_secondary_uom" model="ir.ui.view">
        <field name="name">account.move.form.secondary.uom</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- In the invoice line tree, add after product_uom_id -->
            <xpath expr="//field[@name='invoice_line_ids']//list//field[@name='product_uom_id'][1]" position="after">
                <field name="has_secondary_uom" column_invisible="True"/>
                <field name="secondary_quantity"
                       string="Sec. Qty"
                       invisible="not has_secondary_uom"
                       optional="show"/>
                <field name="secondary_uom_id"
                       string="Sec. UoM"
                       invisible="not has_secondary_uom"
                       optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
