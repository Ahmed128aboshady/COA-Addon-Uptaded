<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_negative_stock" model="ir.module.category">
        <field name="name">Negative Stock Control</field>
        <field name="sequence">60</field>
    </record>

    <record id="privilege_negative_stock" model="res.groups.privilege">
        <field name="name">Negative Stock</field>
        <field name="category_id" ref="module_category_negative_stock"/>
        <field name="sequence">60</field>
    </record>

    <record id="group_negative_stock_bypass" model="res.groups">
        <field name="name">Bypass Negative Stock Block</field>
        <field name="privilege_id" ref="privilege_negative_stock"/>
        <field name="comment">Users in this group can validate operations even
if they drive stock negative. Grant only to supervisors/administrators for
exceptional situations (e.g. warehouse receipt scanned late).</field>
    </record>
</odoo>
