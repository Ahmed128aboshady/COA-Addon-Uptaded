<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Product template form: add flag in the Inventory tab -->
    <record id="product_template_form_view_negative_stock" model="ir.ui.view">
        <field name="name">product.template.form.negative.stock</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock.view_template_property_form"/>
        <field name="arch" type="xml">
            <group name="operations" position="inside">
                <group name="negative_stock" string="Negative Stock"
                       groups="base.group_system"
                       invisible="not is_storable">
                    <field name="allow_negative_stock"/>
                </group>
            </group>
        </field>
    </record>

    <!-- Product category form -->
    <record id="product_category_form_view_negative_stock" model="ir.ui.view">
        <field name="name">product.category.form.negative.stock</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <group name="first" position="inside">
                <field name="allow_negative_stock"/>
            </group>
        </field>
    </record>
</odoo>
