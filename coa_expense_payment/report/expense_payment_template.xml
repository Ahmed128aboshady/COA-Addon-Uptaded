<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="expense_payment_template">
        <t t-foreach="docs" t-as="o">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h3>
                            <strong>
                                <span t-field="o.name"/>
                            </strong>
                        </h3>
                        <table class="table table-borderless">

                            <tbody>
                                <tr>
                                    <th scope="row">Reference:</th>

                                    <td>
                                        <span t-field="o.reference"/>
                                    </td>
                                    <th scope="row">
                                        Date:
                                    </th>
                                    <td>
                                        <span t-field="o.date"/>
                                    </td>

                                </tr>
                                <tr>
                                    <th scope="row"></th>
                                    <td>
                                    </td>
                                    <th scope="row">
                                        Journal:
                                    </th>
                                    <td>
                                        <span t-field="o.journal_id.name"/>
                                    </td>

                                </tr>
                            </tbody>
                        </table>
                        <br/>
                        <br/>
                        <table class="table table-condensed">
                            <thead>
                                <tr>
                                    <th class="text-right">Product</th>
                                    <th class="text-right">Description</th>
                                    <th class="text-right">Account</th>
                                    <th class="text-right">Employee</th>
                                    <th class="text-right">Taxes</th>
                                    <th class="text-right">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.expense_payment_line_ids"
                                    t-as="line">
                                    <td class="text-center"
                                        style="text-align:center">
                                        <t t-esc="line.product_id.name"/>
                                    </td>
                                    <td class="text-center"
                                        style="text-align:center">
                                        <t t-esc="line.memo"/>
                                    </td>
                                    <td class="text-center"
                                        style="text-align:center">
                                        <t t-esc="line.account_id.name"/>
                                    </td>
                                    <td class="text-center"
                                        style="text-align:center">
                                        <t t-esc="line.employee_id.name"/>
                                    </td>
                                    <td t-attf-class="text-start {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                        <span t-esc="', '.join(map(lambda x: (x.description or x.name), line.tax_ids))" id="line_tax_ids"/>
                                    </td>
                                    <td class="text-center"
                                        style="text-align:center">
                                        <t t-esc="line.amount"/>
                                    </td>

                                </tr>
                            </tbody>
                        </table>
                        <div class="clearfix mb-4">
                            <div id="total" class="row">
                                <div t-attf-class="#{'col-6' if report_type != 'html' else 'col-sm-7 col-md-6'} ms-auto">
                                    <table class="table table-sm table-borderless"
                                           style="page-break-inside: avoid;">

                                        <t>
                                            <tr class="border-black fw-bold">
                                                <td>Total Amount</td>
                                                <td class="text-end">
                                                    <span t-field="o.total_amount"/>
                                                </td>
                                            </tr>


                                        </t>
                                    </table>
                                </div>
                            </div>
                        </div>
                        <br/>
                        <br/>

                        <table class="table table-borderless" style="margin-bottom: -20px; color: black;">

                            <thead>
                                <tr>
                                    <th class="text-right" style="color: black !important;">SUBMITTED BY</th>
                                    <th class="text-right" style="color: black !important;">CHECKED BY</th>
                                    <th class="text-right" style="color: black !important;">PREPARED BY</th>
                                    <th class="text-right" style="color: black !important;">APPROVED BY</th>
                                    <th class="text-right" style="color: black !important;">RECEIVED BY</th>
                                </tr>
                            </thead>

                        </table>


                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
