<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="inherit_account_move_form" model="ir.ui.view">
        <field name="name">inherit.account.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ref']" position="after">
                <field name="expense_payment_id"
                       invisible="expense_payment_id == False"
                />
            </xpath>
            <xpath expr="//field[@name='line_ids']//list//field[@name='account_id']"
                   position="after">
                <field name="memo"
                column_invisible="parent.state != 'entry'"
                       optional="hide"/>
                <field name="expense_payment_id" column_invisible="1"/>
                <field name="employee_id"
                       column_invisible="parent.state != 'entry'"
                       optional="hide"/>
            </xpath>

        </field>
    </record>
</odoo>
