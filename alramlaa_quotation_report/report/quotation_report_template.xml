<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="report_alramlaa_quotation_document">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="o">
            <t t-call="alramlaa_quotation_report.report_alramlaa_quotation_page"
               t-lang="o.partner_id.lang"/>
        </t>
    </t>
</template>

<!-- ================================================================
     MAIN PAGE TEMPLATE
================================================================ -->
<template id="report_alramlaa_quotation_page">
    <t t-call="web.external_layout">

        <!-- ══════════════════════════════════════════════
             PAGE 1 - SUMMARY / ملخص
        ══════════════════════════════════════════════ -->
        <div class="page alramlaa-page">

            <!-- CSS Styles -->
            <style>
                @import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&amp;display=swap');

                .alramlaa-page {
                    font-family: 'Cairo', Arial, sans-serif;
                    font-size: 10pt;
                    color: #2c2c2c;
                    direction: ltr;
                }

                /* ── HEADER ── */
                .alr-header {
                    width: 100%;
                    border-bottom: 3px solid #b5651d;
                    padding-bottom: 8px;
                    margin-bottom: 14px;
                }
                .alr-logo {
                    max-height: 80px;
                    max-width: 200px;
                }
                .alr-company-name-ar {
                    font-size: 14pt;
                    font-weight: 700;
                    color: #b5651d;
                    direction: rtl;
                }
                .alr-company-name-en {
                    font-size: 11pt;
                    font-weight: 600;
                    color: #5c3317;
                }

                /* ── QUOTATION TITLE BAR ── */
                .alr-title-bar {
                    background-color: #c8a97e;
                    color: #fff;
                    text-align: center;
                    font-size: 13pt;
                    font-weight: 700;
                    padding: 6px 0;
                    margin-bottom: 12px;
                    letter-spacing: 1px;
                }

                /* ── META TABLE ── */
                .alr-meta-table {
                    width: 100%;
                    border-collapse: collapse;
                    margin-bottom: 14px;
                    font-size: 9.5pt;
                }
                .alr-meta-table td {
                    padding: 4px 8px;
                    border: 1px solid #d9c9b0;
                }
                .alr-meta-label {
                    background-color: #f5ede0;
                    font-weight: 600;
                    color: #5c3317;
                    width: 120px;
                }
                .alr-meta-value {
                    font-weight: 500;
                }

                /* ── SECTION HEADER ── */
                .alr-section-header {
                    background-color: #c8a97e;
                    color: #fff;
                    text-align: center;
                    font-size: 11pt;
                    font-weight: 700;
                    padding: 5px 10px;
                    margin: 10px 0 0 0;
                }

                /* ── SUMMARY TABLE ── */
                .alr-summary-table {
                    width: 100%;
                    border-collapse: collapse;
                    font-size: 9.5pt;
                }
                .alr-summary-table th {
                    background-color: #5c3317;
                    color: #fff;
                    padding: 6px 10px;
                    text-align: left;
                }
                .alr-summary-table th.rtl {
                    text-align: right;
                    direction: rtl;
                }
                .alr-summary-table td {
                    padding: 6px 10px;
                    border-bottom: 1px solid #e8d8c0;
                }
                .alr-summary-table tr:nth-child(even) td {
                    background-color: #faf5ee;
                }
                .alr-summary-total {
                    background-color: #f5ede0;
                    font-weight: 700;
                }
                .alr-summary-grand {
                    background-color: #5c3317;
                    color: #fff;
                    font-weight: 700;
                    font-size: 10.5pt;
                }
                .alr-summary-vat {
                    background-color: #e8d8c0;
                    font-weight: 600;
                }

                /* ── TERMS ── */
                .alr-terms {
                    margin-top: 18px;
                    font-size: 9pt;
                }
                .alr-terms-title {
                    font-weight: 700;
                    font-size: 10pt;
                    color: #5c3317;
                    margin-bottom: 4px;
                }
                .alr-terms-row {
                    display: flex;
                    gap: 40px;
                }
                .alr-terms-col {
                    flex: 1;
                }
                .alr-terms-col-ar {
                    flex: 1;
                    direction: rtl;
                    text-align: right;
                }

                /* ── NOTES ── */
                .alr-notes-box {
                    background-color: #fff3cd;
                    border: 1px solid #c8a97e;
                    padding: 6px 12px;
                    font-weight: 700;
                    font-size: 10pt;
                    color: #b5651d;
                    text-align: center;
                    margin-top: 10px;
                }

                /* ── SIGNATURE ROW ── */
                .alr-sig-table {
                    width: 100%;
                    margin-top: 30px;
                    font-size: 9pt;
                    border-collapse: collapse;
                    table-layout: fixed;
                }
                .alr-sig-table td {
                    text-align: center;
                    vertical-align: bottom;
                    padding: 0 8px;
                    width: 25%;
                }
                .alr-sig-name {
                    font-weight: 700;
                    font-size: 9pt;
                    color: #2c2c2c;
                    min-height: 30px;
                    display: block;
                }
                .alr-sig-line {
                    border-top: 1px solid #2c2c2c;
                    margin-top: 30px;
                    padding-top: 4px;
                    font-size: 8pt;
                    color: #5c3317;
                }

                /* ── DETAIL TABLE ── */
                .alr-detail-table {
                    width: 100%;
                    border-collapse: collapse;
                    font-size: 8.5pt;
                    margin-top: 10px;
                }
                .alr-detail-table th {
                    background-color: #5c3317;
                    color: #fff;
                    padding: 5px 6px;
                    text-align: center;
                    border: 1px solid #c8a97e;
                    font-size: 8pt;
                }
                .alr-detail-table td {
                    padding: 5px 6px;
                    border: 1px solid #e8d8c0;
                    vertical-align: top;
                }
                .alr-detail-table tr:nth-child(even) td {
                    background-color: #faf5ee;
                }
                .alr-detail-table .td-img {
                    width: 80px;
                    text-align: center;
                }
                .alr-detail-table .td-img img {
                    max-width: 75px;
                    max-height: 75px;
                    object-fit: contain;
                }
                .alr-detail-table .td-no {
                    width: 35px;
                    text-align: center;
                    font-weight: 700;
                }
                .alr-detail-table .td-desc {
                    width: 110px;
                    font-weight: 600;
                }
                .alr-detail-table .td-dim {
                    width: 90px;
                    text-align: center;
                    font-size: 8pt;
                    color: #555;
                }
                .alr-detail-table .td-mat {
                    /* takes remaining space */
                }
                .alr-detail-table .td-unit {
                    width: 35px;
                    text-align: center;
                }
                .alr-detail-table .td-qty {
                    width: 35px;
                    text-align: center;
                }
                .alr-detail-table .td-uprice {
                    width: 70px;
                    text-align: right;
                }
                .alr-detail-table .td-tprice {
                    width: 75px;
                    text-align: right;
                    font-weight: 600;
                }
                .alr-section-sub {
                    background-color: #e8d8c0;
                    font-weight: 700;
                    font-size: 9.5pt;
                    padding: 5px 10px;
                    color: #5c3317;
                    border: 1px solid #c8a97e;
                }
                .alr-total-row td {
                    background-color: #5c3317;
                    color: #fff;
                    font-weight: 700;
                    font-size: 10pt;
                    text-align: right;
                    padding: 7px 10px;
                    border: none;
                }

                /* ── FOOTER ── */
                .alr-footer {
                    background-color: #5c3317;
                    color: #fff;
                    font-size: 8pt;
                    padding: 8px 12px;
                    margin-top: 20px;
                    display: flex;
                    justify-content: space-between;
                    align-items: center;
                }
                .alr-footer-badge {
                    background-color: #c8a97e;
                    color: #fff;
                    font-weight: 700;
                    font-size: 9pt;
                    padding: 4px 10px;
                    text-align: center;
                    direction: rtl;
                }

                .text-right { text-align: right; }
                .text-center { text-align: center; }
                .text-left { text-align: left; }
                .font-bold { font-weight: 700; }
                .color-brown { color: #b5651d; }
                .mt-10 { margin-top: 10px; }
                .num { font-family: 'Courier New', monospace; }
            </style>

            <!-- ══ HEADER ══ -->
            <table class="alr-header" style="width:100%;">
                <tr>
                    <td style="width:50%; vertical-align:middle;">
                        <t t-if="o.company_id.logo">
                            <img t-att-src="image_data_uri(o.company_id.logo)"
                                 class="alr-logo" alt="Logo"/>
                        </t>
                    </td>
                    <td style="width:50%; text-align:right; vertical-align:middle;">
                        <div class="alr-company-name-ar">
                            <t t-esc="o.company_id.name"/>
                        </div>
                        <div class="alr-company-name-en" style="color:#5c3317;">
                            Al Ramlaa Wooden Products
                        </div>
                    </td>
                </tr>
            </table>

            <!-- ══ TITLE BAR ══ -->
            <div class="alr-title-bar">
                QUOTATION / عرض سعر
            </div>

            <!-- ══ META TABLE ══ -->
            <table class="alr-meta-table">
                <tr>
                    <td class="alr-meta-label">Date Quote / تاريخ</td>
                    <td class="alr-meta-value">
                        <span t-field="o.date_order" t-options='{"widget":"date"}'/>
                    </td>
                    <td class="alr-meta-label">Quotation No. / رقم العرض</td>
                    <td class="alr-meta-value font-bold color-brown">
                        <span t-field="o.name"/>
                    </td>
                </tr>
                <tr>
                    <td class="alr-meta-label">Project Name / اسم المشروع</td>
                    <td class="alr-meta-value">
                        <t t-if="'project_id' in o._fields and o.project_id">
                            <t t-esc="o.project_id.name"/>
                        </t>
                        <t t-else="">
                            <t t-esc="o.partner_id.name"/>
                        </t>
                    </td>
                    <td class="alr-meta-label">Project Location / موقع</td>
                    <td class="alr-meta-value">
                        <t t-esc="o.partner_id.city or ''"/>
                    </td>
                </tr>
                <tr>
                    <td class="alr-meta-label">Customer Name / اسم العميل</td>
                    <td class="alr-meta-value">
                        <t t-esc="o.partner_id.name"/>
                    </td>
                    <td class="alr-meta-label">Contact No. / التواصل</td>
                    <td class="alr-meta-value">
                        <t t-esc="o.partner_id.phone or ''"/>
                    </td>
                </tr>
                <tr>
                    <td class="alr-meta-label">Follow Up / المتابعة</td>
                    <td class="alr-meta-value">
                        <t t-esc="o.user_id.name or ''"/>
                    </td>
                    <td class="alr-meta-label">Contact No. 2 / التواصل 2</td>
                    <td class="alr-meta-value">
                        <t t-if="o.contact_number_2">
                            <span t-field="o.contact_number_2"/>
                        </t>
                        <t t-else="">
                            <t t-esc="o.partner_id.phone or ''"/>
                        </t>
                    </td>
                </tr>
            </table>

            <!-- ══ SUMMARY TABLE (simple: Item No | Description | Total) ══ -->
            <div class="alr-section-header">SUMMARY / ملخص</div>

            <table class="alr-summary-table">
                <thead>
                    <tr>
                        <th style="width:40px; text-align:center;">Item No.<br/>رقم البند</th>
                        <th style="text-align:left;">Description / الوصف</th>
                        <th style="width:100px; text-align:right;">Total Price<br/>الإجمالي</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-set="sum_counter" t-value="0"/>
                    <t t-foreach="o.summary_line_ids" t-as="sline">
                        <t t-set="sum_counter" t-value="sum_counter + 1"/>
                        <tr>
                            <td class="text-center font-bold">
                                <t t-if="sline.item_no"><t t-esc="sline.item_no"/></t>
                                <t t-else=""><t t-esc="sum_counter"/></t>
                            </td>
                            <td><t t-esc="sline.name"/></td>
                            <td class="text-right num">
                                <t t-esc="'{:,.2f}'.format(sline.total)"/>
                                &#160;<t t-esc="o.currency_id.symbol or ''"/>
                            </td>
                        </tr>
                    </t>
                </tbody>
                <tfoot>
                    <tr class="alr-summary-total">
                        <td colspan="2" class="font-bold" style="text-align:right; padding:6px 10px;">
                            SUB TOTAL / المجموع الفرعي
                        </td>
                        <td class="text-right num" style="padding:6px 10px;">
                            <span t-field="o.amount_untaxed"
                                  t-options='{"widget":"monetary","display_currency":o.currency_id}'/>
                        </td>
                    </tr>
                    <tr class="alr-summary-vat">
                        <td colspan="2" style="text-align:right; padding:6px 10px;">
                            VAT / ضريبة القيمة المضافة (15%)
                        </td>
                        <td class="text-right num" style="padding:6px 10px;">
                            <span t-field="o.amount_tax"
                                  t-options='{"widget":"monetary","display_currency":o.currency_id}'/>
                        </td>
                    </tr>
                    <tr class="alr-summary-grand">
                        <td colspan="2" style="text-align:right; padding:8px 10px;">
                            GRAND TOTAL / المجموع الإجمالي
                        </td>
                        <td class="text-right num" style="padding:8px 10px; font-size:11pt;">
                            <span t-field="o.amount_total"
                                  t-options='{"widget":"monetary","display_currency":o.currency_id}'/>
                        </td>
                    </tr>
                </tfoot>
            </table>

            <!-- ══ PAYMENT TERMS TABLE ══ -->
            <div class="mt-10">
                <table style="width:100%; border-collapse:collapse; font-size:9pt;">
                    <thead>
                        <tr>
                            <th colspan="2" style="background-color:#5c3317; color:#fff;
                                                   padding:6px 10px; text-align:center;
                                                   font-size:10pt; letter-spacing:0.5px;">
                                PAYMENT TERMS / شروط الدفع
                                <t t-if="o.payment_term_id">
                                    — <t t-esc="o.payment_term_id.name"/>
                                </t>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-if="o.note">
                            <tr>
                                <td colspan="2" style="border:1px solid #d9c9b0; padding:8px 12px; color:#2c2c2c;">
                                    <t t-out="o.note"/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>

            <!-- ══ DELIVERY TERMS ══ -->
            <div class="mt-10" style="font-size:9pt;">
                <span style="font-weight:700; color:#5c3317;">
                    DELIVERY TERMS / شروط التسليم:
                </span>
                <t t-if="o.delivery_terms">
                    <span t-field="o.delivery_terms"/>
                </t>
                <t t-else="">3 Months / 3 أشهر</t>
            </div>

            <!-- ══ TERMS AND CONDITIONS ══ -->
            <t t-if="o.terms_conditions">
                <div class="alr-terms mt-10">
                    <div class="alr-terms-title">TERMS AND CONDITIONS / الشروط والأحكام</div>
                    <t t-foreach="o.terms_conditions.split('\n')" t-as="tc_line">
                        <div style="font-size:9pt; padding:1px 0;"><t t-esc="tc_line"/></div>
                    </t>
                </div>
            </t>

            <!-- ══ REPORT NOTES ══ -->
            <t t-if="o.report_notes">
                <div class="alr-notes-box">
                    NOTES: <span t-field="o.report_notes"/>
                </div>
            </t>

            <!-- ══ SIGNATURE ROW ══ -->
            <table class="alr-sig-table">
                <tr>
                    <td>
                        <span class="alr-sig-name">&#160;</span>
                        <div class="alr-sig-line">Sr. Estimator / مسؤول التسعير</div>
                    </td>
                    <td>
                        <span class="alr-sig-name">&#160;</span>
                        <div class="alr-sig-line">Technical Manager / المدير الفني</div>
                    </td>
                    <td>
                        <span class="alr-sig-name">&#160;</span>
                        <div class="alr-sig-line">General Manager / المدير العام</div>
                    </td>
                    <td>
                        <span class="alr-sig-name">&#160;</span>
                        <div class="alr-sig-line">Approved by Client / تمت الموافقة من قبل العميل</div>
                    </td>
                </tr>
            </table>

        </div><!-- end summary page -->


        <!-- ══════════════════════════════════════════════════════
             PAGE 2 - FULL DETAIL TABLE (all order lines, 9 columns)
        ══════════════════════════════════════════════════════ -->
        <div class="page alramlaa-page" style="page-break-before: always;">

            <!-- HEADER -->
            <table style="width:100%; border-bottom:3px solid #b5651d; padding-bottom:8px; margin-bottom:10px;">
                <tr>
                    <td style="width:50%; vertical-align:middle;">
                        <t t-if="o.company_id.logo">
                            <img t-att-src="image_data_uri(o.company_id.logo)"
                                 class="alr-logo" alt="Logo"/>
                        </t>
                    </td>
                    <td style="width:50%; text-align:right; vertical-align:middle;">
                        <div class="alr-company-name-ar"><t t-esc="o.company_id.name"/></div>
                        <div class="alr-company-name-en">Al Ramlaa Wooden Products</div>
                    </td>
                </tr>
            </table>

            <!-- PROJECT INFO BAR -->
            <table style="width:100%; background:#f5ede0; border:1px solid #c8a97e;
                          border-collapse:collapse; font-size:9pt; margin-bottom:8px;">
                <tr>
                    <td style="padding:4px 10px; font-weight:700; color:#5c3317; width:50%;">
                        PROJECT: <span t-esc="o.partner_id.name"/>
                    </td>
                    <td style="padding:4px 10px; font-weight:700; color:#5c3317; text-align:right;">
                        REF: <span t-field="o.name"/>
                        &#160;&#160; DATE: <span t-field="o.date_order" t-options='{"widget":"date"}'/>
                    </td>
                </tr>
            </table>

            <!-- DETAIL TITLE -->
            <div class="alr-section-header">DETAIL SCHEDULE / جدول التفاصيل</div>

            <!-- FULL 9-COLUMN TABLE -->
            <table class="alr-detail-table">
                <thead>
                    <tr>
                        <th class="td-no">Item No.<br/>رقم البند</th>
                        <th class="td-img">Image<br/>صورة</th>
                        <th class="td-desc">Description<br/>الوصف</th>
                        <th class="td-dim">Dimensions WxDxH<br/>الأبعاد</th>
                        <th class="td-mat">Key Materials &amp; Finish<br/>المواد والتشطيب</th>
                        <th class="td-unit">UOM<br/>الوحدة</th>
                        <th class="td-qty">QTY<br/>الكمية</th>
                        <th class="td-uprice">Unit Price<br/>سعر الوحدة</th>
                        <th class="td-tprice">Total Price<br/>الإجمالي</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-set="det_counter" t-value="0"/>
                    <t t-foreach="o.order_line" t-as="line">

                        <!-- Section header row -->
                        <t t-if="line.display_type == 'line_section'">
                            <tr>
                                <td colspan="9" class="alr-section-sub">
                                    <span t-field="line.name"/>
                                </td>
                            </tr>
                        </t>

                        <!-- Note row -->
                        <t t-elif="line.display_type == 'line_note'">
                            <tr>
                                <td colspan="9" style="font-style:italic; color:#666; font-size:8pt; padding:3px 8px;">
                                    <span t-field="line.name"/>
                                </td>
                            </tr>
                        </t>

                        <!-- Product row -->
                        <t t-else="">
                            <t t-set="det_counter" t-value="det_counter + 1"/>
                            <tr style="page-break-inside:avoid;">

                                <!-- Item No -->
                                <td class="td-no">
                                    <t t-if="line.item_no"><span t-field="line.item_no"/></t>
                                    <t t-else=""><t t-esc="det_counter"/></t>
                                </td>

                                <!-- Image -->
                                <td class="td-img">
                                    <t t-if="line.product_id.image_128">
                                        <img t-att-src="image_data_uri(line.product_id.image_128)"
                                             style="max-width:70px; max-height:70px; object-fit:contain;"/>
                                    </t>
                                    <t t-else="">
                                        <div style="width:70px; height:40px; background:#f0f0f0;
                                                    text-align:center; line-height:40px;
                                                    font-size:7pt; color:#bbb;">—</div>
                                    </t>
                                </td>

                                <!-- Description -->
                                <td class="td-desc">
                                    <strong><t t-esc="line.product_id.name or line.name or ''"/></strong>
                                    <t t-if="line.name and line.name != line.product_id.name">
                                        <br/><small style="color:#666; font-size:7.5pt;"><span t-field="line.name"/></small>
                                    </t>
                                </td>

                                <!-- Dimensions -->
                                <td class="td-dim">
                                    <t t-if="line.dimensions">
                                        <span t-field="line.dimensions"/>
                                    </t>
                                    <t t-else=""><span style="color:#bbb;">—</span></t>
                                </td>

                                <!-- Key Materials -->
                                <td class="td-mat" style="font-size:7.5pt; white-space:pre-wrap;">
                                    <t t-if="line.key_materials">
                                        <span t-field="line.key_materials"/>
                                    </t>
                                    <t t-else=""><span style="color:#bbb;">—</span></t>
                                </td>

                                <!-- UOM -->
                                <td class="td-unit text-center">
                                    <t t-esc="line.product_uom_id.name or ''"/>
                                </td>

                                <!-- QTY -->
                                <td class="td-qty text-center">
                                    <span t-field="line.product_uom_qty"
                                          t-options='{"widget":"float","precision":0}'/>
                                </td>

                                <!-- Unit Price -->
                                <td class="td-uprice num">
                                    <span t-field="line.price_unit"
                                          t-options='{"widget":"monetary","display_currency":o.currency_id}'/>
                                </td>

                                <!-- Total Price -->
                                <td class="td-tprice num">
                                    <span t-field="line.price_subtotal"
                                          t-options='{"widget":"monetary","display_currency":o.currency_id}'/>
                                </td>

                            </tr>
                        </t>
                    </t>
                </tbody>
                <tfoot>
                    <tr class="alr-summary-total">
                        <td colspan="8" class="font-bold" style="text-align:right; padding:6px 10px;">
                            SUB TOTAL / المجموع الفرعي
                        </td>
                        <td class="text-right num" style="padding:6px 10px;">
                            <span t-field="o.amount_untaxed"
                                  t-options='{"widget":"monetary","display_currency":o.currency_id}'/>
                        </td>
                    </tr>
                    <tr class="alr-summary-vat">
