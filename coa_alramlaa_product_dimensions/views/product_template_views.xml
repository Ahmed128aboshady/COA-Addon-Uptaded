<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_dimensions" model="ir.ui.view">
        <field name="name">product.template.form.dimensions</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='internal_notes']" position="before">
                <group string="Dimensions / الأبعاد" name="group_dimensions">
                    <group>
                        <field name="dimension_length"/>
                        <field name="dimension_width"/>
                        <field name="dimension_thickness"/>
                    </group>
                    <group>
                        <field name="square_meter"/>
                        <field name="cubic_meter"/>
                        <field name="liter_capacity"/>
                        <field name="total_liters"/>
                        <field name="waste_percentage"/>
                        <field name="product_color"/>
                        <field name="expiry_date"/>
                        <field name="country_of_origin"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
    <record id="product_template_tree_dimensions" model="ir.ui.view">
        <field name="name">product.template.tree.dimensions</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='uom_id']" position="after">
                <field name="dimension_length" string="Length (mm)" optional="hide"/>
                <field name="dimension_width" string="Width (mm)" optional="hide"/>
                <field name="dimension_thickness" string="Thickness (mm)" optional="hide"/>
                <field name="square_meter" optional="hide"/>
                <field name="cubic_meter" optional="hide"/>
                <field name="liter_capacity" string="Liter Capacity / سعة اللتر" optional="hide"/>
                <field name="total_liters" string="Total Liters / إجمالي اللترات" optional="hide"/>
                <field name="waste_percentage" string="Waste %" optional="hide"/>
                <field name="product_color" string="Color / اللون" optional="hide"/>
                <field name="expiry_date" string="Expiry Date" optional="hide"/>
                <field name="country_of_origin" string="Country of Origin" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
