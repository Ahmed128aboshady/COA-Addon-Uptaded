        <record id="stock_picking_location_rule" model="ir.rule">
            <field name="name">Stock Picking Location Rule</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="domain_force">['|',('location_id', 'in', user.stock_location_ids.ids), ('location_dest_id', 'in', user.stock_location_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('group_restrict_warehouse'))]"/>
            <field name="perm_read" eval="True"/>
