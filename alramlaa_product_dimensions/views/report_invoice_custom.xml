<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="custom_tax_invoice_template">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="web.basic_layout">
                        <div class="page" style="font-family: 'Arial', sans-serif; font-size: 12px; color: black; line-height: 1.2;">
                            
                            <div class="row" style="margin-bottom: 20px;">
                                <div class="col-6 text-left">
                                    <h3 style="margin:0; font-weight: bold;">Alramlaa Furniture Company</h3>
                                    <p style="margin:0;">شركة الرملة للأثاث</p>
                                </div>
                                <div class="col-6 text-right">
                                    <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)" style="max-height: 100px;"/>
                                </div>
                            </div>

                            <div class="text-center" style="margin-bottom: 20px;">
                                <div style="display: inline-block; border: 2px solid black; padding: 10px 40px; background-color: #f2f2f2; font-weight: bold; font-size: 16px;">
                                    VAT Invoice No / <span t-field="o.name"/> / فاتورة ضريبية رقم
                                </div>
                            </div>

                            <div class="row" style="margin-bottom: 10px;">
                                <div class="col-6" style="padding-right: 5px;">
                                    <table style="width: 100%; border-collapse: collapse; border: 1px solid black;">
                                        <tr><td style="border: 1px solid black; padding: 5px; width: 40%; font-weight: bold; background-color: #f9f9f9;">Cus. Name : اسم العميل</td><td style="border: 1px solid black; padding: 5px;"><span t-field="o.partner_id.name"/></td></tr>
                                        <tr><td style="border: 1px solid black; padding: 5px; font-weight: bold; background-color: #f9f9f9;">Cus . ID : رقم العميل</td><td style="border: 1px solid black; padding: 5px;"><span t-field="o.partner_id.ref"/></td></tr>
                                        <tr><td style="border: 1px solid black; padding: 5px; font-weight: bold; background-color: #f9f9f9;">CUS. VAT NO : الرقم الضريبى</td><td style="border: 1px solid black; padding: 5px;"><span t-field="o.partner_id.vat"/></td></tr>
                                        <tr><td style="border: 1px solid black; padding: 5px; font-weight: bold; background-color: #f9f9f9;">Customer Phone : الجوال</td><td style="border: 1px solid black; padding: 5px;"><span t-field="o.partner_id.phone"/></td></tr>
                                        <tr><td style="border: 1px solid black; padding: 5px; font-weight: bold; background-color: #f9f9f9;">Project NO : رقم المشروع</td><td style="border: 1px solid black; padding: 5px;"><span t-field="o.custom_project_number"/></td></tr>
                                    </table>
                                </div>
                                <div class="col-6" style="padding-left: 5px;">
                                    <table style="width: 100%; border-collapse: collapse; border: 1px solid black;" dir="rtl">
                                        <tr><td style="border: 1px solid black; padding: 5px; width: 45%; font-weight: bold; background-color: #f9f9f9;">تاريخ الفاتورة / DATE</td><td style="border: 1px solid black; padding: 5px; text-align: center;"><span t-field="o.invoice_date"/></td></tr>
                                        <tr><td style="border: 1px solid black; padding: 5px; font-weight: bold; background-color: #f9f9f9;">تاريخ الاستحقاق / DUE DATE</td><td style="border: 1px solid black; padding: 5px; text-align: center;"><span t-field="o.invoice_date_due"/></td></tr>
                                        <tr><td style="border: 1px solid black; padding: 5px; font-weight: bold; background-color: #f9f9f9;">رقم أمر البيع / ORDER NO</td><td style="border: 1px solid black; padding: 5px; text-align: center;"><span t-field="o.invoice_origin"/></td></tr>
                                        <tr><td style="border: 1px solid black; padding: 5px; font-weight: bold; background-color: #f9f9f9;">رمز المستودع / SITE CODE</td><td style="border: 1px solid black; padding: 5px; text-align: center;"><span t-field="o.custom_site_code"/></td></tr>
                                        <tr><td style="border: 1px solid black; padding: 5px; font-weight: bold; background-color: #f9f9f9;">اسم المشروع / Project Name</td><td style="border: 1px solid black; padding: 5px; text-align: center;"><span t-field="o.custom_project_name"/></td></tr>
                                    </table>
                                </div>
                            </div>

                            <table style="width: 100%; border-collapse: collapse; margin-top: 10px; border: 2px solid black; text-align: center; font-size: 11px;">
                                <thead style="background-color: #e9ecef; font-weight: bold;">
                                    <tr>
                                        <th style="border: 1px solid black; padding: 5px;">رقم الصنف<br/>Item Number</th>
                                        <th style="border: 1px solid black; padding: 5px;">اسم الصنف<br/>Item Name</th>
                                        <th style="border: 1px solid black; padding: 5px;">الوصف<br/>Description</th>
                                        <th style="border: 1px solid black; padding: 5px;">الكمية<br/>QTY</th>
                                        <th style="border: 1px solid black; padding: 5px;">سعر الوحدة<br/>Price</th>
                                        <th style="border: 1px solid black; padding: 5px;">الإجمالي قبل الضريبة<br/>Ext. Price</th>
                                        <th style="border: 1px solid black; padding: 5px;">الضريبة %<br/>VAT %</th>
                                        <th style="border: 1px solid black; padding: 5px;">قيمة الضريبة<br/>VAT Amt</th>
                                        <th style="border: 1px solid black; padding: 5px; background-color: #dee2e6;">الإجمالي<br/>Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="o.invoice_line_ids.filtered(lambda l: not l.display_type)" t-as="line">
                                        <tr>
                                            <td style="border: 1px solid black; padding: 5px;"><span t-field="line.product_id.default_code"/></td>
                                            <td style="border: 1px solid black; padding: 5px;"><span t-field="line.product_id.name"/></td>
                                            <td style="border: 1px solid black; padding: 5px;"><span t-field="line.name"/></td>
                                            <td style="border: 1px solid black; padding: 5px;"><span t-field="line.quantity"/></td>
                                            <td style="border: 1px solid black; padding: 5px;"><span t-field="line.price_unit"/></td>
                                            <td style="border: 1px solid black; padding: 5px;"><span t-field="line.price_subtotal"/></td>
                                            <td style="border: 1px solid black; padding: 5px;"><span t-esc="', '.join(map(lambda x: str(x.amount), line.tax_ids))"/>%</td>
                                            <td style="border: 1px solid black; padding: 5px;"><span t-esc="line.price_total - line.price_subtotal" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                                            <td style="border: 1px solid black; padding: 5px; font-weight: bold; background-color: #f8f9fa;"><span t-field="line.price_total"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>

                            <div class="row mt-4">
                                <div class="col-7" style="border: 1px solid black; padding: 10px; font-size: 10px;">
                                    <strong>Notes / ملاحظات:</strong><br/>
                                    <span t-field="o.narration"/>
                                </div>
                                <div class="col-5">
                                    <table style="width: 100%; border-collapse: collapse; border: 1px solid black;">
                                        <tr><td style="border: 1px solid black; padding: 5px; background-color: #f2f2f2;">Subtotal / الإجمالي قبل الضريبة</td><td style="border: 1px solid black; padding: 5px; text-align: center;"><span t-field="o.amount_untaxed"/></td></tr>
                                        <tr><td style="border: 1px solid black; padding: 5px; background-color: #f2f2f2;">VAT / الضريبة</td><td style="border: 1px solid black; padding: 5px; text-align: center;"><span t-field="o.amount_tax"/></td></tr>
                                        <tr style="font-size: 14px; font-weight: bold; background-color: #dee2e6;"><td style="border: 1px solid black; padding: 5px;">Total / الإجمالي النهائي</td><td style="border: 1px solid black; padding: 5px; text-align: center;"><span t-field="o.amount_total"/></td></tr>
                                    </table>
                                </div>
                            </div>

                        </div>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>