<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_product_stock_list_inherit_dimensions" model="ir.ui.view">
        <field name="name">product.product.stock.list.inherit.dimensions</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="stock.product_product_stock_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='qty_available']" position="after">
                <field name="square_meter_stock"/>
                <field name="cubic_meter_stock"/>
                <field name="total_liters" string="Total Liters / إجمالي اللترات"/>
            </xpath>
        </field>
    </record>

    <record id="view_picking_form_inherit_dimensions" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.dimensions</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='operations']//field[@name='product_id']" position="after">
                <field name="square_meter" optional="show"/>
                <field name="cubic_meter" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_stock_quant_tree_inherit_dimensions" model="ir.ui.view">
        <field name="name">stock.quant.tree.inherit.dimensions</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_editable"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="square_meter" optional="show"/>
                <field name="cubic_meter" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_location_list_inherit_dimensions" model="ir.ui.view">
        <field name="name">stock.location.list.inherit.dimensions</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="stock.view_location_tree2"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="square_meter" optional="show"/>
                <field name="cubic_meter" optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>