<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View for the Report - Grouped by Product -->
    <record id="view_reserved_stock_move_list" model="ir.ui.view">
        <field name="name">reserved.stock.move.list</field>
        <field name="model">stock.move</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list string="Reserved Products" create="false" edit="false">
                <field name="product_id"/>
                <field name="actual_reserved_qty" string="Reserved Qty"/>
                <field name="product_qty" string="Demand Qty"/>
                <field name="picking_id" string="Delivery Order"/>
                <field name="sale_line_id" string="Sale Order"/>
                <button name="action_un_reserve" string="Un Reserve" type="object" class="btn-danger"/>
            </list>
        </field>
    </record>

    <!-- Report Action: Reserved Products in Sales Orders -->
    <record id="action_reserved_report" model="ir.actions.act_window">
        <field name="name">Reserved Products in Sales</field>
        <field name="res_model">stock.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_reserved_stock_move_list"/>
        <field name="domain">[('sale_line_id', '!=', False), ('picking_id.picking_type_id.code', '=', 'outgoing'), ('state', 'not in', ['done', 'cancel'])]</field>
        <field name="context">{'group_by': 'product_id'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No reserved products found.
            </p>
        </field>
    </record>

    <!-- Menu Item for the Report -->
    <menuitem id="menu_reserved_report" name="Reserved Products"
                parent="sale.menu_sale_report"
                action="action_reserved_report"
                sequence="25">
    </menuitem>
</odoo>
