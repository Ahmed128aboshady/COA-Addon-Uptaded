<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_petty_cash_config_settings" model="ir.ui.view">
        <field name="name">petty.cash.config.settings</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Petty Cash" string="Petty Cash"
                     name="petty_cash">

                    <!-- ── Accounting ── -->
                    <block title="Accounting Accounts" name="petty_cash_accounts">
                        <setting string="Petty Cash Account"
                                 help="Debit account when granting custody to employee">
                            <div class="content-group">
                                <div class="row mt16">
                                    <field name="petty_cash_account_id" class="col-lg-6"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Default Cash/Bank Account"
                                 help="Default cash/bank account for custody payments - can be changed per custody">
                            <div class="content-group">
                                <div class="row mt16">
                                    <field name="petty_cash_payment_account_id" class="col-lg-6"/>
                                </div>
                            </div>
                        </setting>
                    </block>

                    <!-- ── Approval Settings ── -->
                    <block title="Approval Settings" name="petty_cash_approval">
                        <setting string="Manager Approval for Large Custodies"
                                 help="Enable this option to require manager approval for custodies exceeding a limit">
                            <field name="petty_cash_require_manager_approval"/>
                            <div class="content-group"
                                 invisible="not petty_cash_require_manager_approval">
                                <div class="row mt16">
                                    <label for="petty_cash_manager_approval_limit"
                                           class="col-lg-4 o_light_label"/>
                                    <field name="petty_cash_manager_approval_limit"
                                           class="col-lg-3"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Default Custody Approver"
                                 help="User who receives custody approval notifications">
                            <div class="content-group">
                                <div class="row mt16">
                                    <field name="petty_cash_custody_approver_id" class="col-lg-6"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Default Expense Approver"
                                 help="User who receives expense approval notifications">
                            <div class="content-group">
                                <div class="row mt16">
                                    <field name="petty_cash_expense_approver_id" class="col-lg-6"/>
                                </div>
                            </div>
                        </setting>
                    </block>

                </app>
            </xpath>
        </field>
    </record>

</odoo>
