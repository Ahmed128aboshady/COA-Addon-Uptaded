<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View -->
    <record id="view_petty_cash_category_form" model="ir.ui.view">
        <field name="name">petty.cash.category.form</field>
        <field name="model">petty.cash.category</field>
        <field name="arch" type="xml">
            <form string="Expense Category">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_expenses"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-list">
                            <field name="expense_count" widget="statinfo"
                                   string="Approved Expenses"/>
                        </button>
                    </div>
                    <group>
                        <group string="Category Details">
                            <field name="name"/>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group string="Accounting Link">
                            <field name="account_id"/>
                            <field name="analytic_account_id"/>
                            <field name="total_amount"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Category description..."/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_petty_cash_category_list" model="ir.ui.view">
        <field name="name">petty.cash.category.list</field>
        <field name="model">petty.cash.category</field>
        <field name="arch" type="xml">
            <list string="Expense Categories" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="account_id"/>
                <field name="analytic_account_id" optional="show"/>
                <field name="expense_count"/>
                <field name="total_amount"/>
                <field name="active" optional="show"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_petty_cash_category" model="ir.actions.act_window">
        <field name="name">Expense Categories</field>
        <field name="res_model">petty.cash.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first expense category!
            </p>
            <p>
                Each category links to an expense account in the chart of accounts.
                When an expense is approved, the journal entry is created automatically.
            </p>
        </field>
    </record>

</odoo>
