<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View -->
    <record id="view_petty_cash_approver_form" model="ir.ui.view">
        <field name="name">petty.cash.approver.form</field>
        <field name="model">petty.cash.approver</field>
        <field name="arch" type="xml">
            <form string="Petty Cash Approver">
                <sheet>
                    <group>
                        <group string="Approver Details">
                            <field name="level"
                                help="Level 1 approves first, then 2, then 3, etc."/>
                            <field name="sequence"/>
                            <field name="name"/>
                            <field name="approval_type"/>
                            <field name="active"/>
                        </group>
                        <group string="Approvers">
                            <field name="user_ids" widget="many2many_tags"
                                   options="{'no_create': True}"
                                   nolabel="1" colspan="2"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Notes..."/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_petty_cash_approver_list" model="ir.ui.view">
        <field name="name">petty.cash.approver.list</field>
        <field name="model">petty.cash.approver</field>
        <field name="arch" type="xml">
            <list string="Approvers" editable="bottom">
                <field name="level" string="Level"/>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="approval_type"/>
                <field name="user_ids" widget="many2many_tags"
                       options="{'no_create': True}"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_petty_cash_approver" model="ir.actions.act_window">
        <field name="name">Approver Settings</field>
        <field name="res_model">petty.cash.approver</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add approval levels for custodies and expenses
            </p>
            <p>
                Level 1 approves first, then Level 2, and so on.
                Multiple users can be in the same level (any of them can approve).
            </p>
        </field>
    </record>

</odoo>
