<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View -->
    <record id="view_petty_cash_expense_form" model="ir.ui.view">
        <field name="name">petty.cash.expense.form</field>
        <field name="model">petty.cash.expense</field>
        <field name="arch" type="xml">
            <form string="Petty Cash Expense">
                <header>
                    <button name="action_submit" string="Submit for Approval" type="object"
                        class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve &amp; Post Entry" type="object"
                        class="oe_highlight"
                        invisible="state != 'submitted'"
                        groups="petty_cash.group_petty_cash_accountant"/>
                    <button name="action_reject" string="Reject" type="object"
                        invisible="state != 'submitted'"
                        groups="petty_cash.group_petty_cash_accountant"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object"
                        invisible="state not in ['submitted', 'rejected']"
                        groups="petty_cash.group_petty_cash_accountant"/>
                    <field name="state" widget="statusbar"
                        statusbar_visible="draft,submitted,approved"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_journal_entry" type="object"
                                class="oe_stat_button" icon="fa-book"
                                invisible="not move_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Journal Entry</span>
                                <span class="o_stat_value">
                                    <field name="move_state"/>
                                </span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Expense Details">
                            <field name="custody_id" readonly="state != 'draft'"/>
                            <field name="employee_id" readonly="1"/>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="description" readonly="state != 'draft'"/>
                            <field name="amount" readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Category &amp; Accounts">
                            <field name="category_id" readonly="state != 'draft'"/>
                            <field name="account_id" readonly="1"/>
                            <field name="analytic_distribution"
                                widget="analytic_distribution"
                                readonly="state != 'draft'"
                                optional="show"/>
                        </group>
                    </group>
                    <group string="Receipt">
                        <field name="receipt" widget="image"
                            readonly="state != 'draft'"
                            optional="show"/>
                    </group>
                    <field name="notes" placeholder="Additional notes..."
                        readonly="state != 'draft'"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_petty_cash_expense_list" model="ir.ui.view">
        <field name="name">petty.cash.expense.list</field>
        <field name="model">petty.cash.expense</field>
        <field name="arch" type="xml">
            <list string="Petty Cash Expenses"
                decoration-success="state == 'approved'"
                decoration-danger="state == 'rejected'"
                decoration-warning="state == 'submitted'">
                <field name="name"/>
                <field name="employee_id" groups="petty_cash.group_petty_cash_accountant"/>
                <field name="custody_id"/>
                <field name="date"/>
                <field name="category_id"/>
                <field name="description"/>
                <field name="amount"/>
                <field name="account_id" optional="show"/>
                <field name="move_id" optional="show"
                    groups="petty_cash.group_petty_cash_accountant"/>
                <field name="state" widget="badge"
                    decoration-success="state == 'approved'"
                    decoration-danger="state == 'rejected'"
                    decoration-warning="state == 'submitted'"
                    decoration-muted="state == 'draft'"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_petty_cash_expense_search" model="ir.ui.view">
        <field name="name">petty.cash.expense.search</field>
        <field name="model">petty.cash.expense</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="description"/>
                <field name="employee_id" groups="petty_cash.group_petty_cash_accountant"/>
                <field name="category_id"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="submitted" string="Submitted" domain="[('state','=','submitted')]"/>
                <filter name="approved" string="Approved" domain="[('state','=','approved')]"/>
                <filter name="rejected" string="Rejected" domain="[('state','=','rejected')]"/>
                <separator/>
                <filter name="my_expenses" string="My Expenses" domain="[('user_id','=',uid)]"/>
                <separator/>
                <filter name="group_employee" string="Employee"
                    context="{'group_by': 'employee_id'}"
                    groups="petty_cash.group_petty_cash_accountant"/>
                <filter name="group_category" string="Category"
                    context="{'group_by': 'category_id'}"/>
                <filter name="group_state" string="Status"
                    context="{'group_by': 'state'}"/>
                <filter name="group_account" string="Account"
                    context="{'group_by': 'account_id'}"
                    groups="petty_cash.group_petty_cash_accountant"/>
            </search>
        </field>
    </record>

    <!-- Action Employee -->
    <record id="action_petty_cash_expense" model="ir.actions.act_window">
        <field name="name">Petty Cash Expenses</field>
        <field name="res_model">petty.cash.expense</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_petty_cash_expense_search"/>
        <field name="context">{'search_default_my_expenses': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Record your first expense!</p>
        </field>
    </record>

    <!-- Action Accountant - All -->
    <record id="action_petty_cash_expense_all" model="ir.actions.act_window">
        <field name="name">All Expenses</field>
        <field name="res_model">petty.cash.expense</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_petty_cash_expense_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No expenses yet.</p>
        </field>
    </record>

    <!-- Action Pending Approval -->
    <record id="action_petty_cash_expense_pending" model="ir.actions.act_window">
        <field name="name">Expenses Pending Approval</field>
        <field name="res_model">petty.cash.expense</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'submitted')]</field>
        <field name="search_view_id" ref="view_petty_cash_expense_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No pending expenses.</p>
        </field>
    </record>

</odoo>
