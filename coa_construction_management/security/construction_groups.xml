<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="construction_category" model="ir.module.category">
        <field name="name">Construction</field>
    </record>
    <record id="group_construction_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="arabian_construction_management.construction_category"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
    <record id="group_construction_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="arabian_construction_management.construction_category"/>
        <field name="implied_ids" eval="[(6, 0, [ref('arabian_construction_management.group_construction_user')])]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
