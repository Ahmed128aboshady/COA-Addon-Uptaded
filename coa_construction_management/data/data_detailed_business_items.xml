            <field name="business_items_types_id" ref="business_finishing_works"/>
            <field name="description">Installing tiles or marble for floors and walls.</field>
        </record>
        <record id="data_wooden_works" model="detailed.business.items">
            <field name="name">Wooden works</field>
            <field name="business_items_types_id" ref="business_finishing_works"/>
            <field name="description">Installing doors and windows.</field>
        </record>
        <record id="data_glass_aluminum" model="detailed.business.items">
            <field name="name">Glass and aluminum</field>
            <field name="business_items_types_id" ref="business_finishing_works"/>
            <field name="description">Installing aluminum and glass windows and doors.</field>
        </record>
        <record id="data_air_conditioning_systems" model="detailed.business.items">
            <field name="name">Air conditioning systems</field>
            <field name="business_items_types_id" ref="business_mechanical_works"/>
            <field name="description">Installing heating, ventilation and air conditioning (HVAC) systems.</field>
        </record>
        <record id="data_other_mechanical_systems" model="detailed.business.items">
