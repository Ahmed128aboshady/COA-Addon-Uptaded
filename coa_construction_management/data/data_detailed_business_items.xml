        </record>
        <record id="data_rafting" model="detailed.business.items">
            <field name="name">Rafting</field>
            <field name="business_items_types_id" ref="business_concrete_works"/>
            <field name="description">pouring concrete slab or mat for large buildings.</field>
        </record>
        <record id="data_construction_of_walls" model="detailed.business.items">
