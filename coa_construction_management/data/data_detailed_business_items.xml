        </record>
        <record id="site_marking" model="detailed.business.items">
            <field name="name">Site marking</field>
            <field name="business_items_types_id" ref="business_preparatory_works"/>
            <field name="description">marking the site and its boundaries.</field>
        </record>
        <record id="trenching" model="detailed.business.items">
