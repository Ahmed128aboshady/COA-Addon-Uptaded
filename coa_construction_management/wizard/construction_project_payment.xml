<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="construction_project_payment_form" model="ir.ui.view">
        <field name="name">construction.project.payment.form</field>
        <field name="model">construction.project.payment</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="payment_type" widget="radio"
                                   options="{'vertical': True}"
                                   required="type == 'normal_payment'"
                                   invisible="type != 'normal_payment'"/>
                            <field name="type" required="1"/>
                            <field name="partner_id" invisible="type == 'expense'"/>
                            <field name="amount" invisible="type == 'expense'"/>
                            <field name="currency_id"/>

                            <field name="beneficiary_name"
                                   invisible="type != 'letter_of_guarantee'"/>
                            <field name="beneficiary_address"
                                   invisible="type != 'letter_of_guarantee'"/>
                            <field name="memo"
                                   invisible="type != 'normal_payment'"/>
                            <field name="beneficiary"
                                   invisible="type != 'cheque'"/>
                            <field name="description"
                                   invisible="type != 'cheque'"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="company_id"/>
                            <field name="expiry_date"
                                   invisible="type != 'letter_of_guarantee'"/>
                            <field name="journal_id"
                                   required="type not in ['normal_payment','expense']"
                                   invisible="type not in ['normal_payment','expense']"/>
                            <field name="guarantee_for"
                                   invisible="type != 'letter_of_guarantee'"
                                   required="type == 'letter_of_guarantee'"/>
                            <field name="cheque_type"
                                   invisible="type != 'cheque'"
                                   required="type == 'cheque'"/>
                            <field name="cheque_number"
                                   invisible="type != 'cheque'"
                                   required="type == 'cheque'"/>
                            <field name="description"
                                   placeholder="LG Bid Bond Purpose..."
                                   invisible="type != 'letter_of_guarantee'"/>


                        </group>

                    </group>
                    <notebook invisible="type != 'letter_of_guarantee'">
                        <page string="Guarantee Details">
                            <field name="guarantee_details"
                                   placeholder="Details..."/>
                        </page>
                    </notebook>
                    <notebook invisible="type != 'expense'">
                        <page string="Expense Details">
                            <field name="construction_expense_line_ids">               <!-- add  context="{'default_field' : field}" to set default value -->
                                <list editable="bottom">
                                    <field name="construction_project_payment_id"
                                           column_invisible="1"/>       <!-- add  domain="[('id','=',parent.field)]" to set default domain -->
                                    <field name="product_id"/>
                                    <field name="memo"/>
                                    <field name="account_id"/>
                                    <field name="employee_id"/>
                                    <field name="partner_id"/>
                                    <field name="analytic_distribution"
                                           widget="analytic_distribution"
                                           groups="analytic.group_analytic_accounting"
                                           optional="hide"
                                    force_save="1"/>
                                    <field name="tax_ids"
                                           widget="many2many_tags"
                                           domain="[('type_tax_use','=','purchase')]"
                                           context="{'default_type_tax_use': 'purchase', 'search_view_ref': 'account.account_tax_view_search'}"
                                           options="{'no_create': True}"
                                           optional="show"/>
                                    <field name="currency_id" optional="hide"/>
                                    <field name="tax_amount" optional="hide"/>
                                    <field name="amount"/>
                                    <field name="tax_included" optional="hide"/>
                                    <field name="price_after_tax"
                                           optional="hide"/>

                                </list>
                            </field>
                        </page>
                    </notebook>
                    <footer>
                        <button name="confirm" type="object" string="Confirm"
                                class="oe_highlight"/>
                        <button string="Cancel" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window"
            id="construction_project_payment_action">
        <field name="name">construction project payment</field>
        <field name="res_model">construction.project.payment</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
