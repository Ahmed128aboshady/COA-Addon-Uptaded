<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="contracting_project_classification_form" model="ir.ui.view">
        <field name="name">contracting.project.classification.form</field>
        <field name="model">contracting.project.classification</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name" required="1"/>
                            <field name="description"/>

                        </group>
                        <group>
                            <field name="active"/>
                            <field name="color" invisible="1"/>
                        </group>

                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="contracting_project_classification_tree" model="ir.ui.view">
        <field name="name">contracting.project.classification.tree</field>
        <field name="model">contracting.project.classification</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="description"/>
                <field name="active"/>
            </list>
        </field>
    </record>


    <record id="contracting_project_classification_action" model="ir.actions.act_window">
        <field name="name">Contracting Project Classification</field>
        <field name="res_model">contracting.project.classification</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Contracting Project Classification
            </p>
        </field>

    </record>
</odoo>
