<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <record id="construction_project_form" model="ir.ui.view">
        <field name="name">construction.project.form</field>
        <field name="model">construction.project</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="confirm" type="object" string="Confirm"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="create_payment_request" type="object"
                            string="Payment Request" class="oe_highlight"
                            invisible="state in ['draft','cancelled']"/>
                    <button name="create_business_items" type="object"
                            string="Create Business Items" class="oe_highlight"
                            invisible="state != 'confirmed'"/>
                    <button name="start_project" type="object"
                            string="Start Project" class="oe_highlight"
                            invisible="state !='assay_approved'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,assay_approved,cancelled"
                           options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <button name="action_view_all_construction_business_items"
                                type="object" class="oe_stat_button"
                                icon="fa-pencil-square-o"
                                invisible="count_construction_business_items == 0">
                            <field name="count_construction_business_items"
                                   widget="statinfo" string="Business Items"/>
                        </button>
                        <button name="action_view_all_construction_project"
                                type="object" class="oe_stat_button"
                                icon="fa-pencil-square-o"
                                invisible="count_project == 0">
                            <field name="count_project" widget="statinfo"
                                   string="Project"/>
                        </button>
                        <button name="action_view_all_account_payment"
                                type="object" class="oe_stat_button"
                                icon="fa-pencil-square-o"
                                invisible="count_payment == 0">
                            <field name="count_payment" widget="statinfo"
                                   string="Payment"/>
                        </button>

                        <button name="action_view_all_expense_payment"
                                type="object" class="oe_stat_button"
                                icon="fa-pencil-square-o"
                                invisible="count_expense_payment == 0">
                            <field name="count_expense_payment" widget="statinfo"
                                   string="Expense"/>
                        </button>
                        <button name="action_view_all_incoming_cheque"
                                type="object" class="oe_stat_button"
                                icon="fa-pencil-square-o"
                                invisible="incoming_cheque_count == 0">
                            <field name="incoming_cheque_count" widget="statinfo"
                                   string="Incoming Cheque"/>
                        </button>

                        <button name="action_view_all_outgoing_cheque"
                                type="object" class="oe_stat_button"
                                icon="fa-pencil-square-o"
                                invisible="outgoing_cheque_count == 0">
                            <field name="outgoing_cheque_count" widget="statinfo"
                                   string="Outgoing Cheque"/>
                        </button>
                        <button name="action_view_all_bid_bond"
                                type="object" class="oe_stat_button"
                                icon="fa-pencil-square-o"
                                invisible="count_bid_bond == 0">
                            <field name="count_bid_bond" widget="statinfo"
                                   string="Bid Bond"/>
                        </button>
                        <button name="action_view_related_so"
                                type="object" class="oe_stat_button"
                                icon="fa-pencil-square-o" string="Sale Order"
                                invisible="sale == False">

                        </button>


                    </div>


                    <div class="oe_title">
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <group string="Basic project information:">
                            <field name="contract_type" required="1"/>
                            <field name="tender_no"
                                   invisible="contract_type != 'tender'"
                                   required="contract_type == 'tender'"/>
                            <field name="other_contract_type"
                                   invisible="contract_type != 'other'"
                                   required="contract_type == 'other'"/>
                            <field name="project_name" required="1"/>
                            <field name="project_number" required="1"/>
                            <field name="project_description"/>
                            <field name="project_type_id"/>
                            <field name="partner_id" required="1"/>
                            <field name="project_location"/>
                            <field name="business_items_created" invisible="1"/>
                            <field name="sale_id" invisible="1"/>
                            <field name="sale" invisible="1"/>
                            <field name="site_area"/>

                        </group>
                        <group string="Dates:">
                            <field name="project_start_date"/>
                            <field name="expected_completion_date"/>
                            <field name="project_duration"/>
                        </group>
                        <group string="Budget and costs:">
                            <field name="boq_cost_estimation_id"/>
                            <field name="analytic_account_id"/>
                            <field name="currency_id"/>
                            <field name="total_budget"/>
                            <field name="expected_cost_project"/>
                            <field name="current_costs_to_date"/>
                            <field name="percentage_financial_achievement"
                                   invisible="1"/>
                            <field name="allocated_costs_materials"
                                   invisible="1"/>
                            <field name="labor_costs" invisible="1"/>
                            <field name="equipment_costs" invisible="1"/>
                            <field name="project_contract_journal_id"
                                   required="state in ['assay_approved','project_in_progress']"/>
                            <field name="project_contract_account_id"
                                   required="state in ['assay_approved','project_in_progress']"/>
                            <field name="terms_account_id" invisible="1"/>
                        </group>
                        <group string="Work team and contractors:">
                            <field name="employee_id"/>
                            <field name="main_contractor_id"/>
                            <field name="subcontractors_ids"
                                   widget="many2many_tags"
                                   options="{'color_field': 'color'}"/>
                        </group>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <record id="construction_project_sequence" model="ir.sequence">
        <field name="name">construction.project</field>
        <field name="code">construction.project</field>
        <field name="prefix">CONS-PRO/</field>
        <field name="padding">5</field>
        <field name="number_increment">1</field>
    </record>

    <record id="construction_project_tree" model="ir.ui.view">
        <field name="name">construction.project.tree</field>
        <field name="model">construction.project</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="project_name"/>
                <field name="project_number"/>
                <field name="project_description"/>
                <field name="project_type_id"/>
            </list>
        </field>
    </record>


    <record id="construction_project_action" model="ir.actions.act_window">
        <field name="name">Construction Project</field>
        <field name="res_model">construction.project</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Construction Project
            </p>
        </field>
    </record>
</odoo>
