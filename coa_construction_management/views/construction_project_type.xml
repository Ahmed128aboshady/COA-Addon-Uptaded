<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="construction_project_type_form" model="ir.ui.view">
        <field name="name">construction.project.type.form</field>
        <field name="model">construction.project.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name" required="1"/>
                            <field name="contracting_project_classification_id"/>
                            <field name="description"/>

                        </group>
                        <group>
                            <field name="active"/>
                            <field name="color" invisible="1"/>
                        </group>

                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="construction_project_type_tree" model="ir.ui.view">
        <field name="name">construction.project.type.tree</field>
        <field name="model">construction.project.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="contracting_project_classification_id"/>
                <field name="description"/>
                <field name="active"/>
            </list>
        </field>
    </record>


    <record id="construction_project_type_action" model="ir.actions.act_window">
        <field name="name">Construction Project Type</field>
        <field name="res_model">construction.project.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="business_items_types_action">
                Construction Project Type
            </p>
        </field>
    </record>
</odoo>
