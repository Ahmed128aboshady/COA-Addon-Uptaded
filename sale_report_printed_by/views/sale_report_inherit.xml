<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_saleorder_document_inherit"
              inherit_id="sale.report_saleorder_document">
        <xpath expr="//div[@t-if='doc.user_id.name']" position="after">
            <div class="col">
                <strong>Printed By</strong>
                <div t-esc="user.name"/>
            </div>
        </xpath>
    </template>
</odoo>
