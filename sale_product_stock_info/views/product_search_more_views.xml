<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!--
            Override الـ product.product list view
            عشان يظهر الكميات في شاشة Search More
        -->
        <record id="product_product_tree_sale_stock" model="ir.ui.view">
            <field name="name">product.product.tree.sale.stock</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="product.product_product_tree_view"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='default_code']" position="after">
                    <field name="sale_qty_on_hand_display"
                           string="في المخزن"
                           optional="show"
                           readonly="1"/>
                    <field name="sale_qty_available_display"
                           string="المتاح للبيع"
                           optional="show"
                           readonly="1"/>
                </xpath>

            </field>
        </record>

        <!--
            Override product.template list view برده
            عشان لو الـ Search More بيفتح على product.template
        -->
        <record id="product_template_tree_sale_stock" model="ir.ui.view">
            <field name="name">product.template.tree.sale.stock</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_tree_view"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='default_code']" position="after">
                    <field name="sale_qty_on_hand_display"
                           string="في المخزن"
                           optional="show"
                           readonly="1"/>
                    <field name="sale_qty_available_display"
                           string="المتاح للبيع"
                           optional="show"
                           readonly="1"/>
                </xpath>

            </field>
        </record>

    </data>
</odoo>
