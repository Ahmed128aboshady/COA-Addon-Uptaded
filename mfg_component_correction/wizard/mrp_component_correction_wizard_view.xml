<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mrp_component_correction_wizard_form" model="ir.ui.view">
        <field name="name">mrp.component.correction.wizard.form</field>
        <field name="model">mrp.component.correction.wizard</field>
        <field name="arch" type="xml">
            <form string="تصحيح كميات المكونات">
                <sheet>
                    <div class="oe_title">
                        <h1>تصحيح مكونات أمر التصنيع</h1>
                        <h3>
                            <field name="production_id" readonly="1"/>
                        </h3>
                    </div>

                    <div class="alert alert-warning" role="alert">
                        <strong>تنبيه:</strong>
                        أدخل الكمية الفعلية المستخدمة لكل مكون.
                        سيتم إرجاع الفارق تلقائياً للمخزن وتصحيح التكلفة.
                    </div>

                    <field name="line_ids">
                        <list editable="bottom" decoration-warning="diff_qty > 0" decoration-muted="diff_qty == 0">
                            <field name="product_id" readonly="1"/>
                            <field name="product_uom_id" readonly="1" optional="show"/>
                            <field name="consumed_qty" readonly="1" string="مصروف"/>
                            <field name="corrected_qty" string="فعلي مستخدم"/>
                            <field name="diff_qty" readonly="1" string="يُرجع للمخزن"/>
                            <field name="location_src_id" readonly="1" optional="hide"/>
                            <field name="move_id" readonly="1" optional="hide"/>
                        </list>
                    </field>
                </sheet>

                <footer>
                    <button
                        name="action_confirm_correction"
                        string="تأكيد التصحيح"
                        type="object"
                        class="btn-primary"
                        data-hotkey="q"
                    />
                    <button string="إلغاء" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
