<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mrp_production_component_correction_btn" model="ir.ui.view">
        <field name="name">mrp.production.component.correction.button</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">

            <!-- إضافة الزرار في header بعد حالة Done فقط -->
            <xpath expr="//header/button[last()]" position="after">
                <button
                    name="action_open_component_correction"
                    string="تصحيح المكونات"
                    type="object"
                    class="btn-warning"
                    invisible="state != 'done'"
                    icon="fa-wrench"
                />
            </xpath>

        </field>
    </record>

</odoo>
