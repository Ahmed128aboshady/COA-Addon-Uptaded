<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="business_items_types_form" model="ir.ui.view">
        <field name="name">business.items.types.form</field>
        <field name="model">business.items.types</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name" required="1"/>
                            <field name="description"/>

                        </group>
                        <group>
                            <field name="active"/>
                            <field name="color" invisible="1"/>
                        </group>

                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="business_items_types_action" model="ir.actions.act_window">
        <field name="name">Business Items Types</field>
        <field name="res_model">business.items.types</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Business Items Types
            </p>
        </field>

    </record>
</odoo>
