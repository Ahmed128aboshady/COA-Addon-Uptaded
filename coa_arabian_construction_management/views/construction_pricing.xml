<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="construction_pricing_form" model="ir.ui.view">
        <field name="name">construction.pricing.form</field>
        <field name="model">construction.pricing</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="description"/>
                        </group>
                        <group>

                            <field name="date"/>
                        </group>

                    </group>
                    <notebook>
                        <page string="Line">
                            <field name="construction_pricing_line_ids">               <!-- add  context="{'default_field' : field}" to set default value -->
                                <list editable="bottom">
                                    <field name="construction_pricing_id" column_invisible="True"/>       <!-- add  domain="[('id','=',parent.field)]" to set default domain -->
                                    <field name="product_id"/>
                                    <field name="uom_id"/>
                                    <field name="quantity"/>
                                </list>
                            </field>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <record id="construction_pricing_sequence" model="ir.sequence">
        <field name="name">construction.pricing</field>
        <field name="code">construction.pricing</field>
        <field name="prefix">Pricing/</field>
        <field name="padding">5</field>
        <field name="number_increment">1</field>
    </record>

    <record id="construction_pricing_action" model="ir.actions.act_window">
        <field name="name">Pricing</field>
        <field name="res_model">construction.pricing</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Pricing
            </p>
        </field>
    </record>
</odoo>
