<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_quant_relocate_view_form_inherit_partial_qty" model="ir.ui.view">
        <field name="name">stock.quant.relocate.form.inherit.partial.qty</field>
        <field name="model">stock.quant.relocate</field>
        <field name="inherit_id" ref="stock.stock_quant_relocate_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group" position="after">
                <field name="line_ids" nolabel="1" colspan="2">
                    <list editable="bottom" no_open="1">
                        <field name="quant_id" column_invisible="1"/>
                        <field name="product_id" readonly="1" force_save="1"/>
                        <field name="location_id" readonly="1" force_save="1"/>
                        <field name="lot_id" readonly="1" force_save="1"
                               groups="stock.group_production_lot" optional="show"/>
                        <field name="package_id" readonly="1" force_save="1"
                               groups="stock.group_tracking_lot" optional="hide"/>
                        <field name="available_qty" readonly="1"/>
                        <field name="reserved_qty" readonly="1"/>
                        <field name="free_qty" readonly="1" string="Available to Move"/>
                        <field name="qty_to_relocate" readonly="0"/>
                        <field name="product_uom_id" readonly="1" force_save="1"
                               groups="uom.group_uom"/>
                    </list>
                </field>
            </xpath>
        </field>
    </record>
</odoo>
