<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ① Define the new permission group -->
    <record id="group_sale_price_edit" model="res.groups">
        <field name="name">Can Edit Sale Prices</field>
<!-- Admin always has it -->
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <!-- ② Sales Manager automatically gets price-edit rights (correct direction) -->
    <record id="sales_team.group_sale_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_sale_price_edit'))]"/>
    </record>

</odoo>
