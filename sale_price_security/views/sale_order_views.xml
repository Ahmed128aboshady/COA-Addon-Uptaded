<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_price_edit" model="ir.ui.view">
        <field name="name">sale.order.form.price.edit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='order_line']/form//field[@name='price_unit']" position="before">
                <field name="price_edit_readonly" invisible="1"/>
            </xpath>

            <xpath expr="//field[@name='order_line']/form//field[@name='price_unit']" position="attributes">
                <attribute name="readonly">price_edit_readonly</attribute>
            </xpath>

            <xpath expr="//field[@name='order_line']/list//field[@name='price_unit']" position="before">
                <field name="price_edit_readonly" column_invisible="True"/>
            </xpath>

            <xpath expr="//field[@name='order_line']/list//field[@name='price_unit']" position="attributes">
                <attribute name="readonly">qty_invoiced &gt; 0 or price_edit_readonly</attribute>
            </xpath>

        </field>
    </record>

</odoo>