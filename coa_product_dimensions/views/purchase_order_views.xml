<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_inherit_dimensions" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.dimensions</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='product_qty']" position="after">
                <field name="dimension_length"/>
                <field name="dimension_width"/>
                <field name="dimension_thickness"/>
                <field name="square_meter_total" readonly="1"/>
                <field name="cubic_meter_total" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>