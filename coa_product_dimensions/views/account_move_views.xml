<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <record id="view_move_form_inherit_project_info" model="ir.ui.view">
        <field name="name">account.move.form.inherit.project.info</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="custom_project_name" invisible="move_type not in ('out_invoice', 'out_refund', 'out_receipt')"/>
                <field name="custom_project_number" invisible="move_type not in ('out_invoice', 'out_refund', 'out_receipt')"/>
            </xpath>
        </field>
    </record>

    <record id="view_move_form_inherit_discount_amount" model="ir.ui.view">
        <field name="name">account.move.form.inherit.discount.amount</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']//field[@name='discount']" position="after">
                <field name="discount_amount" optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>