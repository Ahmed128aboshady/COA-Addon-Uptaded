<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_asset_form_custom" model="ir.ui.view">
        <field name="name">account.asset.form.custom</field>
        <field name="model">account.asset</field>
        <field name="arch" type="xml">
            <form string="Asset">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="category_id"/>
                        <field name="linked_asset_ids" widget="many2many_tags"/>
                    </group>
                    <group string="Purchase Information">
                        <field name="purchase_date"/>
                        <field name="purchase_price"/>
                        <field name="asset_code"/>
                    </group>
                    <group string="Dimensions">
                        <field name="dimension_length"/>
                        <field name="dimension_width"/>
                        <field name="dimension_thickness"/>
                        <field name="square_meter" readonly="1"/>
                        <field name="cubic_meter" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_account_asset_tree_custom" model="ir.ui.view">
        <field name="name">account.asset.list.custom</field>
        <field name="model">account.asset</field>
        <field name="arch" type="xml">
            <list string="Assets">
                <field name="name"/>
                <field name="category_id"/>
                <field name="asset_code"/>
            </list>
        </field>
    </record>

    <record id="action_asset_category" model="ir.actions.act_window">
        <field name="name">Asset Categories</field>
        <field name="res_model">asset.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_asset_category"
        name="Asset Categories"
        parent="account.menu_finance_configuration"
        action="action_asset_category"/>
        
</odoo>