<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_production_form_inherit_dimensions" model="ir.ui.view">
        <field name="name">mrp.production.form.inherit.dimensions</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_raw_ids']/list/field[@name='product_uom_qty']" position="after">
                <field name="dimension_length"/>
                <field name="dimension_width"/>
                <field name="dimension_thickness"/>
                <field name="square_meter"/>
                <field name="cubic_meter"/>
            </xpath>
        </field>
    </record>

    <record id="mrp_bom_form_view_inherit_dimensions" model="ir.ui.view">
        <field name="name">mrp.bom.form.inherit.dimensions</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='bom_line_ids']/list/field[@name='product_qty']" position="before">
                <field name="dimension_length"/>
                <field name="dimension_width"/>
                <field name="dimension_thickness"/>
                <field name="square_meter"/>
                <field name="cubic_meter"/>
            </xpath>
        </field>
    </record>
</odoo>