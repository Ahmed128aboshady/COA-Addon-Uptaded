<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_technical_review_reject_wizard_form" model="ir.ui.view">
        <field name="name">technical.review.reject.wizard.form</field>
        <field name="model">technical.review.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Technical Review">
                <sheet>
                    <group>
                        <field name="review_id" readonly="True"/>
                    </group>
                    <group>
                        <field name="rejection_reason"
                               nolabel="1"
                               placeholder="Explain what needs to be corrected before re-submission…"
                               required="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm_reject"
                            string="Confirm Rejection"
                            type="object"
                            class="btn-danger"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
