<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════
         Sale Order PDF
    ══════════════════════════════════════════════════════ -->
    <template id="report_saleorder_reserved_location"
              inherit_id="sale.report_saleorder_document">

        <!-- Header -->
        <xpath expr="//th[hasclass('text-end')][last()]" position="before">
            <th class="text-start" style="white-space:nowrap;">
                <span>Source Location</span>
            </th>
        </xpath>

        <!-- Data cell per line -->
        <xpath expr="//td[hasclass('text-end')][last()]" position="before">
            <td class="text-start" style="font-size:90%; color:#555;">
                <span t-if="line.reserved_location_stored"
                      style="white-space:pre-line;"
                      t-esc="line.reserved_location_stored"/>
            </td>
        </xpath>

    </template>

    <!-- ══════════════════════════════════════════════════════
         Delivery Slip PDF — جدول state != done
    ══════════════════════════════════════════════════════ -->
    <template id="report_delivery_reserved_location"
              inherit_id="stock.report_delivery_document">

        <!-- Header للـ moves (state != done) -->
        <xpath expr="//table[@name='stock_move_table']/thead/tr/th[@name='th_sm_quantity']" position="before">
            <th name="th_sm_location" class="text-start" style="white-space:nowrap;">
                <strong>Source Location</strong>
            </th>
        </xpath>

        <!-- Data cell للـ moves (state != done): قبل td الـ Delivered quantity -->
        <xpath expr="//table[@name='stock_move_table']//tbody/tr/td/span[@t-field='move.quantity']/.." position="before">
            <td class="text-start" style="font-size:90%; color:#555; white-space:pre-line;">
                <span t-if="move.reserved_location_detail"
                      t-esc="move.reserved_location_detail"/>
            </td>
        </xpath>

        <!-- Header للـ move lines (state == done) -->
        <xpath expr="//table[@name='stock_move_line_table']/thead/tr/th[@name='th_sml_quantity']" position="before">
            <th name="th_sml_location" class="text-start" style="white-space:nowrap;">
                <strong>Source Location</strong>
            </th>
        </xpath>

    </template>

    <!-- ══════════════════════════════════════════════════════
         Delivery Slip — aggregated lines (state == done, بدون serial)
    ══════════════════════════════════════════════════════ -->
    <template id="report_delivery_aggregated_location"
              inherit_id="stock.stock_report_delivery_aggregated_move_lines">

        <xpath expr="//td[@name='move_line_aggregated_quantity']" position="before">
            <td class="text-start" style="font-size:90%; color:#555; white-space:pre-line;">
                <span t-esc="o._get_product_location_detail(aggregated_lines[line]['product'])"/>
            </td>
        </xpath>

    </template>

    <!-- ══════════════════════════════════════════════════════
         Delivery Slip — serial/lot lines (state == done, مع serial)
    ══════════════════════════════════════════════════════ -->
    <template id="report_delivery_serial_location"
              inherit_id="stock.stock_report_delivery_has_serial_move_line">

        <xpath expr="//td[@name='move_line_lot_quantity']" position="before">
            <td class="text-start" style="font-size:90%; color:#555; white-space:pre-line;">
                <span t-esc="move_line.location_id.complete_name"/>
            </td>
        </xpath>

    </template>

    <!-- ══════════════════════════════════════════════════════
         Invoice PDF
    ══════════════════════════════════════════════════════ -->
    <template id="report_invoice_reserved_location"
              inherit_id="account.report_invoice_document">

        <!-- Header -->
        <xpath expr="//th[hasclass('text-end')][last()]" position="before">
            <th class="text-start" style="white-space:nowrap;">
                <span>Source Location</span>
            </th>
        </xpath>

        <!-- Data cell per line -->
        <xpath expr="//td[hasclass('text-end')][last()]" position="before">
            <td class="text-start" style="font-size:90%; color:#555;">
                <span t-if="line.stock_location_detail"
                      style="white-space:pre-line;"
                      t-esc="line.stock_location_detail"/>
            </td>
        </xpath>

    </template>

</odoo>
