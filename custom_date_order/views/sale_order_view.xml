<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_order_form_inherit_custom_date_sale" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.custom.date</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//label[@for='date_order']" position="replace"/>

            <xpath expr="//field[@name='date_order']" position="replace">
                <field name="order_date_only"  invisible="state in ['sale', 'cancel']" readonly="state in ['cancel', 'sale']" />
            </xpath>

        </field>
    </record>
</odoo>