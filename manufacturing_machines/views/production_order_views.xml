<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_mfg_production_form" model="ir.ui.view">
        <field name="name">mfg.production.order.form</field>
        <field name="model">mfg.production.order</field>
        <field name="arch" type="xml">
            <form string="Production Order">
                <header>
                    <button name="action_confirm" string="Confirm" type="object"
                        class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_start" string="Start Production" type="object"
                        class="btn-warning" invisible="state != 'confirmed'"/>
                    <button name="action_done" string="Done" type="object"
                        class="btn-success" invisible="state != 'in_progress'"/>
                    <button name="action_cancel" string="Cancel" type="object"
                        class="btn-danger" invisible="state in ['done','cancelled']"/>
                    <button name="action_post_accounting" string="Post Accounting" type="object"
                        class="btn-primary"
                        invisible="state != 'done' or account_posted"/>
                    <field name="state" widget="statusbar"
                        statusbar_visible="draft,confirmed,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Order Details">
                            <field name="machine_id"/>
                            <field name="product_name"/>
                            <field name="quantity"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="planned_hours"/>
                        </group>
                        <group string="Cost Summary">
                            <field name="actual_hours" readonly="1"/>
                            <field name="machine_cost" readonly="1"/>
                            <field name="total_labor_cost" readonly="1"/>
                            <field name="total_overhead" readonly="1"/>
                            <field name="total_cost" readonly="1" class="fw-bold"/>
                            <field name="cost_per_unit" readonly="1"/>
                        </group>
                    </group>
                    <group string="Accounting" invisible="not account_posted">
                        <field name="move_id" readonly="1"/>
                        <field name="journal_id"/>
                    </group>
                    <notebook>
                        <page string="Machines">
                            <field name="machine_line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="machine_id"/>
                                    <field name="machine_hourly_cost" readonly="1"/>
                                    <field name="state" widget="badge"/>
                                    <field name="date_start" readonly="1"/>
                                    <field name="date_end" readonly="1"/>
                                    <field name="duration" readonly="1" sum="Total Hours"/>
                                    <field name="cost" readonly="1" sum="Total Cost"/>
                                    <button name="button_start" string="▶ Start" type="object"
                                        class="btn-sm btn-success"
                                        invisible="state != 'draft' and state != 'paused'"/>
                                    <button name="button_pause" string="⏸" type="object"
                                        class="btn-sm btn-warning"
                                        invisible="state != 'running'"/>
                                    <button name="button_resume" string="▶" type="object"
                                        class="btn-sm btn-info"
                                        invisible="state != 'paused'"/>
                                    <button name="button_done" string="✔ Done" type="object"
                                        class="btn-sm btn-primary"
                                        invisible="state == 'done' or state == 'draft'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Workers">
                            <field name="labor_lines">
                                <list editable="bottom">
                                    <field name="employee_name"/>
                                    <field name="job_title"/>
                                    <field name="hours"/>
                                    <field name="hourly_rate"/>
                                    <field name="total_cost" readonly="1" sum="Total"/>
                                </list>
                            </field>
                        </page>
                        <page string="Overhead Costs">
                            <field name="overhead_lines">
                                <list editable="bottom">
                                    <field name="overhead_type"/>
                                    <field name="name"/>
                                    <field name="amount" sum="Total"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_mfg_production_list" model="ir.ui.view">
        <field name="name">mfg.production.order.list</field>
        <field name="model">mfg.production.order</field>
        <field name="arch" type="xml">
            <list string="Production Orders">
                <field name="name"/>
                <field name="machine_id"/>
                <field name="product_name"/>
                <field name="quantity"/>
                <field name="state" widget="badge"/>
                <field name="actual_hours"/>
                <field name="total_labor_cost"/>
                <field name="machine_cost"/>
                <field name="total_overhead"/>
                <field name="total_cost" sum="Total Costs"/>
                <field name="cost_per_unit"/>
                <field name="account_posted" widget="boolean"/>
            </list>
        </field>
    </record>

    <!-- Search -->
    <record id="view_mfg_production_search" model="ir.ui.view">
        <field name="name">mfg.production.order.search</field>
        <field name="model">mfg.production.order</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="machine_id"/>
                <field name="product_name"/>
                <filter string="In Progress" name="in_progress" domain="[('state','=','in_progress')]"/>
                <filter string="Done" name="done" domain="[('state','=','done')]"/>
                <filter string="Not Posted" name="not_posted" domain="[('state','=','done'),('account_posted','=',False)]"/>
                <group>
                    <filter name="group_machine" string="Machine" context="{'group_by': 'machine_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_mfg_production" model="ir.actions.act_window">
        <field name="name">Production Orders</field>
        <field name="res_model">mfg.production.order</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_mfg_production_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add your first production order!
            </p>
        </field>
    </record>
</odoo>
