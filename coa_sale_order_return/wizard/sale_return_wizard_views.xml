<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sale_return_wizard_form" model="ir.ui.view">
        <field name="name">sale.return.wizard.form</field>
        <field name="model">sale.return.wizard</field>
        <field name="arch" type="xml">
            <form string="Return Products">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="sale_id" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="reason"
                                   placeholder="Reason for return (optional)…"/>
                        </group>
                        <group>
                            <field name="create_credit_note" widget="boolean_toggle"/>
                        </group>
                    </group>

                    <field name="line_ids" widget="one2many">
                        <list editable="bottom" decoration-muted="quantity == 0">
                            <field name="picking_id" readonly="1" optional="hide"/>
                            <field name="product_id" readonly="1"/>
                            <field name="uom_id"     readonly="1" optional="show"/>
                            <field name="max_qty"    readonly="1" string="Delivered Qty"/>
                            <field name="quantity"   string="Return Qty"/>
                            <field name="to_refund"  string="To Refund"/>
                        </list>
                    </field>

                    <div class="text-muted mt-2">
                        <i class="fa fa-info-circle"/>
                        Set quantity to <b>0</b> to exclude a product from the return.
                    </div>
                </sheet>

                <footer>
                    <button name="action_confirm" string="Return" type="object"
                            class="btn-primary"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
