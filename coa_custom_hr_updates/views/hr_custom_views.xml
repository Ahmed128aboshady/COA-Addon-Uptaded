<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_unit_list" model="ir.ui.view">
        <field name="name">hr.unit.list</field>
        <field name="model">hr.unit</field>
        <field name="arch" type="xml">
            <list> 
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_hr_unit_form" model="ir.ui.view">
        <field name="name">hr.unit.form</field>
        <field name="model">hr.unit</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_unit" model="ir.actions.act_window">
        <field name="name">Units</field>
        <field name="res_model">hr.unit</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_hr_unit" 
              name="Units" 
              parent="hr.menu_human_resources_configuration" 
              action="action_hr_unit" 
              sequence="5"/>

    <record id="view_department_form_inherit_unit" model="ir.ui.view">
        <field name="name">hr.department.form.inherit.unit</field>
        <field name="model">hr.department</field>
        <field name="inherit_id" ref="hr.view_department_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='parent_id']" position="after">
                <field name="unit_id"/>
            </xpath>
        </field>
    </record>

    <record id="view_hr_job_form_inherit_unit" model="ir.ui.view">
        <field name="name">hr.job.form.inherit.unit</field>
        <field name="model">hr.job</field>
        <field name="inherit_id" ref="hr.view_hr_job_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='department_id']" position="after">
                <field name="parent_department_id" readonly="1"/>
                <field name="unit_id" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_employee_form_inherit_custom" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.custom</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='department_id']" position="after">
                <field name="emp_code"/>
                <field name="parent_department_id" readonly="1"/>
                <field name="unit_id" readonly="1"/>
                <field name="kafala_status"/>
                <field name="sponsor_name" invisible="kafala_status != 'inside'"/>
            </xpath>
        </field>
    </record>
</odoo>