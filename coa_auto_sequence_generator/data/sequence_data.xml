<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

<record id="seq_customer_code" model="ir.sequence">
            <field name="name">Customer Code</field>
            <field name="code">res.partner.customer</field>
            <field name="prefix">CUST-</field>
            <field name="padding">7</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_vendor_code" model="ir.sequence">
            <field name="name">Vendor Code</field>
            <field name="code">res.partner.vendor</field>
            <field name="prefix">VEND-</field>
            <field name="padding">7</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_partner_code" model="ir.sequence">
            <field name="name">Partner Code</field>
            <field name="code">res.partner</field>
            <field name="prefix">PART-</field>
            <field name="padding">7</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
