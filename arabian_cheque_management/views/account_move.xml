<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="inherit_account_move_form" model="ir.ui.view">
        <field name="name">inherit.account.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ref']" position="after">
                <field name="incoming_cheque_id"
                       invisible="incoming_cheque_id != 'False'"/>
                <field name="outgoing_cheque_id"
                       invisible="outgoing_cheque_id != 'False'"/>
            </xpath>
        </field>
    </record>
</odoo>
