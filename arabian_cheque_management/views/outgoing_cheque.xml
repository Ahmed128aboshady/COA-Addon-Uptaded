<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="outgoing_cheque_form" model="ir.ui.view">
        <field name="name">outgoing.cheque.form</field>
        <field name="model">outgoing.cheque</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="confirm" type="object" string="Confirm"
                            class="oe_highlight"
                            invisible="state not in 'draft'"/>
                    <button name="cheque_settlement" type="object"
                            string="Cheque Settlement" class="oe_highlight"
                            invisible="state not in 'confirmed'"/>
                    <button name="cancel" type="object" string="Cancel"
                            class="oe_highlight"
                            invisible="state not in 'confirmed'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,cheque_settlement,cancelled"/>
                </header>
                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <button name="action_view_all_account_move_line"
                                type="object" class="oe_stat_button"
                                icon="fa-pencil-square-o">
                            <field name="count_move_line" widget="statinfo"
                                   string="Journal Items"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                        <br/>
                        <h3>
                            <field name="description"
                                   placeholder="Cheque Description"/>
                        </h3>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="cheque_number" required="1"/>
                            <field name="amount"/>
                            <field name="currency_id"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="journal_id"/>
                            <field name="notes_payable_account_id"/>
                            <field name="beneficiary"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="outgoing_cheque_tree" model="ir.ui.view">
        <field name="name">outgoing.cheque.tree</field>
        <field name="model">outgoing.cheque</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="cheque_number" required="1"/>
                <field name="amount"/>
                <field name="currency_id"/>
                <field name="date"/>
                <field name="journal_id"/>
                <field name="notes_payable_account_id"/>
                <field name="beneficiary"/>
            </list>
        </field>
    </record>

    <record id="outgoing_cheque_sequence" model="ir.sequence">
        <field name="name">outgoing.cheque</field>
        <field name="code">outgoing.cheque</field>
        <field name="prefix">Cheque-OUT/</field>
        <field name="padding">5</field>
        <field name="number_increment">1</field>
    </record>


    <record id="outgoing_cheque_action" model="ir.actions.act_window">
        <field name="name">Outgoing Cheque</field>
        <field name="res_model">outgoing.cheque</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Outgoing Cheque
            </p>
        </field>
    </record>
</odoo>
