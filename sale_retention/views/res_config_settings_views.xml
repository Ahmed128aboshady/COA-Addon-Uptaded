<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_retention" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.retention</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Customer Retention" name="retention_setting_block">
                    <setting string="Retention Receivable Account"
                             help="Dedicated receivable account where retained amounts are held until maturity.">
                        <field name="retention_account_id"/>
                    </setting>
                    <setting string="Default Retention Terms"
                             help="Proposed on every new sales order; adjustable per order/contract.">
                        <div class="content-group">
                            <div class="row mt8">
                                <label for="retention_default_percent" class="col-lg-4 o_light_label"/>
                                <field name="retention_default_percent" class="col-lg-2"/>
                            </div>
                            <div class="row">
                                <label for="retention_default_period_days" class="col-lg-4 o_light_label"/>
                                <field name="retention_default_period_days" class="col-lg-2"/>
                            </div>
                            <div class="row">
                                <label for="retention_default_base" class="col-lg-4 o_light_label"/>
                                <field name="retention_default_base" class="col-lg-4"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
