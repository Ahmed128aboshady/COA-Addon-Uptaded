<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_retention" model="ir.ui.view">
        <field name="name">sale.order.form.retention</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <field name="payment_term_id" position="after">
                <field name="retention_percent"/>
                <field name="retention_base"
                       invisible="retention_percent == 0"/>
                <field name="retention_period_days"
                       invisible="retention_percent == 0"/>
                <field name="retention_amount"
                       invisible="retention_percent == 0"/>
            </field>
        </field>
    </record>
</odoo>
