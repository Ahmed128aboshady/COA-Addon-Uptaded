<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_open_retention_lines_server" model="ir.actions.server">
        <field name="name">Retention Receivables</field>
        <field name="model_id" ref="account.model_account_move_line"/>
        <field name="state">code</field>
        <field name="code">action = env.company.action_open_retention_lines()</field>
