<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit Invoice Report to add Partner Balance Section -->
    <template id="report_invoice_document_inherit_balance" inherit_id="account.report_invoice_document">
        <!-- Add partner balance section after the overflow-hidden div (same position as Sale Order) -->
        <xpath expr="//div[@class='overflow-hidden']" position="after">
            <t t-if="o.move_type in ('out_invoice', 'out_refund')">
                <div class="clearfix" name="partner_balance_section">
                    <div id="partner_balance" class="row mt-3" name="partner_balance">
                        <div t-attf-class="#{'col-6' if report_type != 'html' else 'col-sm-7 col-md-6'} ms-auto">
                            <table class="table table-sm table-borderless mb-0" style="border: 1px solid #dee2e6;">
                                <thead style="background-color: #f8f9fa;">
                                    <tr>
                                        <th colspan="2" class="text-center py-2" style="border-bottom: 2px solid #dee2e6;">
                                            <strong>CUSTOMER BALANCE / رصيد العميل</strong>
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <!-- الرصيد السابق -->
                                    <tr>
                                        <td class="text-start py-1">
                                            <span>Previous Balance / الرصيد السابق</span>
                                        </td>
                                        <td class="text-end py-1">
                                            <span t-field="o.partner_previous_balance"
                                                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                    <!-- + الفاتورة الحالية -->
                                    <tr>
                                        <td class="text-start py-1">
                                            <t t-if="o.move_type == 'out_invoice'">
                                                <span>+ Current Invoice / الفاتورة الحالية</span>
                                            </t>
                                            <t t-else="">
                                                <span>- Credit Note / إشعار دائن</span>
                                            </t>
                                        </td>
                                        <td class="text-end py-1">
                                            <span t-field="o.amount_total"
                                                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                    <!-- الرصيد الحالي -->
                                    <tr style="border-top: 2px solid #dee2e6; background-color: #e9ecef;">
                                        <td class="text-start py-2">
                                            <strong>Current Balance / الرصيد الحالي</strong>
                                        </td>
                                        <td class="text-end py-2">
                                            <strong>
                                                <span t-field="o.partner_current_balance"
                                                      t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                            </strong>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </t>
        </xpath>
    </template>

</odoo>
