<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View -->
    <record id="view_coa_production_variance_list" model="ir.ui.view">
        <field name="name">coa.mfg.production.variance.list</field>
        <field name="model">coa.mfg.production.variance</field>
        <field name="arch" type="xml">
            <list string="Production Variance" create="false" edit="false" delete="false"
                  decoration-danger="variance_qty &lt; 0" decoration-success="variance_qty &gt; 0">
                <field name="production_id"/>
                <field name="sale_id" optional="show"/>
                <field name="partner_id" optional="show"/>
                <field name="product_id"/>
                <field name="categ_id" optional="hide"/>
                <field name="user_id" optional="hide" widget="many2one_avatar_user"/>
                <field name="date_start" optional="hide"/>
                <field name="date_finished"/>
                <field name="ordered_qty" sum="Total Ordered"/>
                <field name="planned_qty" sum="Total Planned"/>
                <field name="produced_qty" sum="Total Produced"/>
                <field name="delivered_qty" sum="Total Delivered"/>
                <field name="qty_on_hand" string="On Hand Qty" optional="show" sum="Total On Hand"/>
                <field name="variance_qty" sum="Total Variance"/>
                <field name="variance_percent" widget="percentage" options="{'humanize': false}" digits="[16,2]"/>
                <field name="product_uom_id" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('progress', 'to_close')"
                       decoration-muted="state in ('draft', 'confirmed')"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <button name="action_open_production" type="object" string="Open MO"
                        icon="fa-external-link" class="btn-link"/>
                <button name="action_open_sale_order" type="object" string="Open SO"
                        icon="fa-shopping-cart" class="btn-link"
                        invisible="not sale_id"/>
            </list>
        </field>
    </record>

    <!-- Pivot View -->
    <record id="view_coa_production_variance_pivot" model="ir.ui.view">
        <field name="name">coa.mfg.production.variance.pivot</field>
        <field name="model">coa.mfg.production.variance</field>
        <field name="arch" type="xml">
            <pivot string="Production Variance" sample="1">
                <field name="product_id" type="row"/>
                <field name="date_finished" interval="month" type="col"/>
                <field name="ordered_qty" type="measure"/>
                <field name="planned_qty" type="measure"/>
                <field name="produced_qty" type="measure"/>
                <field name="delivered_qty" type="measure"/>
                <field name="qty_on_hand" type="measure"/>
                <field name="variance_qty" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Graph View -->
    <record id="view_coa_production_variance_graph" model="ir.ui.view">
        <field name="name">coa.mfg.production.variance.graph</field>
        <field name="model">coa.mfg.production.variance</field>
        <field name="arch" type="xml">
            <graph string="Production Variance" type="bar" sample="1" stacked="0">
                <field name="product_id"/>
                <field name="planned_qty" type="measure"/>
                <field name="produced_qty" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_coa_production_variance_search" model="ir.ui.view">
        <field name="name">coa.mfg.production.variance.search</field>
        <field name="model">coa.mfg.production.variance</field>
        <field name="arch" type="xml">
            <search string="Production Variance">
                <field name="production_id"/>
                <field name="sale_id"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="categ_id"/>
                <field name="user_id"/>
                <field name="date_finished"/>
                <separator/>
                <filter string="MTO (Linked to Sale Order)" name="filter_mto"
                        domain="[('sale_id', '!=', False)]"/>
                <separator/>
                <filter string="Done" name="filter_done" domain="[('state', '=', 'done')]"/>
                <filter string="In Progress" name="filter_progress"
                        domain="[('state', 'in', ('progress', 'to_close'))]"/>
                <separator/>
                <filter string="Under-Produced" name="filter_under"
                        domain="[('variance_qty', '&lt;', 0)]"/>
                <filter string="Over-Produced" name="filter_over"
                        domain="[('variance_qty', '&gt;', 0)]"/>
                <filter string="With Variance Only" name="filter_variance"
                        domain="[('variance_qty', '!=', 0)]"/>
                <separator/>
                <filter string="End Date" name="filter_date_finished" date="date_finished"/>
                <group>
                    <filter string="Customer" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Sale Order" name="group_sale" context="{'group_by': 'sale_id'}"/>
                    <filter string="Product" name="group_product" context="{'group_by': 'product_id'}"/>
                    <filter string="Product Category" name="group_categ" context="{'group_by': 'categ_id'}"/>
                    <filter string="Responsible" name="group_user" context="{'group_by': 'user_id'}"/>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="End Date" name="group_date" context="{'group_by': 'date_finished:month'}"/>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_coa_production_variance" model="ir.actions.act_window">
        <field name="name">Production Variance</field>
        <field name="res_model">coa.mfg.production.variance</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="search_view_id" ref="view_coa_production_variance_search"/>
        <field name="context">{'search_default_filter_done': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No manufacturing data yet
            </p>
            <p>
                This report compares the planned quantity against the actually
                produced quantity for each Manufacturing Order.
            </p>
        </field>
    </record>

    <!-- Menu: Manufacturing > Reporting > Production Variance -->
    <menuitem id="menu_coa_production_variance"
              name="Production Variance"
              parent="mrp.menu_mrp_reporting"
              action="action_coa_production_variance"
              sequence="25"/>

</odoo>