<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="action_reset_print_count_sale" model="ir.actions.server">
            <field name="name">Reset Print Count</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="binding_model_id" ref="sale.model_sale_order"/>
            <field name="binding_view_types">list,form</field>
            <field name="state">code</field>
            <field name="code">records.action_coa_reset_print_count()</field>
            <field name="groups_id" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
        </record>

        <record id="action_reset_print_count_picking" model="ir.actions.server">
            <field name="name">Reset Print Count</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="binding_model_id" ref="stock.model_stock_picking"/>
            <field name="binding_view_types">list,form</field>
            <field name="state">code</field>
            <field name="code">records.action_coa_reset_print_count()</field>
            <field name="groups_id" eval="[(4, ref('stock.group_stock_manager'))]"/>
        </record>
    </data>
</odoo>
