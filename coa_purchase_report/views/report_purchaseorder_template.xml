<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="paperformat_purchase" model="report.paperformat">
            <field name="name">A4 Custom Purchase Order</field>
            <field name="default" eval="False"/>
            <field name="format">A4</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">15</field>
            <field name="margin_bottom">20</field>
            <field name="margin_left">18</field>
            <field name="margin_right">18</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">0</field>
        </record>

        <record id="purchase.action_report_purchase_order" model="ir.actions.report">
            <field name="paperformat_id" ref="coa_purchase_report.paperformat_purchase"/>
        </record>
        <record id="purchase.report_purchase_quotation" model="ir.actions.report">
            <field name="paperformat_id" ref="coa_purchase_report.paperformat_purchase"/>
        </record>

        <template id="custom_purchase_layout_base">
            <t t-call="web.basic_layout">
                <div class="page" dir="ltr" style="direction: ltr !important; font-family: 'Cairo', 'Arial', sans-serif !important; color: #333333; font-size: 12.5px;">
                    
                    <style>
                        @import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&amp;display=swap');
                        
                        * { 
                            font-family: 'Cairo', 'Arial', sans-serif !important;
                        }
                        
                        .po-title { color: #2F5597 !important; font-size: 28px !important; font-weight: 700; text-transform: uppercase; line-height: 1; margin-bottom: 8px; }
                        .section-header { background-color: #2F5597 !important; color: white !important; font-weight: 700; padding: 6px 10px; font-size: 11.5px; text-transform: uppercase; text-align: center; border: 1px solid #2F5597 !important; }
                        .table-header { background-color: #2F5597 !important; color: white !important; font-size: 12px; font-weight: 700; text-align: center; }
                        
                        .bordered-table { width: 100% !important; border-collapse: collapse; }
                        .bordered-table th, .bordered-table td { border: 1px solid #2F5597 !important; padding: 7px 9px; vertical-align: middle; font-size: 11.5px; }
                        
                        .gray-box { background-color: #EAEAEA !important; font-weight: 700; font-size: 11.5px; color: #333333; text-align: center;}
                        
                        .address-table { width: 100% !important; border-collapse: collapse; border: 1px solid #2F5597; }
                        .address-table td { padding: 8px 10px; line-height: 1.5; font-size: 11.5px; vertical-align: top; border: none !important; }
                        
                        .totals-table { width: 100% !important; border-collapse: collapse; }
                        .totals-table td { border: 1px solid #2F5597 !important; padding: 7px 10px; font-size: 11.5px; }
                        .totals-table .label-cell { background-color: #EAEAEA !important; font-weight: 700; width: 45%; }
                        .totals-table .val-cell { text-align: right; font-weight: 600; }
                        .totals-table .total-row td { background-color: #2F5597 !important; color: white !important; font-weight: 700; border: 1px solid #2F5597 !important; }
                    </style>

                    <div class="row" style="border-bottom: 3px solid #2F5597; padding-bottom: 10px; margin-top: 5px;">
                        <div class="col-7">
                            <img t-if="o.company_id.logo" 
                                 t-att-src="image_data_uri(o.company_id.logo)" 
                                 style="max-height: 60px; max-width: 220px; display: block; margin: 0 0 8px 0;"/>
                            <div style="font-size: 11px; color: #444444; line-height: 1.6; font-weight: 600; text-align: left; direction: rtl !important; text-align: left !important;">
                                <div style="font-size: 13.5px; font-weight: 700; color: #2F5597; margin-bottom: 2px;">شركة أرفاد الدولية للصناعة</div>
                                <div>ش 118 منطقة الصناعات المساندة الثالثة - الجبيل الصناعية</div>
                                <div>الهاتف: 0133417775</div>
                                <div>الرقم الضريبي: 30104648550000</div>
                            </div>
                        </div>
                        <div class="col-5" style="text-align: right; padding-top: 10px;">
                            <div class="po-title">PURCHASE ORDER</div>
                            <table class="bordered-table" style="width: 190px !important; float: right; margin-bottom: 0;">
                                <tr>
                                    <td class="gray-box" style="padding: 4px; width: 45%;">DATE</td>
                                    <td style="padding: 4px; text-align: center; font-weight: 600;"><span t-field="o.date_order" t-options="{'widget': 'date'}"/></td>
                                </tr>
                                <tr>
                                    <td class="gray-box" style="padding: 4px;">PO #</td>
                                    <td style="padding: 4px; text-align: center; font-weight: 700; color: #2F5597;"><span t-field="o.name"/></td>
                                </tr>
                            </table>
                        </div>
                    </div>

                    <div style="height: 15px; clear: both; display: block;"></div>

                    <div class="row">
                        <div class="col-6" style="padding-right: 8px;">
                            <table class="address-table">
                                <thead>
                                    <tr>
                                        <th class="section-header">VENDOR</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td style="height: 105px;">
                                            <div style="font-weight: 700; color: #2F5597; font-size: 12px; margin-bottom: 3px;"><span t-field="o.partner_id.name"/></div>
                                            <div t-if="o.partner_id.street"><span t-field="o.partner_id.street"/></div>
                                            <div>
                                                <span t-if="o.partner_id.city"><span t-field="o.partner_id.city"/>, </span>
                                                <span t-if="o.partner_id.state_id"><span t-field="o.partner_id.state_id.name"/> </span>
                                                <span t-if="o.partner_id.zip"><span t-field="o.partner_id.zip"/></span>
                                            </div>
                                            <div t-if="o.partner_id.phone" style="margin-top: 3px;">Phone: <span t-field="o.partner_id.phone"/></div>
                                            <div t-if="o.partner_id.vat" style="margin-top: 3px;">VAT Number: <span t-field="o.partner_id.vat"/></div>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        
                        <div class="col-6" style="padding-left: 8px;">
                            <table class="address-table">
                                <thead>
                                    <tr>
                                        <th class="section-header">SHIP TO</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td style="height: 105px;">
                                            <div style="font-weight: 700; font-size: 12px; margin-bottom: 3px;"><span t-field="o.company_id.name"/></div>
                                            <t t-if="o.dest_address_id">
                                                <div t-field="o.dest_address_id.street"/>
                                                <div><span t-field="o.dest_address_id.city"/>, <span t-field="o.dest_address_id.state_id.name"/> <span t-field="o.dest_address_id.zip"/></div>
                                                <div t-if="o.dest_address_id.phone" style="margin-top: 3px;">Phone: <span t-field="o.dest_address_id.phone"/></div>
                                                <div t-if="o.dest_address_id.vat" style="margin-top: 3px;">VAT Number: <span t-field="o.dest_address_id.vat"/></div>
                                                <t t-if="not o.dest_address_id.vat and o.company_id.vat">
                                                    <div style="margin-top: 3px;">VAT Number: <span t-field="o.company_id.vat"/></div>
                                                </t>
                                            </t>
                                            <t t-else="">
                                                <div t-field="o.company_id.street"/>
                                                <div><span t-field="o.company_id.city"/>, <span t-field="o.company_id.state_id.name"/> <span t-field="o.company_id.zip"/></div>
                                                <div t-if="o.company_id.phone" style="margin-top: 3px;">Phone: <span t-field="o.company_id.phone"/></div>
                                                <div t-if="o.company_id.vat" style="margin-top: 3px;">VAT Number: <span t-field="o.company_id.vat"/></div>
                                            </t>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div style="height: 20px; clear: both; display: block;"></div>

                    <table class="bordered-table">
                        <thead>
                            <tr class="table-header">
                                <th style="width: 15%;">ITEM #</th>
                                <th style="width: 45%; text-align: center;">DESCRIPTION</th>
                                <th style="width: 10%;">QTY</th>
                                <th style="width: 15%; text-align: center;">UNIT PRICE</th>
                                <th style="width: 15%; text-align: center;">TOTAL</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="o.order_line" t-as="line">
                                <tr>
                                    <td style="text-align: center; color: #555555;"><span t-field="line.product_id.default_code"/><t t-if="not line.product_id.default_code">-</t></td>
                                    <td style="text-align: left; font-weight: 600;"><span t-field="line.name"/></td>
                                    <td style="text-align: center;"><span t-field="line.product_qty"/></td>
                                    <td style="text-align: right;"><span t-field="line.price_unit"/></td>
                                    <td style="text-align: right; font-weight: 700;"><span t-field="line.price_subtotal"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <div style="height: 20px; clear: both; display: block;"></div>

                    <div class="row">
                        <div class="col-5">
                            <div style="border: 1px solid #2F5597; min-height: 100px; width: 100%;">
                                <div class="gray-box" style="padding: 5px 8px; border-bottom: 1px solid #2F5597; font-size: 10.5px; text-align: left;">Comments or Special Instructions</div>
                                <div style="padding: 8px; font-size: 11px; line-height: 1.4;">
                                    <t t-if="'notes' in o._fields and o.notes"><span t-field="o.notes"/></t>
                                    <t t-if="'note' in o._fields and o.note"><span t-field="o.note"/></t>
                                </div>
                            </div>
                        </div>
                        
                        <div class="col-3 text-center" style="padding-top: 5px;">
                            <img t-if="o.name" t-att-src="'/report/barcode/?type=QR&amp;value=%s&amp;width=120&amp;height=120' % o.name" style="max-height: 80px; max-width: 80px; margin: 0 auto; display: block;"/>
                        </div>
                        
                        <div class="col-4">
                            <table class="totals-table">
                                <tr>
                                    <td class="label-cell">SUBTOTAL</td>
                                    <td class="val-cell"><span t-field="o.amount_untaxed"/></td>
                                </tr>
                                <tr>
                                    <td class="label-cell">VAT</td>
                                    <td class="val-cell"><span t-field="o.amount_tax"/></td>
                                </tr>
                                <tr class="total-row">
                                    <td>TOTAL</td>
                                    <td style="text-align: right;"><span t-field="o.amount_total"/></td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="footer" dir="ltr" style="font-family: 'Cairo', 'Arial', sans-serif !important;">
                    <div style="text-align: center; font-size: 10.5px; color: #666666; border-top: 1px solid #2F5597; padding-top: 8px;">
                        If you have any questions about this purchase order, please contact <span t-field="o.user_id.name"/>
                    </div>
                </div>
            </t>
        </template>

        <template id="report_purchaseorder_document_custom" inherit_id="purchase.report_purchaseorder_document" priority="99">
            <xpath expr="//t" position="replace">
                <t t-call="coa_purchase_report.custom_purchase_layout_base"/>
            </xpath>
        </template>

        <template id="report_purchasequotation_document_custom" inherit_id="purchase.report_purchasequotation_document" priority="99">
            <xpath expr="//t" position="replace">
                <t t-call="coa_purchase_report.custom_purchase_layout_base"/>
            </xpath>
        </template>
    </data>
</odoo>