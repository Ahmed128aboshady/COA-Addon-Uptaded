<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══ Form View ══ -->
    <record id="view_multi_approval_type_form" model="ir.ui.view">
        <field name="name">multi.approval.type.form</field>
        <field name="model">multi.approval.type</field>
        <field name="arch" type="xml">
            <form string="Approval Configuration">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Sales Orders — Confirm"/></h1>
                    </div>
                    <group>
                        <group string="Document">
                            <field name="model_id" options="{'no_create': True, 'no_edit': True}"/>
                            <field name="model" invisible="1"/>
                            <field name="active" invisible="1"/>
                            <field name="trigger"/>
                            <field name="record_domain"
                                   placeholder="Optional, e.g. [('move_type','=','entry')]"/>
                        </group>
                        <group string="Behaviour">
                            <field name="is_active_approval" widget="boolean_toggle"/>
                            <field name="auto_confirm" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"
                               placeholder="Instructions shown to approvers..."/>
                    </group>
                    <notebook>
                        <page string="Approval Stages" name="stages">
                            <field name="stage_ids" widget="one2many">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="approver_ids" widget="many2many_tags"/>
                                    <field name="approval_type"/>
                                    <field name="min_approvals" optional="show"/>
                                    <field name="note" optional="hide"/>
                                </list>
                                <form string="Approval Stage">
                                    <group>
                                        <group>
                                            <field name="name"/>
                                            <field name="sequence"/>
                                            <field name="approval_type"/>
                                            <field name="min_approvals"
                                                   invisible="approval_type != 'minimum'"/>
                                        </group>
                                        <group>
                                            <field name="approver_ids" widget="many2many_tags"
                                                   options="{'no_create': True}"/>
                                        </group>
                                    </group>
                                    <group string="Stage Instructions">
                                        <field name="note" nolabel="1"
                                               placeholder="Instructions for approvers at this stage..."/>
                                    </group>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ══ List View ══ -->
    <record id="view_multi_approval_type_list" model="ir.ui.view">
        <field name="name">multi.approval.type.list</field>
        <field name="model">multi.approval.type</field>
        <field name="arch" type="xml">
            <list string="Approval Configurations">
                <field name="name"/>
                <field name="model_id"/>
                <field name="trigger"/>
                <field name="stage_count" string="Stages"/>
                <field name="is_active_approval" string="Enabled" widget="boolean_toggle"/>
                <field name="auto_confirm"/>
            </list>
        </field>
    </record>

    <!-- ══ Action ══ -->
    <record id="action_multi_approval_type" model="ir.actions.act_window">
        <field name="name">Approval Configurations</field>
        <field name="res_model">multi.approval.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No approval configurations yet!</p>
            <p>Go to <b>Approval Settings</b> to enable approvals per module.</p>
        </field>
    </record>

</odoo>
