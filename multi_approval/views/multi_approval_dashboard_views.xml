<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════
         KANBAN — Approval Settings (one card per type)
         Uses stored card_type field — no JS null errors
         ══════════════════════════════════════════════════ -->
    <record id="view_multi_approval_type_kanban" model="ir.ui.view">
        <field name="name">multi.approval.type.kanban</field>
        <field name="model">multi.approval.type</field>
        <field name="arch" type="xml">
            <kanban create="false" delete="false" group_create="false">
                <field name="name"/>
                <field name="card_type"/>
                <field name="is_active_approval"/>
                <field name="auto_confirm"/>
                <field name="stage_count"/>
                <field name="description"/>
                <templates>
                    <t t-name="card">
                        <div class="p-0" style="min-height:180px;">

                            <!-- ─── Sales: On Save (auto-trigger) ─── -->
                            <t t-if="record.card_type.raw_value == 'sale_on_save'">
                                <div class="p-3 text-white d-flex align-items-center gap-3" style="background:#6f42c1;">
                                    <i class="fa fa-2x fa-floppy-o" title="On Save / Auto Approval"/>
                                    <div class="flex-grow-1">
                                        <strong class="d-block"><field name="name"/></strong>
                                        <small class="opacity-75">Blocks: Everything until approved on Save</small>
                                    </div>
                                    <field name="is_active_approval" widget="boolean_toggle" nolabel="1"/>
                                </div>
                            </t>

                            <!-- ─── Sales: Print PDF ─── -->
                            <t t-elif="record.card_type.raw_value == 'sale_print'">
                                <div class="p-3 text-white d-flex align-items-center gap-3" style="background:#20c997;">
                                    <i class="fa fa-2x fa-print" title="Print PDF"/>
                                    <div class="flex-grow-1">
                                        <strong class="d-block"><field name="name"/></strong>
                                        <small class="opacity-75">Blocks: Print Quotation PDF</small>
                                    </div>
                                    <field name="is_active_approval" widget="boolean_toggle" nolabel="1"/>
                                </div>
                            </t>

                            <!-- ─── Sales: Confirm Quotation ─── -->
                            <t t-elif="record.card_type.raw_value == 'sale_confirm'">
                                <div class="p-3 text-white bg-primary d-flex align-items-center gap-3">
                                    <i class="fa fa-2x fa-shopping-cart" title="Sales Orders"/>
                                    <div class="flex-grow-1">
                                        <strong class="d-block"><field name="name"/></strong>
                                        <small class="opacity-75">Blocks: Confirm Quotation</small>
                                    </div>
                                    <field name="is_active_approval" widget="boolean_toggle" nolabel="1"/>
                                </div>
                            </t>

                            <!-- ─── Sales: Send Quotation ─── -->
                            <t t-elif="record.card_type.raw_value == 'sale_send'">
                                <div class="p-3 text-white d-flex align-items-center gap-3" style="background:#3d8bcd;">
                                    <i class="fa fa-2x fa-paper-plane" title="Send Quotation"/>
                                    <div class="flex-grow-1">
                                        <strong class="d-block"><field name="name"/></strong>
                                        <small class="opacity-75">Blocks: Send Quotation by Email</small>
                                    </div>
                                    <field name="is_active_approval" widget="boolean_toggle" nolabel="1"/>
                                </div>
                            </t>

                            <!-- ─── Purchase ─── -->
                            <t t-elif="record.card_type.raw_value == 'purchase'">
                                <div class="p-3 text-white bg-success d-flex align-items-center gap-3">
                                    <i class="fa fa-2x fa-truck" title="Purchase Orders"/>
                                    <div class="flex-grow-1">
                                        <strong class="d-block"><field name="name"/></strong>
                                        <small class="opacity-75">Blocks: Confirm Purchase Order</small>
                                    </div>
                                    <field name="is_active_approval" widget="boolean_toggle" nolabel="1"/>
                                </div>
                            </t>

                            <!-- ─── Invoices and Bills ─── -->
                            <t t-elif="record.card_type.raw_value == 'invoice'">
                                <div class="p-3 text-dark bg-warning d-flex align-items-center gap-3">
                                    <i class="fa fa-2x fa-file-text-o" title="Invoices and Bills"/>
                                    <div class="flex-grow-1">
                                        <strong class="d-block"><field name="name"/></strong>
                                        <small>Blocks: Post Invoice / Vendor Bill</small>
                                    </div>
                                    <field name="is_active_approval" widget="boolean_toggle" nolabel="1"/>
                                </div>
                            </t>

                            <!-- ─── Journal Entries ─── -->
                            <t t-elif="record.card_type.raw_value == 'journal'">
                                <div class="p-3 text-white d-flex align-items-center gap-3" style="background:#fd7e14;">
                                    <i class="fa fa-2x fa-book" title="Journal Entries"/>
                                    <div class="flex-grow-1">
                                        <strong class="d-block"><field name="name"/></strong>
                                        <small class="opacity-75">Blocks: Post Journal Entry</small>
                                    </div>
                                    <field name="is_active_approval" widget="boolean_toggle" nolabel="1"/>
                                </div>
                            </t>

                            <!-- ─── Bank Payments ─── -->
                            <t t-elif="record.card_type.raw_value == 'payment'">
                                <div class="p-3 text-white bg-secondary d-flex align-items-center gap-3">
                                    <i class="fa fa-2x fa-bank" title="Bank Payments"/>
                                    <div class="flex-grow-1">
                                        <strong class="d-block"><field name="name"/></strong>
                                        <small class="opacity-75">Blocks: Validate Payment</small>
                                    </div>
                                    <field name="is_active_approval" widget="boolean_toggle" nolabel="1"/>
                                </div>
                            </t>

                            <!-- ─── Inventory / default ─── -->
                            <t t-else="">
                                <div class="p-3 text-white bg-info d-flex align-items-center gap-3">
                                    <i class="fa fa-2x fa-cubes" title="Inventory"/>
                                    <div class="flex-grow-1">
                                        <strong class="d-block"><field name="name"/></strong>
                                        <small class="opacity-75">Blocks: Validate Transfer</small>
                                    </div>
                                    <field name="is_active_approval" widget="boolean_toggle" nolabel="1"/>
                                </div>
                            </t>

                            <!-- ─── Card body (shared) ─── -->
                            <div class="p-3">
                                <p class="text-muted small mb-2" style="min-height:36px;">
                                    <field name="description"/>
                                </p>
                                <div class="d-flex align-items-center justify-content-between mt-1">
                                    <div class="d-flex gap-1 flex-wrap">
                                        <span class="badge rounded-pill bg-secondary">
                                            <i class="fa fa-list me-1"/>
                                            <field name="stage_count"/> Stages
                                        </span>
                                        <t t-if="record.is_active_approval.raw_value">
                                            <span class="badge rounded-pill text-bg-success">Active</span>
                                        </t>
                                        <t t-else="">
                                            <span class="badge rounded-pill text-bg-danger">Disabled</span>
                                        </t>
                                        <t t-if="record.auto_confirm.raw_value">
                                            <span class="badge rounded-pill text-bg-info">Auto</span>
                                        </t>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </t>
                    <t t-name="menu">
                        <a role="menuitem" type="open" class="dropdown-item">Configure</a>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Kanban action -->
    <record id="action_multi_approval_settings" model="ir.actions.act_window">
        <field name="name">Approval Settings</field>
        <field name="res_model">multi.approval.type</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="views" eval="[(ref('view_multi_approval_type_kanban'), 'kanban'), (False, 'list'), (False, 'form')]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No approval settings found!</p>
        </field>
    </record>

    <!-- ══ Filtered Request Actions ══ -->
    <record id="action_sale_approval_requests" model="ir.actions.act_window">
        <field name="name">Sales Approval Requests</field>
        <field name="res_model">multi.approval.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('res_model', '=', 'sale.order')]</field>
        <field name="context">{'search_default_pending': 1}</field>
    </record>

    <record id="action_purchase_approval_requests" model="ir.actions.act_window">
        <field name="name">Purchase Approval Requests</field>
        <field name="res_model">multi.approval.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('res_model', '=', 'purchase.order')]</field>
        <field name="context">{'search_default_pending': 1}</field>
    </record>

    <record id="action_account_approval_requests" model="ir.actions.act_window">
        <field name="name">Invoice Approval Requests</field>
        <field name="res_model">multi.approval.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('res_model', '=', 'account.move')]</field>
        <field name="context">{'search_default_pending': 1}</field>
    </record>

    <record id="action_payment_approval_requests" model="ir.actions.act_window">
        <field name="name">Payment Approval Requests</field>
        <field name="res_model">multi.approval.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('res_model', '=', 'account.payment')]</field>
        <field name="context">{'search_default_pending': 1}</field>
    </record>

    <record id="action_inventory_approval_requests" model="ir.actions.act_window">
        <field name="name">Inventory Approval Requests</field>
        <field name="res_model">multi.approval.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('res_model', '=', 'stock.picking')]</field>
        <field name="context">{'search_default_pending': 1}</field>
    </record>

    <!-- ══ Direct Config Actions ══ -->
    <record id="action_sale_approval_type_config" model="ir.actions.act_window">
        <field name="name">Sales Approval Configuration</field>
        <field name="res_model">multi.approval.type</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('model', '=', 'sale.order')]</field>
    </record>

    <record id="action_purchase_approval_type_config" model="ir.actions.act_window">
        <field name="name">Purchase Approval Configuration</field>
        <field name="res_model">multi.approval.type</field>
        <field name="view_mode">form</field>
        <field name="res_id" ref="approval_type_purchase_order"/>
    </record>

    <record id="action_account_approval_type_config" model="ir.actions.act_window">
        <field name="name">Accounting Approval Configuration</field>
        <field name="res_model">multi.approval.type</field>
        <field name="view_mode">form</field>
        <field name="res_id" ref="approval_type_account_move"/>
    </record>

    <record id="action_journal_entry_approval_type_config" model="ir.actions.act_window">
        <field name="name">Journal Entry Approval Configuration</field>
        <field name="res_model">multi.approval.type</field>
        <field name="view_mode">form</field>
        <field name="res_id" ref="approval_type_journal_entry"/>
    </record>

    <record id="action_journal_entry_approval_requests" model="ir.actions.act_window">
        <field name="name">Journal Entry Approval Requests</field>
        <field name="res_model">multi.approval.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('res_model', '=', 'account.move')]</field>
        <field name="context">{'search_default_pending': 1}</field>
    </record>

    <record id="action_payment_approval_type_config" model="ir.actions.act_window">
        <field name="name">Payment Approval Configuration</field>
        <field name="res_model">multi.approval.type</field>
        <field name="view_mode">form</field>
        <field name="res_id" ref="approval_type_account_payment"/>
    </record>

    <record id="action_inventory_approval_type_config" model="ir.actions.act_window">
        <field name="name">Inventory Approval Configuration</field>
        <field name="res_model">multi.approval.type</field>
        <field name="view_mode">form</field>
        <field name="res_id" ref="approval_type_stock_picking"/>
    </record>

</odoo>
