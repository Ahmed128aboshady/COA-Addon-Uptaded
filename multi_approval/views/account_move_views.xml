<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_move_form_approval" model="ir.ui.view">
        <field name="name">account.move.form.approval</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_submit_for_approval"
                        type="object"
                        string="Submit for Approval"
                        class="btn-primary"
                        invisible="approval_state in ('pending', 'approved') or state != 'draft'"/>
                <button name="action_approve_request"
                        type="object"
                        string="Approve"
                        class="btn-success"
                        invisible="not can_approve"/>
                <button name="action_refuse_request"
                        type="object"
                        string="Refuse"
                        class="btn-danger"
                        invisible="not can_approve"/>
                <field name="approval_request_id" invisible="1"/>
                <field name="approval_state" invisible="1"/>
                <field name="can_approve" invisible="1"/>
                <field name="approval_current_stage" invisible="1"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_approval_request"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-check-circle"
                        invisible="not approval_request_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Approval</span>
                        <span class="o_stat_value">
                            <field name="approval_state" widget="badge"
                                   decoration-success="approval_state == 'approved'"
                                   decoration-danger="approval_state == 'refused'"
                                   decoration-warning="approval_state == 'pending'"/>
                        </span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
