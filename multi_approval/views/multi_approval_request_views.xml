<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Approval Request Form View -->
    <record id="view_multi_approval_request_form" model="ir.ui.view">
        <field name="name">multi.approval.request.form</field>
        <field name="model">multi.approval.request</field>
        <field name="arch" type="xml">
            <form string="Approval Request">
                <header>
                    <button name="action_approve" type="object" string="Approve"
                            class="btn-success"
                            invisible="state != 'pending'"/>
                    <button name="action_refuse_wizard" type="object" string="Refuse"
                            class="btn-danger"
                            invisible="state != 'pending'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state not in ('draft', 'pending')"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft"
                            invisible="state not in ('refused', 'cancel')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,pending,approved"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_document" type="object"
                                class="oe_stat_button" icon="fa-external-link"
                                invisible="not res_id">
                            <span>Open Document</span>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                        <h3>
                            <field name="res_name" readonly="1"/>
                        </h3>
                    </div>
                    <group>
                        <group>
                            <field name="type_id" readonly="1"/>
                            <field name="requester_id" readonly="1"/>
                            <field name="request_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="current_stage_id" readonly="1"/>
                            <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                            <field name="refuse_reason" readonly="1" invisible="not refuse_reason"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Approval Lines" name="lines">
                            <field name="line_ids" readonly="1">
                                <list decoration-success="status == 'approved'"
                                      decoration-danger="status == 'refused'"
                                      decoration-muted="status == 'pending' and not is_current_stage">
                                    <field name="stage_name" string="Stage"/>
                                    <field name="approver_id"/>
                                    <field name="status" widget="badge"
                                           decoration-success="status == 'approved'"
                                           decoration-danger="status == 'refused'"
                                           decoration-warning="status == 'pending'"/>
                                    <field name="date"/>
                                    <field name="comment" optional="hide"/>
                                    <field name="is_current_stage" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Approval Request List View -->
    <record id="view_multi_approval_request_list" model="ir.ui.view">
        <field name="name">multi.approval.request.list</field>
        <field name="model">multi.approval.request</field>
        <field name="arch" type="xml">
            <list string="Approval Requests"
                  decoration-success="state == 'approved'"
                  decoration-danger="state == 'refused'"
                  decoration-warning="state == 'pending'"
                  decoration-muted="state in ('draft', 'cancel')">
                <field name="name"/>
                <field name="res_name" string="Document"/>
                <field name="type_id"/>
                <field name="requester_id"/>
                <field name="request_date"/>
                <field name="current_stage_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'refused'"
                       decoration-warning="state == 'pending'"/>
            </list>
        </field>
    </record>

    <!-- Approval Request Search View -->
    <record id="view_multi_approval_request_search" model="ir.ui.view">
        <field name="name">multi.approval.request.search</field>
        <field name="model">multi.approval.request</field>
        <field name="arch" type="xml">
            <search string="Search Approval Requests">
                <field name="name"/>
                <field name="res_name"/>
                <field name="type_id"/>
                <field name="requester_id"/>
                <filter string="Pending" name="pending" domain="[('state', '=', 'pending')]"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Refused" name="refused" domain="[('state', '=', 'refused')]"/>
                <separator/>
                <filter string="My Requests" name="my_requests"
                        domain="[('requester_id', '=', uid)]"/>
                <filter string="My Approvals" name="my_approvals"
                        domain="[('line_ids.approver_id', '=', uid), ('state', '=', 'pending')]"/>
                <group>
                    <filter string="Type" name="group_type" context="{'group_by': 'type_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Requester" name="group_requester" context="{'group_by': 'requester_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Main Action -->
    <record id="action_multi_approval_request" model="ir.actions.act_window">
        <field name="name">Approval Requests</field>
        <field name="res_model">multi.approval.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_multi_approval_request_search"/>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No approval requests yet!
            </p>
            <p>
                Approval requests are created automatically when a document
                is submitted for approval.
            </p>
        </field>
    </record>

    <!-- My Approvals Action -->
    <record id="action_my_approval_requests" model="ir.actions.act_window">
        <field name="name">My Approvals</field>
        <field name="res_model">multi.approval.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_multi_approval_request_search"/>
        <field name="domain">[('line_ids.approver_id', '=', uid), ('state', '=', 'pending')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Nothing to approve!
            </p>
            <p>You have no pending approval requests at the moment.</p>
        </field>
    </record>
</odoo>
