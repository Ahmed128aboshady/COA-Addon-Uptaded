<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_approval_refuse_wizard_form" model="ir.ui.view">
        <field name="name">multi.approval.refuse.wizard.form</field>
        <field name="model">multi.approval.refuse.wizard</field>
        <field name="arch" type="xml">
            <form string="Refuse Approval Request">
                <field name="request_id" invisible="1"/>
                <group>
                    <field name="reason" placeholder="Enter the reason for refusal..." widget="html"/>
                </group>
                <footer>
                    <button name="action_refuse" type="object" string="Refuse" class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
