<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form view: inherit the primary form that actually contains default_code -->
    <record id="product_template_form_view_auto_seq" model="ir.ui.view">
        <field name="name">product.template.form.auto.sequence</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="attributes">
                <attribute name="readonly">1</attribute>
                <attribute name="string">Product Code</attribute>
            </xpath>
        </field>
    </record>

    <!-- List view: also lock the column so it cannot be inline-edited -->
    <record id="product_template_list_view_auto_seq" model="ir.ui.view">
        <field name="name">product.template.list.auto.sequence</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- Search view: expose the product code as an explicit search field
         (the default "Product" search already matches it via filter_domain) -->
    <record id="product_template_search_view_auto_seq" model="ir.ui.view">
        <field name="name">product.template.search.auto.sequence</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="default_code" string="Product Code"
                       filter_domain="['|', ('default_code', 'ilike', self), ('product_variant_ids.default_code', 'ilike', self)]"/>
            </xpath>
        </field>
    </record>

</odoo>
