<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════════
         SALE ORDER / QUOTATION
         - Column 1 : Reference  (product_id.default_code)
         - Column 2 : Product    (product_id.name  — name only, no notes)
         Replaces the single "Description" column (line.name)
         ═══════════════════════════════════════════════════════════════════ -->
    <template id="report_saleorder_document_custom" inherit_id="sale.report_saleorder_document">

        <!-- ── thead: replace "Description" with two headers ── -->
        <xpath expr="//th[@name='th_description']" position="replace">
            <th name="th_ref" class="text-start text-nowrap" style="width:120px;">
                <strong>Reference</strong>
            </th>
            <th name="th_description" class="text-start">
                <strong>Product</strong>
            </th>
        </xpath>

        <!-- ── product rows: replace td_product_name to show product name only ── -->
        <xpath expr="//td[@name='td_product_name']" position="replace">
            <td name="td_product_ref" class="text-start text-nowrap" style="width:120px; vertical-align:top;">
                <span t-out="line.product_id.default_code or ''"/>
            </td>
            <td name="td_product_name" t-att-class="padding_class" style="vertical-align:top;">
                <span t-out="line.product_id.name or line.name"/>
            </td>
        </xpath>

    </template>

</odoo>
