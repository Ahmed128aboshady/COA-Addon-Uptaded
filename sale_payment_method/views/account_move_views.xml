<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Add payment_method_ids to invoice form -->
    <record id="view_account_move_form_payment_method" model="ir.ui.view">
        <field name="name">account.move.form.payment.method</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_payment_term_id']" position="after">
                <field name="payment_method_ids" widget="many2many_tags"
                       options="{'color_field': 'color', 'no_create_edit': False}"
                       invisible="move_type not in ('out_invoice','out_refund','in_invoice','in_refund')"/>
            </xpath>
        </field>
    </record>

</odoo>
