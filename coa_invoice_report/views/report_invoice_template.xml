<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Custom Paper Format -->
        <record id="paperformat_invoice" model="report.paperformat">
            <field name="name">A4 Custom Invoice</field>
            <field name="default" eval="False"/>
            <field name="format">A4</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">15</field>
            <field name="margin_bottom">20</field>
            <field name="margin_left">18</field>
            <field name="margin_right">18</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">0</field>
        </record>

        <!-- Link Paper Format to Invoice Reports -->
        <record id="account.account_invoices" model="ir.actions.report">
            <field name="paperformat_id" ref="coa_invoice_report.paperformat_invoice"/>
        </record>
        <record id="account.account_invoices_without_payment" model="ir.actions.report">
            <field name="paperformat_id" ref="coa_invoice_report.paperformat_invoice"/>
        </record>

        <!-- Inherit Form View to Add Custom Contracting Fields -->
        <record id="view_move_form_inherit_invoice" model="ir.ui.view">
            <field name="name">account.move.form.inherit.invoice</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='other_info']/group" position="inside">
                    <group string="Contract &amp; Claim Details" name="contract_claim_details">
                        <field name="x_contract_value"/>
                        <field name="x_claim_percent"/>
                        <field name="x_advance_percent"/>
                        <field name="x_retention_percent"/>
                    </group>
                </xpath>
            </field>
        </record>

        <!-- Invoice Custom Layout Base -->
        <template id="custom_invoice_layout_base">
            <t t-call="web.basic_layout">
                <div class="page" dir="ltr" style="direction: ltr !important; font-family: 'Cairo', 'Arial', sans-serif !important; color: #333333; font-size: 12.5px;">
                    
                    <style>
                        @import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&amp;display=swap');
                        
                        * { 
                            font-family: 'Cairo', 'Arial', sans-serif !important;
                        }
                        
                        .po-title { color: #2F5597 !important; font-size: 28px !important; font-weight: 700; text-transform: uppercase; line-height: 1; margin-bottom: 8px; }
                        .section-header { background-color: #2F5597 !important; color: white !important; font-weight: 700; padding: 6px 10px; font-size: 11.5px; text-transform: uppercase; text-align: center; border: 1px solid #2F5597 !important; }
                        .table-header { background-color: #2F5597 !important; color: white !important; font-size: 12px; font-weight: 700; text-align: center; }
                        
                        .bordered-table { width: 100% !important; border-collapse: collapse; }
                        .bordered-table th, .bordered-table td { border: 1px solid #2F5597 !important; padding: 7px 9px; vertical-align: middle; font-size: 11.5px; }
                        
                        .gray-box { background-color: #EAEAEA !important; font-weight: 700; font-size: 11.5px; color: #333333; text-align: center;}
                        
                        .address-table { width: 100% !important; border-collapse: collapse; border: 1px solid #2F5597; }
                        .address-table td { padding: 8px 10px; line-height: 1.5; font-size: 11.5px; vertical-align: top; border: none !important; }
                        
                        .totals-table { width: 100% !important; border-collapse: collapse; }
                        .totals-table td { border: 1px solid #2F5597 !important; padding: 7px 10px; font-size: 11.5px; }
                        .totals-table .label-cell { background-color: #EAEAEA !important; font-weight: 700; width: 55%; }
                        .totals-table .val-cell { text-align: right; font-weight: 600; }
                        .totals-table .total-row td { background-color: #2F5597 !important; color: white !important; font-weight: 700; border: 1px solid #2F5597 !important; }
                    </style>

                    <div class="row" style="border-bottom: 3px solid #2F5597; padding-bottom: 10px; margin-top: 5px;">
                        <div class="col-7">
                            <img t-if="o.company_id.logo" 
                                 t-att-src="image_data_uri(o.company_id.logo)" 
                                 style="max-height: 60px; max-width: 220px; display: block; margin: 0 0 8px 0;"/>
                            <div style="font-size: 11px; color: #444444; line-height: 1.6; font-weight: 600; text-align: left; direction: rtl !important; text-align: left !important;">
                                <div style="font-size: 13.5px; font-weight: 700; color: #2F5597; margin-bottom: 2px;">شركة أرفاد الدولية للصناعة</div>
                                <div>ش 118 منطقة الصناعات المساندة الثالثة - الجبيل الصناعية</div>
                                <div>الهاتف: 0133417775</div>
                                <div>الرقم الضريبي: <span t-field="o.company_id.vat"/></div>
                            </div>
                        </div>
                        <div class="col-5" style="text-align: right; padding-top: 10px;">
                            <div class="po-title">TAX INVOICE / فاتورة ضريبية</div>
                        </div>
                    </div>

                    <div style="height: 15px; clear: both; display: block;"></div>

                    <div class="row">
                        <!-- CUSTOMER Address Box -->
                        <div class="col-6" style="padding-right: 8px;">
                            <table class="address-table">
                                <thead>
                                    <tr>
                                        <th class="section-header">CUSTOMER</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td style="height: 105px;">
                                            <div style="font-weight: 700; color: #2F5597; font-size: 12px; margin-bottom: 3px;"><span t-field="o.partner_id.name"/></div>
                                            <div t-if="o.partner_id.vat">VAT Number: <span t-field="o.partner_id.vat"/></div>
                                            <div t-if="o.partner_id.company_registry">C.R: <span t-field="o.partner_id.company_registry"/></div>
                                            <div t-if="o.partner_id.phone">Phone: <span t-field="o.partner_id.phone"/></div>
                                            <div>
                                                <span t-if="o.partner_id.street" t-field="o.partner_id.street"/> 
                                                <span t-if="o.partner_id.street2">, <span t-field="o.partner_id.street2"/></span>
                                                <span t-field="o.partner_id.city"/>
                                                <t t-if="o.partner_id.state_id">, <span t-field="o.partner_id.state_id.name"/></t>
                                                <t t-if="o.partner_id.zip"> <span t-field="o.partner_id.zip"/></t>
                                            </div>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        
                        <!-- INVOICE DETAILS Box -->
                        <div class="col-6" style="padding-left: 8px;">
                            <table class="address-table">
                                <thead>
                                    <tr>
                                        <th class="section-header">INVOICE DETAILS</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td style="height: 105px; line-height: 1.6;">
                                            <div style="margin-top: 3px;"><strong>Invoice Date:</strong> <span t-field="o.invoice_date" t-options="{'widget': 'date'}"/></div>
                                            <div style="margin-top: 3px;"><strong>Invoice NO:</strong> <span t-field="o.name"/></div>
                                            <div t-if="o.ref" style="margin-top: 3px;"><strong>PO NO:</strong> <span t-field="o.ref"/></div>
                                            <div t-if="o.invoice_date_due" style="margin-top: 3px;"><strong>Due Date:</strong> <span t-field="o.invoice_date_due" t-options="{'widget': 'date'}"/></div>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div style="height: 20px; clear: both; display: block;"></div>

                    <!-- Products Table -->
                    <table class="bordered-table">
                        <thead>
                            <tr class="table-header">
                                <th style="width: 20%; text-align: center;">ITEM</th>
                                <th style="width: 25%; text-align: center;">DESCRIPTION</th>
                                <th style="width: 9%; text-align: center;">PRICE</th>
                                <th style="width: 7%; text-align: center;">QTY</th>
                                <th style="width: 11%; text-align: center;">TOTAL BEFORE TAX</th>
                                <th style="width: 8%; text-align: center;">VAT %</th>
                                <th style="width: 10%; text-align: center;">VAT AMOUNT</th>
                                <th style="width: 10%; text-align: center;">TOTAL WITH VAT</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="lines_to_report" t-value="o._get_move_lines_to_report()"/>
                            <t t-foreach="lines_to_report" t-as="line">
                                <t t-if="line.display_type == 'product' or not line.display_type">
                                    <tr>
                                        <!-- البند يحتوي اسم المنتج -->
                                        <td style="text-align: left;"><span t-field="line.product_id.name"/></td>
                                        <!-- الوصف يحتوي وصف السطر -->
                                        <td style="text-align: left; font-weight: 600;"><span t-field="line.name"/></td>
                                        <td style="text-align: center;"><span t-field="line.price_unit"/></td>
                                        <td style="text-align: center;"><span t-field="line.quantity"/></td>
                                        <td style="text-align: center;"><span t-field="line.price_subtotal"/></td>
                                        <td style="text-align: center;">
                                            <t t-set="taxes" t-value="', '.join(tax.tax_label or tax.name for tax in line.tax_ids if tax.tax_label or tax.name)"/>
                                            <span t-out="taxes"/>
                                        </td>
                                        <td style="text-align: center;">
                                            <span t-out="line.price_total - line.price_subtotal" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                        <td style="text-align: center; font-weight: 700;"><span t-field="line.price_total"/></td>
                                    </tr>
                                </t>
                            </t>
                        </tbody>
                    </table>

                    <div style="height: 20px; clear: both; display: block;"></div>

                    <div style="width: 100%; clear: both; display: block; margin-top: 20px;">
                        <!-- Left side: Comments Box or Calculations Table -->
                        <div style="float: left; width: 45%;">
                            <t t-if="o.x_claim_percent &lt; 100 or o.x_advance_percent &gt; 0 or o.x_retention_percent &gt; 0">
                                <table class="totals-table" style="width: 100% !important; border-collapse: collapse;">
                                    <tr>
                                        <td class="label-cell">TOTAL</td>
                                        <td class="val-cell"><span t-field="o.amount_untaxed"/></td>
                                    </tr>
                                    <tr>
                                        <td class="label-cell">CLAIM %<span t-out="o.x_claim_percent"/></td>
                                        <td class="val-cell"><span t-field="o.x_claim_amount"/></td>
                                    </tr>
                                    <tr t-if="o.x_advance_percent &gt; 0">
                                        <td class="label-cell">LESS: <span t-out="o.x_advance_percent"/>% ADVANCE</td>
                                        <td class="val-cell" style="color: #c00000;">(<span t-field="o.x_advance_amount"/>)</td>
                                    </tr>
                                    <tr>
                                        <td class="label-cell">NET AMOUNT</td>
                                        <td class="val-cell"><span t-field="o.x_net_amount"/></td>
                                    </tr>
                                    <tr>
                                        <td class="label-cell">VAT 15%</td>
                                        <td class="val-cell"><span t-field="o.amount_tax"/></td>
                                    </tr>
                                    <tr t-if="o.x_retention_percent &gt; 0">
                                        <td class="label-cell">RETENTION <span t-out="o.x_retention_percent"/>%</td>
                                        <td class="val-cell" style="color: #c00000;">(<span t-field="o.x_retention_amount"/>)</td>
                                    </tr>
                                    <tr class="total-row">
                                        <td>NET REQUIRED AMOUNT</td>
                                        <td style="text-align: right;"><span t-field="o.x_net_required"/></td>
                                    </tr>
                                </table>
                            </t>
                            <t t-else="">
                                <div style="border: 1px solid #2F5597; min-height: 100px; width: 100%;">
                                    <div class="gray-box" style="padding: 5px 8px; border-bottom: 1px solid #2F5597; font-size: 10.5px; text-align: left;">Comments or Special Instructions</div>
                                    <div style="padding: 8px; font-size: 11px; line-height: 1.4;">
                                        <t t-if="'narration' in o._fields and o.narration"><span t-field="o.narration"/></t>
                                    </div>
                                </div>
                            </t>
                        </div>
                        
                        <!-- Middle: QR Code -->
                        <div style="float: left; width: 20%; text-align: center; padding-top: 5px;">
                            <img t-if="o.l10n_sa_qr_code_str" t-att-src="'/report/barcode/?barcode_type=QR&amp;value=' + quote_plus(o.l10n_sa_qr_code_str)" style="max-height: 80px; max-width: 80px; margin: 0 auto; display: block;"/>
                        </div>
                        
                        <!-- Right side: Standard Totals Table -->
                        <div style="float: right; width: 35%;">
                            <table class="totals-table" style="width: 100% !important; border-collapse: collapse;">
                                <tr>
                                    <td class="label-cell">SUBTOTAL</td>
                                    <td class="val-cell"><span t-field="o.amount_untaxed"/></td>
                                </tr>
                                <tr>
                                    <td class="label-cell">VAT</td>
                                    <td class="val-cell"><span t-field="o.amount_tax"/></td>
                                </tr>
                                <tr>
                                    <td class="label-cell">TOTAL</td>
                                    <td class="val-cell"><span t-field="o.amount_total"/></td>
                                </tr>
                                <tr>
                                    <td class="label-cell">PAID</td>
                                    <td class="val-cell"><span t-out="o.amount_total - o.amount_residual" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                                </tr>
                                <tr class="total-row">
                                    <td>DUE AMOUNT</td>
                                    <td style="text-align: right;"><span t-field="o.amount_residual"/></td>
                                </tr>
                            </table>
                        </div>
                    </div>
                    <div style="clear: both;"></div>
                </div>

                <div class="footer" dir="ltr" style="font-family: 'Cairo', 'Arial', sans-serif !important;">
                    <div style="text-align: center; font-size: 10.5px; color: #666666; border-top: 1px solid #2F5597; padding-top: 8px;">
                        If you have any questions about this invoice, please contact the Financial Department.
                    </div>
                </div>
            </t>
        </template>

        <template id="custom_override_report_invoice" inherit_id="account.report_invoice" priority="999">
            <xpath expr="//t[@t-foreach='docs']" position="replace">
                <t t-foreach="docs" t-as="o">
                    <t t-set="lang" t-value="o.partner_id.lang"/>
                    <t t-call="coa_invoice_report.custom_invoice_layout_base" t-lang="lang"/>
                </t>
            </xpath>
        </template>

    </data>
</odoo>