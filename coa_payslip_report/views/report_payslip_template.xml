<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="paperformat_arfad_payslip" model="report.paperformat">
        <field name="name">A4 Arfad Payslip</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">14</field>
        <field name="margin_right">14</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="l10n_sa_hr_payroll.action_report_payslip_sa" model="ir.actions.report">
        <field name="paperformat_id" ref="arfad_payslip_report.paperformat_arfad_payslip"/>
    </record>

    <template id="report_payslip_arfad_content">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                
                <div class="page" dir="ltr" style="direction: ltr !important;">
                    <style>
                        /* تطبيق الخط وتصغير الحجم العام */
                        * { 
                            font-family: 'Tajawal', 'Arial', sans-serif !important;
                            font-size: 11px !important; 
                            color: #000000 !important; 
                            box-sizing: border-box; 
                        }
                        
                        @page   { size: A4; margin: 10mm 14mm 10mm 14mm; }
                        body   { margin: 0 !important; padding: 0 !important; }
                        
                        /* حدود الجداول الصريحة الحادة */
                        .bordered-table { 
                            width: 100%; 
                            border-collapse: collapse; 
                            margin-bottom: 7px; 
                            border: 1px solid #000000 !important;
                        }
                        .bordered-table td, .bordered-table th { 
                            padding: 7px 9px; 
                            border: 1px solid #000000 !important; 
                            vertical-align: middle; 
                        }
                        
                        .text-center { text-align: center; }
                        .font-bold { font-weight: bold; }
                        
                        /* الفواصل المزدوجة المعتمدة */
                        .double-line-sep {
                            border-top: 1px solid #000000;
                            border-bottom: 1px solid #000000;
                            height: 4px; 
                            margin: 15px 0;
                            width: 100%;
                        }

                        /* حاويات التقسيم الجانبي للمكونات المستقلة */
                        .row-container {
                            width: 100%;
                            clear: both;
                            display: block;
                            margin-bottom: 5px;
                        }
                        .col-left { float: left; width: 49%; }
                        .col-right { float: right; width: 49%; }
                    </style>

                    <div style="page-break-after: always;">

                        <div class="row-container" style="margin-bottom: 15px;">
                            <div class="col-left" style="width: 25%;">
                                <img t-if="o.company_id.logo"
                                     t-att-src="image_data_uri(o.company_id.logo)"
                                     style="max-height:65px; max-width:150px;"/>
                            </div>
                            <div class="col-left" style="width: 50%; text-align: center; padding-top: 10px;">
                                <div style="font-size:13px !important; font-weight:bold; margin-bottom:3px;">
                                    <span t-field="o.company_id.name"/>
                                </div>
                                <div style="font-size:22px !important; font-weight:bold;">
                                    Payslip
                                </div>
                            </div>
                            <div class="col-right" style="width: 25%;"></div>
                            <div style="clear: both;"></div>
                        </div>

                        <t t-set="is_invalid" t-value="o._is_invalid()"/>
                        <div t-if="is_invalid"
                             style="border:1px solid #dc3545; color:#dc3545 !important; font-weight:bold;
                                    text-align:center; padding:5px; margin-bottom:10px;">
                            <span t-out="is_invalid"/>
                        </div>

                        <t t-set="paid_days_total"
                           t-value="round(sum(o.worked_days_line_ids.filtered(
                               lambda w: w.code != 'OUT').mapped('number_of_days')), 2)"/>
                        
                        <div class="row-container">
                            <div class="col-left">
                                <table class="bordered-table" style="margin-bottom:0;">
                                    <tr>
                                        <td class="font-bold" style="width:25%; text-align:left;">Paid Days:</td>
                                        <td class="text-center font-bold" style="width:50%;"><span t-out="paid_days_total"/> Days</td>
                                        <td class="font-bold" style="width:25%; text-align:right;">:ايام العمل</td>
                                    </tr>
                                </table>
                            </div>
                            <div class="col-right">
                                <table class="bordered-table" style="margin-bottom:0;">
                                    <tr>
                                        <td class="font-bold" style="width:25%; text-align:left;">Month:</td>
                                        <td class="text-center font-bold" style="width:50%;">
                                            <span t-field="o.date_from" t-options="{'format':'yyyy MMMM'}"/>
                                        </td>
                                        <td class="font-bold" style="width:25%; text-align:right;">:الشهر</td>
                                    </tr>
                                 </table>
                            </div>
                            <div style="clear: both;"></div>
                        </div>

                        <table class="bordered-table">
                            <tr>
                                <td class="font-bold" style="width:14%; text-align:left;">Name:</td>
                                <td colspan="4" class="text-center font-bold" style="color: #004949 !important; font-size: 11px !important;">
                                    <span t-field="o.employee_id.legal_name"/>
                                </td>
                                <td class="font-bold" style="width:14%; text-align:right;">:الاسم</td>
                            </tr>
                            <tr>
                                <td class="font-bold" style="width:14%; text-align:left;">Position:</td>
                                <td class="text-center font-bold" style="width:19%;"><span t-field="o.version_id.job_id"/></td>
                                <td class="font-bold" style="width:14%; text-align:right;">:المهنة</td>
                                <td class="font-bold" style="width:14%; text-align:left;">Emp No:</td>
                                <td class="text-center font-bold" style="width:19%;"><span t-field="o.employee_id.id"/></td>
                                <td class="font-bold" style="width:14%; text-align:right;">:رقم الموظف</td>
                            </tr>
                            <tr>
                                <td class="font-bold" style="width:14%; text-align:left;">Department:</td>
                                <td class="text-center font-bold" style="width:19%;"><span t-field="o.version_id.department_id"/></td>
                                <td class="font-bold" style="width:14%; text-align:right;">:القسم</td>
                                <td class="font-bold" style="width:14%; text-align:left;">ID No:</td>
                                <td class="text-center font-bold" style="width:19%;">
                                    <span t-if="o.version_id.identification_id" t-field="o.version_id.identification_id"/>
                                    <span t-else="" t-field="o.employee_id.identification_id"/>
                                </td>
                                <td class="font-bold" style="width:14%; text-align:right;">:رقم الهوية</td>
                            </tr>
                            <tr>
                                <td class="font-bold" style="width:14%; text-align:left;">Nationality:</td>
                                <td class="text-center font-bold" style="width:19%;"><span t-field="o.employee_id.country_id"/></td>
                                <td class="font-bold" style="width:14%; text-align:right;">:الجنسية</td>
                                <td class="font-bold" style="width:14%; text-align:left;">Passport:</td>
                                <td class="text-center font-bold" style="width:19%;"><span t-field="o.employee_id.passport_id"/></td>
                                <td class="font-bold" style="width:14%; text-align:right;">:رقم الجواز</td>
                            </tr>
                        </table>

                        <div class="double-line-sep"></div>

                        <t t-set="basic_line" t-value="o.line_ids.filtered(lambda l: l.code == 'BASIC' and l.appears_on_payslip)"/>
                        <t t-set="allowance_lines" t-value="o.line_ids.filtered(lambda l: l.category_id.code == 'ALW' and l.appears_on_payslip)"/>
                        <t t-set="gross_line" t-value="o.line_ids.filtered(lambda l: l.code == 'GROSS')"/>
                        <t t-set="gross_total" t-value="gross_line[0].total if gross_line else o.gross_wage"/>

                        <table class="bordered-table">
                            <tr>
                                <td class="font-bold" style="width:20%; text-align:left;">Item:</td>
                                <td class="text-center font-bold" style="width:60%;">Amount | المبلغ</td>
                                <td class="font-bold" style="width:20%; text-align:right;">:البند</td>
                            </tr>
                            <tr t-if="basic_line">
                                <td style="text-align:left;">Basic Salary:</td>
                                <td class="text-center font-bold">
                                    <span t-out="basic_line[0].total" t-options="{'widget':'monetary','display_currency':o.company_id.currency_id}"/>
                                </td>
                                <td style="text-align:right;">:الراتب الأساسي</td>
                            </tr>
                            <t t-foreach="allowance_lines" t-as="alw">
                                <t t-set="nm_en" t-value="alw.salary_rule_id.with_context(lang='en_US').name or alw.name"/>
                                <t t-set="nm_ar" t-value="alw.salary_rule_id.with_context(lang='ar_001').name or alw.name"/>
                                <tr>
                                    <td style="text-align:left;"><span t-out="nm_en"/>:</td>
                                    <td class="text-center font-bold">
                                        <span t-out="alw.total" t-options="{'widget':'monetary','display_currency':o.company_id.currency_id}"/>
                                    </td>
                                    <td style="text-align:right;">:<span t-out="nm_ar"/></td>
                                </tr>
                            </t>
                            <tr>
                                <td class="font-bold" style="text-align:left;">Total Salary:</td>
                                <td class="text-center font-bold" style="color: #008012 !important;">
                                    <span style="color: #008012 !important;" t-out="gross_total" t-options="{'widget':'monetary','display_currency':o.company_id.currency_id}"/>
                                </td>
                                <td class="font-bold" style="text-align:right;">:اجمالي الراتب</td>
                            </tr>
                        </table>

                        <div class="double-line-sep"></div>

                        <t t-set="earning_lines" t-value="o.line_ids.filtered(lambda l: l.appears_on_payslip and l.category_id.code in ['ALW','COMP'] and l.code not in ['BASIC','GROSS','NET'] and l.total &gt;= 0)"/>
                        <t t-set="deduction_lines" t-value="o.line_ids.filtered(lambda l: l.appears_on_payslip and l.category_id.code in ['DED','LOAN'])"/>
                        <t t-set="earn_total" t-value="sum(earning_lines.mapped('total'))"/>
                        <t t-set="ded_total"  t-value="sum(deduction_lines.mapped('total'))"/>

                        <div class="row-container">
                            <div class="col-left">
                                <table class="bordered-table" style="margin-bottom:0;">
                                    <tr>
                                        <td colspan="3" class="text-center font-bold" style="color: #008000 !important; font-size:11px !important;">Earnings | :الإستحقاق</td>
                                    </tr>
                                    <tr>
                                        <td class="font-bold" style="width:25%; text-align:left;">Item:</td>
                                        <td class="text-center font-bold" style="width:50%;">Amount | المبلغ</td>
                                        <td class="font-bold" style="width:25%; text-align:right;">:البند</td>
                                    </tr>
                                    <t t-foreach="earning_lines" t-as="earn">
                                        <t t-set="e_nm_en" t-value="earn.salary_rule_id.with_context(lang='en_US').name or earn.name"/>
                                        <t t-set="e_nm_ar" t-value="earn.salary_rule_id.with_context(lang='ar_001').name or earn.name"/>
                                        <tr>
                                            <td style="text-align:left;"><span t-out="e_nm_en"/></td>
                                            <td class="text-center font-bold">
                                                <span t-out="earn.total" t-options="{'widget':'monetary','display_currency':o.company_id.currency_id}"/>
                                            </td>
                                            <td style="text-align:right;">:<span t-out="e_nm_ar"/></td>
                                        </tr>
                                    </t>
                                    <t t-if="not earning_lines">
                                        <tr><td colspan="3" class="text-center" style="color:#aaa !important;">-</td></tr>
                                    </t>
                                    <tr>
                                        <td class="font-bold" style="text-align:left;">Total</td>
                                        <td class="text-center font-bold" style="color: #008012 !important;">
                                            <span style="color: #008012 !important;" t-out="earn_total" t-options="{'widget':'monetary','display_currency':o.company_id.currency_id}"/>
                                        </td>
                                        <td class="font-bold" style="text-align:right;">:الاجمالى</td>
                                    </tr>
                                </table>
                            </div>
                            
                            <div class="col-right">
                                <table class="bordered-table" style="margin-bottom:0;">
                                    <tr>
                                        <td colspan="3" class="text-center font-bold" style="color: #D10000 !important; font-size:11px !important;">Deductions | :الحسميات</td>
                                    </tr>
                                    <tr>
                                        <td class="font-bold" style="width:25%; text-align:left;">Item:</td>
                                        <td class="text-center font-bold" style="width:50%;">Amount | المبلغ</td>
                                        <td class="font-bold" style="width:25%; text-align:right;">:البند</td>
                                    </tr>
                                    <t t-foreach="deduction_lines" t-as="ded">
                                        <t t-set="d_nm_en" t-value="ded.salary_rule_id.with_context(lang='en_US').name or ded.name"/>
                                        <t t-set="d_nm_ar" t-value="ded.salary_rule_id.with_context(lang='ar_001').name or ded.name"/>
                                        <tr>
                                            <td style="text-align:left;"><span t-out="d_nm_en"/></td>
                                            <td class="text-center font-bold">
                                                <span t-out="ded.total" t-options="{'widget':'monetary','display_currency':o.company_id.currency_id}"/>
                                            </td>
                                            <td style="text-align:right;">:<span t-out="d_nm_ar"/></td>
                                        </tr>
                                    </t>
                                    <t t-if="not deduction_lines">
                                        <tr><td colspan="3" class="text-center" style="color:#aaa !important;">-</td></tr>
                                    </t>
                                    <tr>
                                        <td class="font-bold" style="text-align:left;">Total</td>
                                        <td class="text-center font-bold" style="color: #D10000 !important;">
                                            <span style="color: #D10000 !important;" t-out="ded_total" t-options="{'widget':'monetary','display_currency':o.company_id.currency_id}"/>
                                        </td>
                                        <td class="font-bold" style="text-align:right;">:الاجمالى</td>
                                    </tr>
                                </table>
                            </div>
                            <div style="clear: both;"></div>
                        </div>

                        <table class="bordered-table" style="margin-top: 15px;">
                            <tr>
                                <td class="font-bold" style="width:30%; text-align:left;">Due Amount:</td>
                                <td class="text-center font-bold" style="color: #008000 !important;">
                                    <t t-if="o.net_wage >= 0">
                                        <span style="color: #008000 !important;" t-field="o.net_wage" t-options="{'widget':'monetary','display_currency':o.company_id.currency_id}"/>
                                    </t>
                                    <t t-else="">
                                        <span style="color: #FF0000 !important;" t-field="o.net_wage" t-options="{'widget':'monetary','display_currency':o.company_id.currency_id}"/>
                                    </t>
                                </td>
                                <td class="font-bold" style="width:30%; text-align:right;">:المبلغ المستحق</td>
                            </tr>
                        </table>

                    </div>
                </div>
            </t>
        </t>
    </template>

    <template id="report_payslip_sa_lang_override" inherit_id="l10n_sa_hr_payroll.report_payslip_sa_lang" priority="20">
        <xpath expr="//t[@t-call='l10n_sa_hr_payroll.report_payslip_sa']" position="replace">
            <t t-call="arfad_payslip_report.report_payslip_arfad_content" t-lang="o.env.lang"/>
        </xpath>
    </template>

</odoo>