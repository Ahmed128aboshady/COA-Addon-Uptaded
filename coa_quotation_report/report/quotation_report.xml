<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         Report Action - replaces default Sale Quotation report
    ============================================================ -->
    <record id="action_report_alramlaa_quotation" model="ir.actions.report">
        <field name="name">Al Ramlaa Quotation / عرض سعر الرملاء</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">alramlaa_quotation_report.report_alramlaa_quotation_document</field>
        <field name="report_file">alramlaa_quotation_report.report_alramlaa_quotation_document</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

</odoo>
