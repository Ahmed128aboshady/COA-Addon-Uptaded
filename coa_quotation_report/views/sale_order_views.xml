<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════
         Sale Order Form - Add extra fields
    ═══════════════════════════════════════════════ -->
    <record id="view_alramlaa_sale_order_form" model="ir.ui.view">
        <field name="name">sale.order.form.alramlaa</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!-- Add fields after validity_date in header area -->
            <xpath expr="//field[@name='validity_date']" position="after">
                <field name="follow_up_person"
                       placeholder="Follow Up Person / اسم المتابع"
                       string="Follow Up / المتابعة"/>
                <field name="contact_number_2"
                       placeholder="+966XXXXXXXXX"
                       string="Contact 2 / التواصل 2"/>
                <field name="delivery_terms"
                       placeholder="e.g. 3 Months"
                       string="Delivery Terms / شروط التسليم"/>
            </xpath>

            <!-- Add Summary tab before Other Info tab -->
            <xpath expr="//page[@name='other_information']" position="before">
                <page string="Summary / الملخص" name="alramlaa_summary">
                    <field name="summary_line_ids">
                        <list string="Summary" editable="bottom">
                            <field name="sequence"  widget="handle"/>
                            <field name="item_no"   string="Item No. / رقم البند"/>
                            <field name="name"      string="Description / الوصف"/>
                            <field name="total"     string="Total Price / الإجمالي"/>
                        </list>
                    </field>
                </page>
            </xpath>

            <!-- Add payment detail and notes in Other Info tab -->
            <xpath expr="//page[@name='other_information']//group[@name='sale_reporting']" position="after">
                <group string="Al Ramlaa Report Settings / إعدادات تقرير الرملاء" col="1">
                    <field name="payment_terms_detail"
                           string="Payment Terms Detail / تفاصيل الدفع"
                           widget="text"/>
                    <field name="terms_conditions"
                           string="Terms &amp; Conditions / الشروط والأحكام"
                           widget="text"/>
                    <field name="report_notes"
                           string="Report Notes / ملاحظات التقرير"/>
                </group>
            </xpath>

        </field>
    </record>


    <!-- ═══════════════════════════════════════════════
         Sale Order Line - Add extra columns in list inside form
    ═══════════════════════════════════════════════ -->
    <record id="view_alramlaa_sale_order_line_form" model="ir.ui.view">
        <field name="name">sale.order.line.form.alramlaa</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='order_line']//list//field[@name='product_template_id']" position="before">
                <field name="item_no"
                       string="Item#"
                       optional="show"
                       style="width:50px;"/>
                <field name="line_section_type"
                       string="Section / قسم"
                       optional="show"
                       style="width:90px;"/>
            </xpath>

            <xpath expr="//field[@name='order_line']//list//field[@name='price_unit']" position="before">
                <field name="dimensions"
                       string="Dimensions / أبعاد"
                       optional="show"
                       style="width:100px;"/>
            </xpath>

        </field>
    </record>


    <!-- ═══════════════════════════════════════════════
         Sale Order Line popup form
    ═══════════════════════════════════════════════ -->
    <record id="view_alramlaa_sale_order_line_popup" model="ir.ui.view">
        <field name="name">sale.order.line.form.popup.alramlaa</field>
        <field name="model">sale.order.line</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <form string="Order Line Detail / تفاصيل البند">
                <sheet>
                    <group string="Basic Info / معلومات أساسية">
                        <field name="item_no"           string="Item No. / رقم البند"/>
                        <field name="product_id"        string="Product / المنتج"/>
                        <field name="name"              string="Description / الوصف" widget="text"/>
                        <field name="line_section_type" string="Section Type / نوع القسم"/>
                    </group>
                    <group string="Specifications / المواصفات">
                        <field name="dimensions"      string="Dimensions WxDxH / الأبعاد"/>

                        <field name="product_uom_qty" string="Quantity / الكمية"/>
                        <field name="price_unit"      string="Unit Price / سعر الوحدة"/>
                    </group>
                    <group string="Materials &amp; Finish / المواد والتشطيب" col="1">
                        <field name="key_materials"
                               string="Key Materials / المواد الرئيسية"
                               widget="text"
                               placeholder="Describe materials, finish, certifications..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
