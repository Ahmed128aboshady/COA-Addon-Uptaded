<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Add COA service-cost fields to the product Accounting tab -->
        <record id="product_template_form_coa_service" model="ir.ui.view">
            <field name="name">product.template.form.coa.service</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="account.product_template_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='invoicing']/group[@name='properties']"
                       position="inside">
                    <!-- Only visible for Service-type products -->
                    <group string="Service Cost Accounts (COA)"
                           invisible="type != 'service'"
                           name="coa_service_cost">
                        <field name="coa_service_intermediate_account_id"
                               options="{'no_create': True}"/>
                        <field name="coa_service_cogs_account_id"
                               options="{'no_create': True}"/>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
