<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Groups -->
        <record id="group_approval_user" model="res.groups">
            <field name="name">Approval User</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_approval_manager" model="res.groups">
            <field name="name">Approval Manager</field>
            <field name="implied_ids" eval="[(4, ref('multi_approval.group_approval_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
