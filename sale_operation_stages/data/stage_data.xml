<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="ir_sequence_sale_operation" model="ir.sequence">
            <field name="name">Sale Operation</field>
            <field name="code">sale.operation</field>
            <field name="prefix">OP/%(year)s/</field>
            <field name="padding">4</field>
        </record>

        <!-- مراحل افتراضية قابلة للتعديل -->
        <record id="stage_receiving" model="sale.operation.stage">
            <field name="name">استلام من المبيعات</field>
            <field name="sequence">10</field>
            <field name="code">RECV</field>
            <field name="is_first">True</field>
            <field name="color">1</field>
        </record>

        <record id="stage_processing" model="sale.operation.stage">
            <field name="name">جاري التنفيذ</field>
            <field name="sequence">20</field>
            <field name="code">PROC</field>
            <field name="color">3</field>
        </record>

        <record id="stage_quality" model="sale.operation.stage">
            <field name="name">مراجعة الجودة</field>
            <field name="sequence">30</field>
            <field name="code">QC</field>
            <field name="color">2</field>
        </record>

        <record id="stage_ready" model="sale.operation.stage">
            <field name="name">جاهز للتسليم</field>
            <field name="sequence">40</field>
            <field name="code">READY</field>
            <field name="is_last">True</field>
            <field name="color">10</field>
        </record>

    </data>
</odoo>
