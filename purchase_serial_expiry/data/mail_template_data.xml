<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="mail_template_lot_expiry_notification" model="mail.template">
            <field name="name">Lot Expiry Notification</field>
            <field name="model_id" ref="purchase.model_purchase_order"/>
            <field name="subject">⚠️ Lot Expiry Alert – {{ object.serial_number or object.name }}</field>
            <field name="body_html"><![CDATA[
<div style="font-family:Arial,sans-serif;max-width:620px;margin:auto;border:1px solid #e5e7eb;border-radius:10px;overflow:hidden;">
  <div style="background:#b45309;padding:24px 32px;">
    <h2 style="color:#fff;margin:0;font-size:20px;">⚠️ Lot Expiry Alert</h2>
  </div>
  <div style="padding:28px 32px;">
    <p style="font-size:15px;margin:0 0 16px;">
      Dear <strong>{{ object.user_id.name or 'Team' }}</strong>,
    </p>
    <p style="margin:0 0 20px;">
      A raw material lot linked to Purchase Order
      <strong>{{ object.serial_number or object.name }}</strong>
      is expiring within 30 days. Please review the lot details in stock and take action.
    </p>
    <table style="width:100%;border-collapse:collapse;font-size:14px;">
      <tr style="background:#f3f4f6;">
        <td style="padding:10px 14px;font-weight:bold;border-bottom:1px solid #e5e7eb;">Order Reference</td>
        <td style="padding:10px 14px;border-bottom:1px solid #e5e7eb;">{{ object.name }}</td>
      </tr>
      <tr>
        <td style="padding:10px 14px;font-weight:bold;border-bottom:1px solid #e5e7eb;">Serial #</td>
        <td style="padding:10px 14px;border-bottom:1px solid #e5e7eb;">{{ object.serial_number or '—' }}</td>
      </tr>
      <tr style="background:#f3f4f6;">
        <td style="padding:10px 14px;font-weight:bold;border-bottom:1px solid #e5e7eb;">Vendor</td>
        <td style="padding:10px 14px;border-bottom:1px solid #e5e7eb;">{{ object.partner_id.name }}</td>
      </tr>
      <tr>
        <td style="padding:10px 14px;font-weight:bold;">Responsible</td>
        <td style="padding:10px 14px;">{{ object.user_id.name or '—' }}</td>
      </tr>
    </table>
    <p style="margin-top:20px;color:#b45309;font-weight:bold;">
      Please check Inventory → Lots/Serial Numbers for the expiring lot details.
    </p>
    <div style="margin-top:24px;">
      <a href="/web#id={{ object.id }}&amp;model=purchase.order&amp;view_type=form"
         style="display:inline-block;background:#b45309;color:#fff;padding:11px 22px;border-radius:6px;text-decoration:none;font-weight:bold;font-size:14px;">
        Open Purchase Order
      </a>
    </div>
  </div>
  <div style="background:#f9fafb;padding:14px 32px;font-size:12px;color:#9ca3af;">
    Automated notification — sent 30 days before lot expiry.
  </div>
</div>
            ]]></field>
            <field name="email_to">{{ object.user_id.email }}</field>
            <field name="auto_delete" eval="True"/>
        </record>

    </data>
</odoo>
