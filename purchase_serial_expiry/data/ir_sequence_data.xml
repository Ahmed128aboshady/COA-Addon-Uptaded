<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="seq_purchase_order_serial" model="ir.sequence">
            <field name="name">Purchase Order Serial</field>
            <field name="code">purchase.order.serial</field>
            <field name="prefix">PO/%(year)s/%(month)s/</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_mrp_production_serial" model="ir.sequence">
            <field name="name">Manufacturing Order Serial</field>
            <field name="code">mrp.production.serial</field>
            <field name="prefix">MO/%(year)s/%(month)s/</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
